{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "amount": {
      "$ref": "Money.schema.json",
      "description": "Positive when the customer owes more."
    },
    "balance": {
      "$ref": "Money.schema.json",
      "description": "What they owe after it."
    },
    "date": {
      "description": "The day.",
      "examples": [
        "2026-10-23"
      ],
      "format": "date",
      "type": "string"
    },
    "description": {
      "description": "What it was.",
      "examples": [
        "Invoice INV-0150, due 22 Nov 2026"
      ],
      "type": "string"
    }
  },
  "required": [
    "date",
    "description",
    "amount",
    "balance"
  ],
  "title": "PortalStatementLine",
  "type": "object"
}
