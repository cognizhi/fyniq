{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "id": {
      "description": "The member's user ID, to send as a mention.",
      "examples": [
        "01928f6e-7a3b-7c41-9d2e-5f8a1b3c4d01"
      ],
      "format": "uuid",
      "type": "string"
    },
    "name": {
      "description": "Their name.",
      "examples": [
        "Wei Ling Tan"
      ],
      "type": "string"
    }
  },
  "required": [
    "id",
    "name"
  ],
  "title": "Mentionable",
  "type": "object"
}
