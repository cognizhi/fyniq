{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fyniq.example/schemas/differential/share-service.schema.json",
  "title": "The expense of shares issued for services (PRD-001 FR-EQ-13, ALLOC-EVEN, RND-LINE)",
  "description": "One case both implementations must reproduce. A grant has a fair value per share (at most six decimals), measured at the grant date and never remeasured, a service start (the first day of a month) and tranches of whole shares, each with the day it vests. A tranche's service period is the whole calendar months from the service start's month to its vest day's month, both counted. Its total expense is shares x fair value rounded once to the currency's minor units, half away from zero (RND-LINE); the total is spread over its months by cumulative rounding (ALLOC-EVEN), so they add to it exactly. A month's expense is the sum of the tranches' parts for it.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "currency", "minor_units", "fair_value", "service_start", "tranches", "want"],
  "properties": {
    "name": {"type": "string", "minLength": 1},
    "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
    "minor_units": {"type": "integer", "minimum": 0, "maximum": 3},
    "fair_value": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]{1,6})?$"},
    "service_start": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-01$"},
    "tranches": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["shares", "vest_on"],
        "properties": {"shares": {"type": "integer", "minimum": 1}, "vest_on": {"type": "string", "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"}}
      }
    },
    "want": {
      "type": "object", "additionalProperties": false, "required": ["tranches", "months", "total"],
      "properties": {
        "tranches": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["months", "total", "parts"],
          "properties": {"months": {"type": "integer", "minimum": 1}, "total": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]{1,3})?$"}, "parts": {"type": "array", "items": {"type": "string", "pattern": "^-?[0-9]+(\\.[0-9]{1,3})?$"}}}}},
        "months": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["month", "expense"],
          "properties": {"month": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}$"}, "expense": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]{1,3})?$"}}}},
        "total": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]{1,3})?$"}
      }
    }
  }
}
