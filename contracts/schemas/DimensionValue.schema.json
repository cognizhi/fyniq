{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "active": {
      "description": "false once put out of use: kept, as lines name it.",
      "examples": [
        true
      ],
      "type": "boolean"
    },
    "code": {
      "description": "Its code, unique in its dimension whatever the case. It never changes.",
      "examples": [
        "ENG"
      ],
      "type": "string"
    },
    "dimension_id": {
      "description": "The dimension it is a value of. It never changes.",
      "examples": [
        "01928f6e-7a3b-7c41-9d2e-5f8a1b3c4e10"
      ],
      "format": "uuid",
      "type": "string"
    },
    "id": {
      "description": "The value's ID.",
      "examples": [
        "01928f6e-7a3b-7c41-9d2e-5f8a1b3c4e21"
      ],
      "format": "uuid",
      "type": "string"
    },
    "name": {
      "description": "Its name.",
      "examples": [
        "Engineering"
      ],
      "type": "string"
    },
    "version": {
      "description": "Its version, for If-Match.",
      "examples": [
        1
      ],
      "format": "int64",
      "type": "integer"
    }
  },
  "required": [
    "id",
    "dimension_id",
    "code",
    "name",
    "active",
    "version"
  ],
  "title": "DimensionValue",
  "type": "object"
}
