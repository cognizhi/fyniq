## functions (definition)
CREATE OR REPLACE FUNCTION nemura.access_request_guard()
 RETURNS trigger
 LANGUAGE plpgsql
 SET search_path TO 'pg_catalog', 'nemura', 'pg_temp'
AS $function$
BEGIN
  IF TG_OP = 'DELETE' OR NEW.requester_id IS DISTINCT FROM OLD.requester_id OR NEW.received_on IS DISTINCT FROM OLD.received_on
     OR NEW.due_on IS DISTINCT FROM OLD.due_on OR OLD.state = 'answered' THEN
    RAISE EXCEPTION 'An access request keeps what was asked and, once answered, its answer' USING ERRCODE = 'NM090';
  END IF;
  RETURN NEW;
END
$function$

CREATE OR REPLACE FUNCTION nemura.access_request_item_guard()
 RETURNS trigger
 LANGUAGE plpgsql
 SET search_path TO 'pg_catalog', 'nemura', 'pg_temp'
AS $function$
BEGIN
  IF TG_OP = 'DELETE' OR EXISTS (SELECT 1 FROM nemura.access_request r
       WHERE r.organisation_id = coalesce(NEW.organisation_id, OLD.organisation_id) AND r.id = coalesce(NEW.request_id, OLD.request_id) AND r.state = 'answered') THEN
    RAISE EXCEPTION 'The decisions of an answered access request are kept' USING ERRCODE = 'NM090';
  END IF;
  RETURN NEW;
END
$function$

CREATE OR REPLACE FUNCTION nemura.ai_proposal_guard()
 RETURNS trigger
 LANGUAGE plpgsql
 SET search_path TO 'pg_catalog', 'nemura', 'pg_temp'
AS $function$
BEGIN
  IF TG_OP = 'DELETE' THEN
    RAISE EXCEPTION 'A proposal is evidence: it is decided and applied, never deleted' USING ERRCODE = 'NM178';
  END IF;
  IF TG_OP = 'INSERT' THEN
    IF NEW.state <> 'pending' THEN
      RAISE EXCEPTION 'A proposal starts pending' USING ERRCODE = 'NM178';
    END IF;
    RETURN NEW;
  END IF;
  IF NEW.task_type IS DISTINCT FROM OLD.task_type OR NEW.task_version IS DISTINCT FROM OLD.task_version OR NEW.asker IS DISTINCT FROM OLD.asker OR NEW.payload IS DISTINCT FROM OLD.payload
     OR NEW.payload_hash IS DISTINCT FROM OLD.payload_hash OR NEW.created_at IS DISTINCT FROM OLD.created_at OR NEW.expires_at IS DISTINCT FROM OLD.expires_at
     OR NEW.model_id IS DISTINCT FROM OLD.model_id OR NEW.prompt_version IS DISTINCT FROM OLD.prompt_version OR NEW.rationale IS DISTINCT FROM OLD.rationale THEN
    RAISE EXCEPTION 'A proposal keeps what the assistant proposed: a human edits it into the final text' USING ERRCODE = 'NM178';
  END IF;
  IF NOT ((OLD.state = 'pending' AND NEW.state IN ('approved', 'rejected')) OR (OLD.state = 'approved' AND NEW.state = 'applied')) THEN
    RAISE EXCEPTION 'A proposal moves from pending to approved or rejected, and from approved to applied' USING ERRCODE = 'NM178';
  END IF;
  IF OLD.state = 'pending' AND NEW.state = 'approved' AND NEW.decided_at > OLD.expires_at THEN
    RAISE EXCEPTION 'A proposal that has waited 72 hours cannot be approved: ask again' USING ERRCODE = 'NM178';
  END IF;
  IF OLD.state = 'approved' AND (NEW.decided_by IS DISTINCT FROM OLD.decided_by OR NEW.decided_at IS DISTINCT FROM OLD.decided_at OR NEW.final_payload IS DISTINCT FROM OLD.final_payload OR NEW.approved_hash IS DISTINCT FROM OLD.approved_hash) THEN
    RAISE EXCEPTION 'What was approved is applied as approved' USING ERRCODE = 'NM178';
  END IF;
  RETURN NEW;
END
$function$

CREATE OR REPLACE FUNCTION nemura.api_client_guard()
 RETURNS trigger
 LANGUAGE plpgsql
 SET search_path TO 'pg_catalog', 'nemura', 'pg_temp'
AS $function$
BEGIN
  IF TG_OP = 'DELETE' OR NEW.name IS DISTINCT FROM OLD.name OR NEW.scopes IS DISTINCT FROM OLD.scopes OR NEW.hydra_client_id IS DISTINCT FROM OLD.hydra_client_id
     OR NEW.created_by IS DISTINCT FROM OLD.created_by OR (OLD.revoked_at IS NOT NULL AND NEW.revoked_at IS DISTINCT FROM OLD.revoked_at) THEN
    RAISE EXCEPTION 'An API client can only be revoked, once' USING ERRCODE = 'NM104';
  END IF;
  RETURN NEW;
END
$function$

CREATE OR REPLACE FUNCTION nemura.append_only()
 RETURNS trigger
 LANGUAGE plpgsql
 SET search_path TO 'pg_catalog', 'nemura', 'pg_temp'
AS $function$
BEGIN
  RAISE EXCEPTION '% is append-only (% refused)', TG_TABLE_NAME, TG_OP USING ERRCODE = 'NM091';
END
$function$

CREATE OR REPLACE FUNCTION nemura.append_only_guard()
 RETURNS trigger
 LANGUAGE plpgsql
 SET search_path TO 'pg_catalog', 'nemura', 'pg_temp'
AS $function$
BEGIN
  RAISE EXCEPTION '% is append-only: a correction is a new record', TG_ARGV[0] USING ERRCODE = 'NM127';
END
$function$

CREATE OR REPLACE FUNCTION nemura.approval_request_guard()
 RETURNS trigger
 LANGUAGE plpgsql
 SET search_path TO 'pg_catalog', 'nemura', 'pg_temp'
AS $function$
BEGIN
  IF TG_OP = 'DELETE' OR NEW.object_type IS DISTINCT FROM OLD.object_type OR NEW.object_id IS DISTINCT FROM OLD.object_id
     OR NEW.version IS DISTINCT FROM OLD.version OR NEW.digest IS DISTINCT FROM OLD.digest
     OR NEW.requested_by IS DISTINCT FROM OLD.requested_by OR NEW.required_role IS DISTINCT FROM OLD.required_role
     OR NEW.expires_at IS DISTINCT FROM OLD.expires_at OR OLD.state <> 'pending' THEN
    RAISE EXCEPTION 'An approval request is decided once and never changed' USING ERRCODE = 'NM082';
  END IF;
  RETURN NEW;
END
$function$

CREATE OR REPLACE FUNCTION nemura.audit_chain_guard()
 RETURNS trigger
 LANGUAGE plpgsql
 SET search_path TO 'pg_catalog', 'nemura', 'pg_temp'
AS $function$
BEGIN
  IF TG_OP = 'DELETE' OR NEW.seq <> OLD.seq + 1 THEN
    RAISE EXCEPTION 'The audit chain head only moves forward by one event' USING ERRCODE = 'NM060';
  END IF;
  RETURN NEW;
END
$function$

CREATE OR REPLACE FUNCTION nemura.audit_event_append()
 RETURNS trigger
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'pg_catalog', 'nemura', 'pg_temp'
AS $function$
DECLARE
  org uuid := nemura.require_org();
  h   record;
BEGIN
  SELECT seq, head_hash INTO h FROM nemura.audit_chain WHERE organisation_id = org FOR UPDATE;
  IF NOT FOUND THEN
    RAISE EXCEPTION 'The organisation of this transaction has no audit chain' USING ERRCODE = 'NM006';
  END IF;
  NEW.organisation_id := org;
  NEW.seq := h.seq + 1;
  NEW.prev_hash := h.head_hash;
  NEW.hash := sha256(h.head_hash || convert_to(NEW.body, 'UTF8'));
  NEW.created_xact := pg_current_xact_id()::text::bigint;
  UPDATE nemura.audit_chain SET seq = NEW.seq, head_hash = NEW.hash WHERE organisation_id = org;
  RETURN NEW;
END
$function$

CREATE OR REPLACE FUNCTION nemura.audit_immutable()
 RETURNS trigger
 LANGUAGE plpgsql
 SET search_path TO 'pg_catalog', 'nemura', 'pg_temp'
AS $function$
BEGIN
  RAISE EXCEPTION 'The audit trail cannot be changed or deleted (% on %)', TG_OP, TG_TABLE_NAME
    USING ERRCODE = 'NM060', HINT = 'Audit events are append-only (AUD-08).';
END
$function$

CREATE OR REPLACE FUNCTION nemura.bank_account_change_guard()
 RETURNS trigger
 LANGUAGE plpgsql
 SET search_path TO 'pg_catalog', 'nemura', 'pg_temp'
AS $function$
BEGIN
  IF TG_OP = 'DELETE' OR NEW.person_id IS DISTINCT FROM OLD.person_id OR NEW.new_sealed IS DISTINCT FROM OLD.new_sealed OR NEW.new_masked IS DISTINCT FROM OLD.new_masked
     OR NEW.proposed_by IS DISTINCT FROM OLD.proposed_by OR NEW.approval_id IS DISTINCT FROM OLD.approval_id
     OR NOT ((OLD.state = 'proposed' AND NEW.state IN ('approved', 'refused')) OR (OLD.state = 'approved' AND NEW.state = 'confirmed')) THEN
    RAISE EXCEPTION 'A bank account change moves forward only: proposed, approved or refused, then confirmed' USING ERRCODE = 'NM126';
  END IF;
  RETURN NEW;
END
$function$

CREATE OR REPLACE FUNCTION nemura.claim_setup(p_hash bytea)
 RETURNS boolean
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'pg_catalog', 'nemura', 'pg_temp'
AS $function$
DECLARE
  n integer;
BEGIN
  UPDATE nemura.installation SET setup_code_hash = NULL, setup_completed_at = now()
   WHERE setup_code_hash = p_hash AND setup_completed_at IS NULL;
  GET DIAGNOSTICS n = ROW_COUNT;
  RETURN n = 1;
END
$function$

CREATE OR REPLACE FUNCTION nemura.company_policy_guard()
 RETURNS trigger
 LANGUAGE plpgsql
 SET search_path TO 'pg_catalog', 'nemura', 'pg_temp'
AS $function$
BEGIN
  IF TG_OP = 'DELETE' OR (TG_OP = 'UPDATE' AND (NEW.effective_from IS DISTINCT FROM OLD.effective_from OR NEW.rules IS DISTINCT FROM OLD.rules OR NEW.pack_version IS DISTINCT FROM OLD.pack_version
     OR (OLD.effective_to IS NOT NULL AND NEW.effective_to IS DISTINCT FROM OLD.effective_to))) THEN
    RAISE EXCEPTION 'A company policy is history: it can only be ended, once' USING ERRCODE = 'NM130';
  END IF;
  IF EXISTS (SELECT 1 FROM nemura.company_policy p WHERE p.organisation_id = NEW.organisation_id AND p.id <> NEW.id
               AND daterange(p.effective_from, coalesce(p.effective_to, 'infinity'), '[)') && daterange(NEW.effective_from, coalesce(NEW.effective_to, 'infinity'), '[)')) THEN
    RAISE EXCEPTION 'A company has one policy at a time' USING ERRCODE = 'NM131';
  END IF;
  RETURN NEW;
END
$function$

CREATE OR REPLACE FUNCTION nemura.current_org()
 RETURNS uuid
 LANGUAGE sql
 STABLE PARALLEL SAFE
AS $function$
  SELECT CAST(nullif(pg_catalog.current_setting('app.org_id', true), '') AS pg_catalog.uuid)
$function$

CREATE OR REPLACE FUNCTION nemura.current_person()
 RETURNS uuid
 LANGUAGE sql
 STABLE PARALLEL SAFE
AS $function$
  SELECT CAST(nullif(pg_catalog.current_setting('app.person_id', true), '') AS pg_catalog.uuid)
$function$

CREATE OR REPLACE FUNCTION nemura.decision_once_guard()
 RETURNS trigger
 LANGUAGE plpgsql
 SET search_path TO 'pg_catalog', 'nemura', 'pg_temp'
AS $function$
BEGIN
  RAISE EXCEPTION '% is evidence: a decision is made once', TG_ARGV[0] USING ERRCODE = 'NM155';
END
$function$

CREATE OR REPLACE FUNCTION nemura.details_change_guard()
 RETURNS trigger
 LANGUAGE plpgsql
 SET search_path TO 'pg_catalog', 'nemura', 'pg_temp'
AS $function$
BEGIN
  IF TG_OP = 'DELETE' OR NEW.person_id IS DISTINCT FROM OLD.person_id OR NEW.kind IS DISTINCT FROM OLD.kind OR NEW.new_legal_name IS DISTINCT FROM OLD.new_legal_name
     OR NEW.new_residency IS DISTINCT FROM OLD.new_residency OR NEW.new_pr_start IS DISTINCT FROM OLD.new_pr_start OR NEW.note IS DISTINCT FROM OLD.note
     OR NEW.evidence_id IS DISTINCT FROM OLD.evidence_id OR NEW.requested_by IS DISTINCT FROM OLD.requested_by OR NEW.requested_at IS DISTINCT FROM OLD.requested_at
     OR NEW.due_on IS DISTINCT FROM OLD.due_on OR OLD.state <> 'requested' OR NEW.state = 'requested' THEN
    RAISE EXCEPTION 'A request to change details keeps its words and its evidence, and is decided once' USING ERRCODE = 'NM165';
  END IF;
  IF NEW.state IN ('approved', 'refused') AND EXISTS (SELECT 1 FROM nemura.person p WHERE p.organisation_id = NEW.organisation_id AND p.id = NEW.person_id AND p.member_id = NEW.decided_by) THEN
    RAISE EXCEPTION 'Nobody decides a change to their own details: another member of the people team does' USING ERRCODE = 'NM166';
  END IF;
  RETURN NEW;
END
$function$

CREATE OR REPLACE FUNCTION nemura.feature_state_guard()
 RETURNS trigger
 LANGUAGE plpgsql
 SET search_path TO 'pg_catalog', 'nemura', 'pg_temp'
AS $function$
BEGIN
  IF TG_OP = 'DELETE' OR NEW.feature IS DISTINCT FROM OLD.feature THEN
    RAISE EXCEPTION 'A feature switch is changed, never removed or renamed' USING ERRCODE = 'NM125';
  END IF;
  RETURN NEW;
END
$function$

CREATE OR REPLACE FUNCTION nemura.flex_request_guard()
 RETURNS trigger
 LANGUAGE plpgsql
 SET search_path TO 'pg_catalog', 'nemura', 'pg_temp'
AS $function$
BEGIN
  IF TG_OP = 'DELETE' THEN
    RAISE EXCEPTION 'A flexible work request is evidence: it is withdrawn, never deleted' USING ERRCODE = 'NM151';
  END IF;
  IF TG_OP = 'INSERT' THEN
    IF NEW.state <> 'received' THEN
      RAISE EXCEPTION 'A flexible work request starts received' USING ERRCODE = 'NM151';
    END IF;
    RETURN NEW;
  END IF;
  IF NEW.person_id IS DISTINCT FROM OLD.person_id OR NEW.arrangement IS DISTINCT FROM OLD.arrangement OR NEW.start_date IS DISTINCT FROM OLD.start_date
     OR NEW.end_date IS DISTINCT FROM OLD.end_date OR NEW.reason IS DISTINCT FROM OLD.reason OR NEW.received_on IS DISTINCT FROM OLD.received_on
     OR NEW.reply_due IS DISTINCT FROM OLD.reply_due OR NEW.pack_version IS DISTINCT FROM OLD.pack_version OR NEW.requested_by IS DISTINCT FROM OLD.requested_by
     OR NEW.requested_at IS DISTINCT FROM OLD.requested_at THEN
    RAISE EXCEPTION 'A flexible work request keeps its words, its receipt date and its deadline' USING ERRCODE = 'NM151';
  END IF;
  IF OLD.state <> 'received' THEN
    RAISE EXCEPTION 'A % flexible work request is closed', OLD.state USING ERRCODE = 'NM151';
  END IF;
  IF NEW.state = 'replied' AND EXISTS (SELECT 1 FROM nemura.person p WHERE p.organisation_id = NEW.organisation_id AND p.id = NEW.person_id AND p.member_id = NEW.replied_by) THEN
    RAISE EXCEPTION 'Nobody answers their own flexible work request' USING ERRCODE = 'NM152';
  END IF;
  RETURN NEW;
END
$function$

CREATE OR REPLACE FUNCTION nemura.fyniq_link_guard()
 RETURNS trigger
 LANGUAGE plpgsql
 SET search_path TO 'pg_catalog', 'nemura', 'pg_temp'
AS $function$
DECLARE
  top integer;
BEGIN
  IF TG_OP = 'DELETE' THEN
    RAISE EXCEPTION 'A link is kept: unlink it instead' USING ERRCODE = 'NM190';
  END IF;
  IF TG_OP = 'INSERT' THEN
    SELECT coalesce(max(epoch), 0) INTO top FROM nemura.fyniq_link WHERE organisation_id = NEW.organisation_id;
    IF NEW.state NOT IN ('proposed', 'active') OR NEW.version <> 1 OR NEW.epoch <> top + 1 THEN
      RAISE EXCEPTION 'A link starts proposed or active, at its first version, one epoch above the last' USING ERRCODE = 'NM190';
    END IF;
    RETURN NEW;
  END IF;
  IF (NEW.id, NEW.epoch, NEW.fyniq_organisation_id, NEW.link_public, NEW.created_at, NEW.peer_client_id, NEW.peer_ask_client_id, NEW.proposed_by) IS DISTINCT FROM
     (OLD.id, OLD.epoch, OLD.fyniq_organisation_id, OLD.link_public, OLD.created_at, OLD.peer_client_id, OLD.peer_ask_client_id, OLD.proposed_by)
     OR ((NEW.fyniq_key, NEW.fyniq_client_id) IS DISTINCT FROM (OLD.fyniq_key, OLD.fyniq_client_id) AND NOT (OLD.state = 'proposed' AND NEW.state = 'active'))
     OR NEW.sequence < OLD.sequence
     OR NEW.version <> OLD.version + 1
     OR (NEW.state <> OLD.state AND NOT ((OLD.state, NEW.state) IN (('proposed', 'active'), ('proposed', 'unlinked'), ('active', 'suspended'), ('suspended', 'active'),
                                       ('active', 'unlinking'), ('suspended', 'unlinking'), ('unlinking', 'unlinked'), ('unlinking', 'active')))) THEN
    RAISE EXCEPTION 'A link only moves between its states, at its next version, and keeps its epoch and keys' USING ERRCODE = 'NM190';
  END IF;
  RETURN NEW;
END
$function$

CREATE OR REPLACE FUNCTION nemura.gov_leave_guard()
 RETURNS trigger
 LANGUAGE plpgsql
 SET search_path TO 'pg_catalog', 'nemura', 'pg_temp'
AS $function$
BEGIN
  IF TG_OP <> 'INSERT' THEN
    RAISE EXCEPTION '% is evidence: a correction is a new record', TG_ARGV[0] USING ERRCODE = 'NM149';
  END IF;
  IF TG_TABLE_NAME = 'gov_leave' THEN
    PERFORM pg_advisory_xact_lock(hashtextextended(NEW.organisation_id::text || NEW.person_id::text, 0));
    IF nemura.person_has_leave(NEW.organisation_id, NEW.person_id, NEW.start_date, NEW.end_date) THEN
      RAISE EXCEPTION 'The person has leave, sick leave or government-paid leave on some of those days' USING ERRCODE = 'NM150';
    END IF;
  END IF;
  RETURN NEW;
END
$function$

CREATE OR REPLACE FUNCTION nemura.has_role(wanted text)
 RETURNS boolean
 LANGUAGE sql
 STABLE SECURITY DEFINER
 SET search_path TO 'pg_catalog', 'nemura', 'pg_temp'
AS $function$
  SELECT EXISTS (
    SELECT 1 FROM nemura.role_assignment a
     WHERE a.organisation_id = nemura.current_org() AND a.member_id = nemura.current_person() AND a.role = wanted
       AND a.effective_from <= coalesce(nullif(pg_catalog.current_setting('app.on', true), '')::date, current_date)
       AND (a.effective_to IS NULL OR a.effective_to > coalesce(nullif(pg_catalog.current_setting('app.on', true), '')::date, current_date)))
$function$

CREATE OR REPLACE FUNCTION nemura.hr_question_guard()
 RETURNS trigger
 LANGUAGE plpgsql
 SET search_path TO 'pg_catalog', 'nemura', 'pg_temp'
AS $function$
BEGIN
  IF TG_OP = 'DELETE' OR NEW.person_id IS DISTINCT FROM OLD.person_id OR NEW.question IS DISTINCT FROM OLD.question OR NEW.asked_at IS DISTINCT FROM OLD.asked_at
     OR NEW.due_on IS DISTINCT FROM OLD.due_on OR OLD.state <> 'open' OR NEW.state = 'open' THEN
    RAISE EXCEPTION 'A question keeps its words and is answered or withdrawn once' USING ERRCODE = 'NM167';
  END IF;
  IF NEW.state = 'answered' AND EXISTS (SELECT 1 FROM nemura.person p WHERE p.organisation_id = NEW.organisation_id AND p.id = NEW.person_id AND p.member_id = NEW.replied_by) THEN
    RAISE EXCEPTION 'Nobody answers their own question: another member of the people team does' USING ERRCODE = 'NM168';
  END IF;
  RETURN NEW;
END
$function$

CREATE OR REPLACE FUNCTION nemura.is_manager_of(report uuid)
 RETURNS boolean
 LANGUAGE sql
 STABLE SECURITY DEFINER
 SET search_path TO 'pg_catalog', 'nemura', 'pg_temp'
AS $function$
  SELECT EXISTS (
    SELECT 1 FROM nemura.reporting_line l
     WHERE l.organisation_id = nemura.current_org() AND l.report_id = report AND l.manager_id = nemura.current_person()
       AND l.effective_from <= coalesce(nullif(pg_catalog.current_setting('app.on', true), '')::date, current_date)
       AND (l.effective_to IS NULL OR l.effective_to > coalesce(nullif(pg_catalog.current_setting('app.on', true), '')::date, current_date)))
$function$

CREATE OR REPLACE FUNCTION nemura.issue_owner_recovery(p_org uuid, p_id uuid, p_member uuid, p_hash bytea, p_operators text[], p_event_id uuid, p_body text, p_on date)
 RETURNS timestamp with time zone
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'pg_catalog', 'nemura', 'pg_temp'
AS $function$
DECLARE
  expires timestamptz := now() + interval '24 hours';
  names text[];
BEGIN
  PERFORM set_config('app.org_id', p_org::text, true);
  SELECT array_agg(btrim(n)) INTO names FROM unnest(p_operators) AS n;
  IF names IS NULL OR cardinality(names) <> 2 OR EXISTS (SELECT 1 FROM unnest(names) n WHERE length(n) NOT BETWEEN 1 AND 100)
     OR lower(names[1]) = lower(names[2]) THEN
    RAISE EXCEPTION 'A recovery needs exactly two different operators, by name' USING ERRCODE = 'NM110';
  END IF;
  IF NOT EXISTS (
    SELECT 1 FROM nemura.member m JOIN nemura.role_assignment a ON a.organisation_id = m.organisation_id AND a.member_id = m.id
     WHERE m.organisation_id = p_org AND m.id = p_member AND m.deactivated_at IS NULL AND a.role = 'owner'
       AND a.effective_from <= p_on AND (a.effective_to IS NULL OR a.effective_to > p_on)) THEN
    RAISE EXCEPTION 'The member is not an active Owner of that organisation' USING ERRCODE = 'NM111';
  END IF;
  INSERT INTO nemura.audit_event (id, body) VALUES (p_event_id, p_body);
  INSERT INTO nemura.owner_recovery (id, member_id, code_hash, operators, created_at, expires_at)
  VALUES (p_id, p_member, p_hash, names, now(), expires);
  RETURN expires;
END
$function$

CREATE OR REPLACE FUNCTION nemura.join_task_guard()
 RETURNS trigger
 LANGUAGE plpgsql
 SET search_path TO 'pg_catalog', 'nemura', 'pg_temp'
AS $function$
BEGIN
  IF TG_OP = 'DELETE' OR NEW.person_id IS DISTINCT FROM OLD.person_id OR NEW.kind IS DISTINCT FROM OLD.kind OR NEW.raised_at IS DISTINCT FROM OLD.raised_at
     OR OLD.state <> 'open' OR NEW.state = 'open' THEN
    RAISE EXCEPTION 'A task is done or dismissed once' USING ERRCODE = 'NM170';
  END IF;
  RETURN NEW;
END
$function$

CREATE OR REPLACE FUNCTION nemura.leave_accrual_guard()
 RETURNS trigger
 LANGUAGE plpgsql
 SET search_path TO 'pg_catalog', 'nemura', 'pg_temp'
AS $function$
BEGIN
  IF TG_OP = 'DELETE' OR NEW.month IS DISTINCT FROM OLD.month OR NEW.person_id IS DISTINCT FROM OLD.person_id OR NEW.carried_days IS DISTINCT FROM OLD.carried_days
     OR NEW.annual_left IS DISTINCT FROM OLD.annual_left OR NEW.drafted_by IS DISTINCT FROM OLD.drafted_by OR NEW.drafted_at IS DISTINCT FROM OLD.drafted_at
     OR (OLD.state = 'approved' AND NEW IS DISTINCT FROM OLD) THEN
    RAISE EXCEPTION 'An accrual draft is evidence: it is approved once and never edited or deleted' USING ERRCODE = 'NM156';
  END IF;
  RETURN NEW;
END
$function$

CREATE OR REPLACE FUNCTION nemura.leave_ledger_guard()
 RETURNS trigger
 LANGUAGE plpgsql
 SET search_path TO 'pg_catalog', 'nemura', 'pg_temp'
AS $function$
DECLARE
  total numeric;
BEGIN
  IF TG_OP <> 'INSERT' THEN
    RAISE EXCEPTION 'The leave ledger is append-only: a correction is a new entry' USING ERRCODE = 'NM142';
  END IF;
  IF NOT NEW.negative_ok AND NEW.amount < 0 THEN
    SELECT coalesce(sum(amount), 0) INTO total FROM nemura.leave_ledger
     WHERE organisation_id = NEW.organisation_id AND person_id = NEW.person_id AND type_key = NEW.type_key AND leave_year = NEW.leave_year;
    IF total + NEW.amount < 0 THEN
      RAISE EXCEPTION 'That would take the balance below zero' USING ERRCODE = 'NM143';
    END IF;
  END IF;
  RETURN NEW;
END
$function$

CREATE OR REPLACE FUNCTION nemura.leave_request_guard()
 RETURNS trigger
 LANGUAGE plpgsql
 SET search_path TO 'pg_catalog', 'nemura', 'pg_temp'
AS $function$
BEGIN
  IF TG_OP = 'DELETE' THEN
    RAISE EXCEPTION 'A leave request is evidence: it is cancelled, never deleted' USING ERRCODE = 'NM144';
  END IF;
  IF TG_OP = 'INSERT' THEN
    IF NEW.state <> 'pending' THEN
      RAISE EXCEPTION 'A leave request starts pending' USING ERRCODE = 'NM144';
    END IF;
    PERFORM pg_advisory_xact_lock(hashtextextended(NEW.organisation_id::text || NEW.person_id::text, 0));
    IF nemura.person_has_leave(NEW.organisation_id, NEW.person_id, NEW.start_date, NEW.end_date) THEN
      RAISE EXCEPTION 'The person has leave requested, approved, sick or government-paid on some of those days' USING ERRCODE = 'NM145';
    END IF;
    RETURN NEW;
  END IF;
  IF NEW.person_id IS DISTINCT FROM OLD.person_id OR NEW.type_key IS DISTINCT FROM OLD.type_key OR NEW.leave_year IS DISTINCT FROM OLD.leave_year
     OR NEW.start_date IS DISTINCT FROM OLD.start_date OR NEW.end_date IS DISTINCT FROM OLD.end_date OR NEW.start_half IS DISTINCT FROM OLD.start_half
     OR NEW.end_half IS DISTINCT FROM OLD.end_half OR NEW.days IS DISTINCT FROM OLD.days OR NEW.note IS DISTINCT FROM OLD.note
     OR NEW.requested_by IS DISTINCT FROM OLD.requested_by OR NEW.requested_at IS DISTINCT FROM OLD.requested_at THEN
    RAISE EXCEPTION 'A leave request is evidence: only its decision changes' USING ERRCODE = 'NM144';
  END IF;
  IF NEW.state IS DISTINCT FROM OLD.state AND NOT ((OLD.state = 'pending' AND NEW.state IN ('approved', 'refused', 'cancelled')) OR (OLD.state = 'approved' AND NEW.state = 'cancelled')) THEN
    RAISE EXCEPTION 'A % leave request cannot become %', OLD.state, NEW.state USING ERRCODE = 'NM144';
  END IF;
  IF OLD.decided_by IS NOT NULL AND NEW.state IN ('approved', 'refused') AND (NEW.decided_by IS DISTINCT FROM OLD.decided_by OR NEW.decided_at IS DISTINCT FROM OLD.decided_at OR NEW.decision_reason IS DISTINCT FROM OLD.decision_reason) THEN
    RAISE EXCEPTION 'A decision is written once' USING ERRCODE = 'NM144';
  END IF;
  IF OLD.settled_at IS NOT NULL AND NEW.settled_at IS DISTINCT FROM OLD.settled_at THEN
    RAISE EXCEPTION 'A settled request stays settled' USING ERRCODE = 'NM144';
  END IF;
  RETURN NEW;
END
$function$

CREATE OR REPLACE FUNCTION nemura.letter_delegation_guard()
 RETURNS trigger
 LANGUAGE plpgsql
 SET search_path TO 'pg_catalog', 'nemura', 'pg_temp'
AS $function$
BEGIN
  IF TG_OP = 'DELETE' OR NEW.type_key IS DISTINCT FROM OLD.type_key OR NEW.template_id IS DISTINCT FROM OLD.template_id OR NEW.who IS DISTINCT FROM OLD.who
     OR NEW.fields IS DISTINCT FROM OLD.fields OR NEW.monthly_limit IS DISTINCT FROM OLD.monthly_limit OR NEW.created_on IS DISTINCT FROM OLD.created_on OR NEW.ends_on IS DISTINCT FROM OLD.ends_on
     OR NEW.created_by IS DISTINCT FROM OLD.created_by OR NEW.created_at IS DISTINCT FROM OLD.created_at OR OLD.revoked_at IS NOT NULL OR NEW.revoked_at IS NULL THEN
    RAISE EXCEPTION 'A delegation keeps its terms and is revoked once' USING ERRCODE = 'NM169';
  END IF;
  RETURN NEW;
END
$function$

CREATE OR REPLACE FUNCTION nemura.letter_request_guard()
 RETURNS trigger
 LANGUAGE plpgsql
 SET search_path TO 'pg_catalog', 'nemura', 'pg_temp'
AS $function$
BEGIN
  IF TG_OP = 'DELETE' THEN
    RAISE EXCEPTION 'A letter request is evidence: it is withdrawn, never deleted' USING ERRCODE = 'NM161';
  END IF;
  IF TG_OP = 'INSERT' THEN
    IF NEW.state <> 'requested' THEN
      RAISE EXCEPTION 'A letter request starts requested' USING ERRCODE = 'NM161';
    END IF;
    RETURN NEW;
  END IF;
  IF NEW.person_id IS DISTINCT FROM OLD.person_id OR NEW.type_key IS DISTINCT FROM OLD.type_key OR NEW.template_id IS DISTINCT FROM OLD.template_id OR NEW.purpose IS DISTINCT FROM OLD.purpose
     OR NEW.data IS DISTINCT FROM OLD.data OR NEW.due_on IS DISTINCT FROM OLD.due_on OR NEW.requested_by IS DISTINCT FROM OLD.requested_by OR NEW.requested_at IS DISTINCT FROM OLD.requested_at THEN
    RAISE EXCEPTION 'A letter request keeps its words and its data' USING ERRCODE = 'NM161';
  END IF;
  IF NEW.state IS DISTINCT FROM OLD.state AND NOT ((OLD.state = 'requested' AND NEW.state IN ('checked', 'refused', 'withdrawn')) OR (OLD.state = 'checked' AND NEW.state IN ('issued', 'refused', 'withdrawn'))) THEN
    RAISE EXCEPTION 'A % letter request cannot become %', OLD.state, NEW.state USING ERRCODE = 'NM161';
  END IF;
  IF OLD.render_sha256 IS NOT NULL AND (NEW.render_sha256 IS DISTINCT FROM OLD.render_sha256 OR NEW.render_blob IS DISTINCT FROM OLD.render_blob OR NEW.reference IS DISTINCT FROM OLD.reference) THEN
    RAISE EXCEPTION 'The checked letter is the letter that is signed: its bytes and reference never change' USING ERRCODE = 'NM161';
  END IF;
  IF NEW.state = 'checked' AND EXISTS (SELECT 1 FROM nemura.person p WHERE p.organisation_id = NEW.organisation_id AND p.id = NEW.person_id AND p.member_id = NEW.checked_by) THEN
    RAISE EXCEPTION 'Nobody checks their own letter' USING ERRCODE = 'NM162';
  END IF;
  RETURN NEW;
END
$function$

CREATE OR REPLACE FUNCTION nemura.letter_template_guard()
 RETURNS trigger
 LANGUAGE plpgsql
 SET search_path TO 'pg_catalog', 'nemura', 'pg_temp'
AS $function$
BEGIN
  IF TG_OP = 'DELETE' THEN
    RAISE EXCEPTION 'A template version is never deleted' USING ERRCODE = 'NM160';
  END IF;
  IF TG_OP = 'UPDATE' THEN
    IF NEW.type_key IS DISTINCT FROM OLD.type_key OR NEW.created_by IS DISTINCT FROM OLD.created_by OR NEW.created_at IS DISTINCT FROM OLD.created_at THEN
      RAISE EXCEPTION 'A template version keeps its type and its author' USING ERRCODE = 'NM160';
    END IF;
    IF OLD.state = 'draft' AND NEW.state = 'draft' THEN
      RETURN NEW;
    END IF;
    IF OLD.state = 'draft' AND NEW.state = 'published' THEN
      IF NEW.blocks IS DISTINCT FROM OLD.blocks OR NEW.note IS DISTINCT FROM OLD.note THEN
        RAISE EXCEPTION 'A draft is published as it is' USING ERRCODE = 'NM160';
      END IF;
      RETURN NEW;
    END IF;
    IF OLD.state = 'published' AND NEW.state = 'superseded' AND NEW.blocks IS NOT DISTINCT FROM OLD.blocks AND NEW.version IS NOT DISTINCT FROM OLD.version
       AND NEW.approved_by IS NOT DISTINCT FROM OLD.approved_by AND NEW.approved_at IS NOT DISTINCT FROM OLD.approved_at AND NEW.note IS NOT DISTINCT FROM OLD.note THEN
      RETURN NEW;
    END IF;
    RAISE EXCEPTION 'A published template version is immutable: change it with a new version' USING ERRCODE = 'NM160';
  END IF;
  RETURN NEW;
END
$function$

CREATE OR REPLACE FUNCTION nemura.link_append_only()
 RETURNS trigger
 LANGUAGE plpgsql
 SET search_path TO 'pg_catalog', 'nemura', 'pg_temp'
AS $function$
BEGIN
  RAISE EXCEPTION 'What the link received is kept as it came: a change is a new event' USING ERRCODE = 'NM191';
END
$function$

CREATE OR REPLACE FUNCTION nemura.link_client_registered()
 RETURNS trigger
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'pg_catalog', 'nemura', 'pg_temp'
AS $function$
BEGIN
  IF NEW.peer_client_id IS NOT NULL THEN
    INSERT INTO nemura.link_client_route (peer_client_id, organisation_id, link_id, purpose) VALUES (NEW.peer_client_id, NEW.organisation_id, NEW.id, 'events');
  END IF;
  IF NEW.peer_ask_client_id IS NOT NULL THEN
    INSERT INTO nemura.link_client_route (peer_client_id, organisation_id, link_id, purpose) VALUES (NEW.peer_ask_client_id, NEW.organisation_id, NEW.id, 'ask');
  END IF;
  RETURN NULL;
END
$function$

CREATE OR REPLACE FUNCTION nemura.link_client_route(p_client text, OUT organisation_id uuid, OUT link_id uuid, OUT purpose text)
 RETURNS record
 LANGUAGE sql
 STABLE SECURITY DEFINER
 SET search_path TO 'pg_catalog', 'nemura', 'pg_temp'
AS $function$
  SELECT r.organisation_id, r.link_id, r.purpose FROM nemura.link_client_route r WHERE r.peer_client_id = p_client
$function$

CREATE OR REPLACE FUNCTION nemura.link_event_guard()
 RETURNS trigger
 LANGUAGE plpgsql
 SET search_path TO 'pg_catalog', 'nemura', 'pg_temp'
AS $function$
BEGIN
  IF TG_OP = 'DELETE' OR (NEW.id, NEW.link_id, NEW.event_id, NEW.epoch, NEW.sequence, NEW.type, NEW.object_type, NEW.object_id, NEW.object_version, NEW.queued_at) IS DISTINCT FROM
     (OLD.id, OLD.link_id, OLD.event_id, OLD.epoch, OLD.sequence, OLD.type, OLD.object_type, OLD.object_id, OLD.object_version, OLD.queued_at)
     OR (OLD.state IN ('sent', 'refused') AND NEW.state IS DISTINCT FROM OLD.state) OR NEW.attempts < OLD.attempts THEN
    RAISE EXCEPTION 'The log of what was sent to Fyniq is kept as it was queued: only its state moves, and a settled event stays settled' USING ERRCODE = 'NM192';
  END IF;
  RETURN NEW;
END
$function$

CREATE OR REPLACE FUNCTION nemura.link_identity(p_issuer text, p_subject text, p_tenant text, p_member uuid)
 RETURNS void
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'pg_catalog', 'nemura', 'pg_temp'
AS $function$
BEGIN
  INSERT INTO nemura.identity_directory (issuer, subject, tenant, organisation_id, member_id)
  VALUES (p_issuer, p_subject, p_tenant, nemura.require_org(), p_member);
END
$function$

CREATE OR REPLACE FUNCTION nemura.link_restore_guard()
 RETURNS trigger
 LANGUAGE plpgsql
 SET search_path TO 'pg_catalog', 'nemura', 'pg_temp'
AS $function$
BEGIN
  IF TG_OP = 'DELETE' THEN
    RAISE EXCEPTION 'A restore is kept as it was recorded' USING ERRCODE = 'NM193';
  END IF;
  IF TG_TABLE_NAME = 'link_restore' THEN
    IF (NEW.id, NEW.link_id, NEW.recorded_at, NEW.recorded_by, NEW.last_sequence_queued, NEW.last_sequence_sent, NEW.last_fyniq_sequence) IS DISTINCT FROM
       (OLD.id, OLD.link_id, OLD.recorded_at, OLD.recorded_by, OLD.last_sequence_queued, OLD.last_sequence_sent, OLD.last_fyniq_sequence) OR OLD.state <> 'open' THEN
      RAISE EXCEPTION 'A restore is kept as it was recorded: it is only reconciled, once' USING ERRCODE = 'NM193';
    END IF;
  ELSIF (NEW.restore_id, NEW.run_id, NEW.version) IS DISTINCT FROM (OLD.restore_id, OLD.run_id, OLD.version) OR OLD.outcome IS NOT NULL THEN
    RAISE EXCEPTION 'A run held by a restore is decided once' USING ERRCODE = 'NM193';
  END IF;
  RETURN NEW;
END
$function$

CREATE OR REPLACE FUNCTION nemura.lock_leave_head(p_person uuid, p_type text, p_year integer)
 RETURNS void
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'pg_catalog', 'nemura', 'pg_temp'
AS $function$
BEGIN
  INSERT INTO nemura.leave_head (person_id, type_key, leave_year) VALUES (p_person, p_type, p_year) ON CONFLICT DO NOTHING;
  PERFORM 1 FROM nemura.leave_head WHERE organisation_id = nemura.current_org() AND person_id = p_person AND type_key = p_type AND leave_year = p_year FOR UPDATE;
END
$function$

CREATE OR REPLACE FUNCTION nemura.member_deactivated()
 RETURNS trigger
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'pg_catalog', 'nemura', 'pg_temp'
AS $function$
BEGIN
  UPDATE nemura.identity_directory SET active = (NEW.deactivated_at IS NULL) WHERE organisation_id = NEW.organisation_id AND member_id = NEW.id;
  RETURN NULL;
END
$function$

CREATE OR REPLACE FUNCTION nemura.member_identity(p_member uuid)
 RETURNS TABLE(issuer text, subject text)
 LANGUAGE sql
 STABLE SECURITY DEFINER
 SET search_path TO 'pg_catalog', 'nemura', 'pg_temp'
AS $function$
  SELECT d.issuer, d.subject
    FROM nemura.identity_directory d
   WHERE d.organisation_id = nemura.require_org() AND d.member_id = p_member AND d.active
   ORDER BY d.linked_at, d.issuer, d.subject
   LIMIT 1
$function$

CREATE OR REPLACE FUNCTION nemura.members_for_identity(p_issuer text, p_subject text, p_tenant text)
 RETURNS TABLE(organisation_id uuid, member_id uuid)
 LANGUAGE sql
 STABLE SECURITY DEFINER
 SET search_path TO 'pg_catalog', 'nemura', 'pg_temp'
AS $function$
  SELECT d.organisation_id, d.member_id
    FROM nemura.identity_directory d
   WHERE d.issuer = p_issuer AND d.subject = p_subject AND d.tenant = p_tenant AND d.active
   ORDER BY d.linked_at
$function$

CREATE OR REPLACE FUNCTION nemura.members_no_delete()
 RETURNS trigger
 LANGUAGE plpgsql
 SET search_path TO 'pg_catalog', 'nemura', 'pg_temp'
AS $function$
BEGIN
  RAISE EXCEPTION 'Members are deactivated, not deleted' USING ERRCODE = 'NM081';
END
$function$

CREATE OR REPLACE FUNCTION nemura.organisation_registered()
 RETURNS trigger
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'pg_catalog', 'nemura', 'pg_temp'
AS $function$
BEGIN
  INSERT INTO nemura.audit_chain (organisation_id) VALUES (NEW.organisation_id);
  INSERT INTO nemura.tenant_directory (organisation_id) VALUES (NEW.organisation_id);
  RETURN NULL;
END
$function$

CREATE OR REPLACE FUNCTION nemura.outbox_guard()
 RETURNS trigger
 LANGUAGE plpgsql
 SET search_path TO 'pg_catalog', 'nemura', 'pg_temp'
AS $function$
BEGIN
  IF NEW.worker_class IS DISTINCT FROM OLD.worker_class OR NEW.kind IS DISTINCT FROM OLD.kind
     OR NEW.payload IS DISTINCT FROM OLD.payload OR NEW.business_key IS DISTINCT FROM OLD.business_key
     OR NEW.created_at IS DISTINCT FROM OLD.created_at THEN
    RAISE EXCEPTION 'Outbox row % cannot change what it is', OLD.id USING ERRCODE = 'NM070';
  END IF;
  IF NEW.state IS DISTINCT FROM OLD.state AND NOT (
       (OLD.state = 'pending'    AND NEW.state IN ('dispatched', 'dead')) OR
       (OLD.state = 'dispatched' AND NEW.state IN ('running', 'dead')) OR
       (OLD.state = 'running'    AND NEW.state IN ('done', 'failed', 'dispatched', 'dead')) OR
       (OLD.state = 'failed'     AND NEW.state IN ('running', 'dispatched', 'dead')) OR
       (OLD.state = 'dead'       AND NEW.state IN ('pending'))) THEN
    RAISE EXCEPTION 'Outbox row % cannot go from % to %', OLD.id, OLD.state, NEW.state
      USING ERRCODE = 'NM071', HINT = 'pending -> dispatched -> running -> done | failed | dead (§12.11).';
  END IF;
  IF NEW.attempts < OLD.attempts OR NEW.dispatches < OLD.dispatches THEN
    RAISE EXCEPTION 'Outbox row % cannot count attempts or dispatches backwards', OLD.id USING ERRCODE = 'NM070';
  END IF;
  NEW.updated_at := now();
  RETURN NEW;
END
$function$

CREATE OR REPLACE FUNCTION nemura.outbox_no_delete()
 RETURNS trigger
 LANGUAGE plpgsql
 SET search_path TO 'pg_catalog', 'nemura', 'pg_temp'
AS $function$
BEGIN
  RAISE EXCEPTION 'Outbox rows are kept (% on %)', TG_OP, TG_TABLE_NAME USING ERRCODE = 'NM070';
END
$function$

CREATE OR REPLACE FUNCTION nemura.overtime_entry_guard()
 RETURNS trigger
 LANGUAGE plpgsql
 SET search_path TO 'pg_catalog', 'nemura', 'pg_temp'
AS $function$
BEGIN
  IF TG_OP = 'DELETE' THEN
    RAISE EXCEPTION 'An overtime record is never deleted: work beyond the limit stays recorded' USING ERRCODE = 'NM153';
  END IF;
  IF TG_OP = 'INSERT' THEN
    IF NEW.state <> 'pending' OR NEW.used_in_run IS NOT NULL THEN
      RAISE EXCEPTION 'An overtime record starts pending and unused' USING ERRCODE = 'NM153';
    END IF;
    RETURN NEW;
  END IF;
  IF NEW.person_id IS DISTINCT FROM OLD.person_id OR NEW.work_date IS DISTINCT FROM OLD.work_date OR NEW.kind IS DISTINCT FROM OLD.kind OR NEW.hours IS DISTINCT FROM OLD.hours
     OR NEW.branch IS DISTINCT FROM OLD.branch OR NEW.over_limit IS DISTINCT FROM OLD.over_limit OR NEW.note IS DISTINCT FROM OLD.note
     OR NEW.requested_by IS DISTINCT FROM OLD.requested_by OR NEW.requested_at IS DISTINCT FROM OLD.requested_at THEN
    RAISE EXCEPTION 'An overtime record is evidence: only its decision and its use change' USING ERRCODE = 'NM153';
  END IF;
  IF NEW.state IS DISTINCT FROM OLD.state AND OLD.state <> 'pending' THEN
    RAISE EXCEPTION 'A % overtime record cannot become %', OLD.state, NEW.state USING ERRCODE = 'NM153';
  END IF;
  IF OLD.decided_by IS NOT NULL AND (NEW.decided_by IS DISTINCT FROM OLD.decided_by OR NEW.decided_at IS DISTINCT FROM OLD.decided_at OR NEW.decision_reason IS DISTINCT FROM OLD.decision_reason) THEN
    RAISE EXCEPTION 'A decision is written once' USING ERRCODE = 'NM153';
  END IF;
  IF OLD.used_in_run IS NOT NULL AND (NEW.used_in_run IS DISTINCT FROM OLD.used_in_run OR NEW.used_at IS DISTINCT FROM OLD.used_at) THEN
    RAISE EXCEPTION 'A record used by a pay run is used once' USING ERRCODE = 'NM153';
  END IF;
  IF NEW.state IN ('approved', 'refused') AND OLD.state = 'pending' AND EXISTS (SELECT 1 FROM nemura.person p WHERE p.organisation_id = NEW.organisation_id AND p.id = NEW.person_id AND p.member_id = NEW.decided_by) THEN
    RAISE EXCEPTION 'Nobody decides their own overtime' USING ERRCODE = 'NM154';
  END IF;
  RETURN NEW;
END
$function$

CREATE OR REPLACE FUNCTION nemura.owner_recovery_guard()
 RETURNS trigger
 LANGUAGE plpgsql
 SET search_path TO 'pg_catalog', 'nemura', 'pg_temp'
AS $function$
BEGIN
  IF TG_OP = 'DELETE' OR NEW.member_id IS DISTINCT FROM OLD.member_id OR NEW.code_hash IS DISTINCT FROM OLD.code_hash
     OR NEW.operators IS DISTINCT FROM OLD.operators OR NEW.expires_at IS DISTINCT FROM OLD.expires_at OR NEW.created_at IS DISTINCT FROM OLD.created_at
     OR OLD.used_at IS NOT NULL OR NEW.used_at IS NULL OR NEW.used_xact IS DISTINCT FROM OLD.used_xact THEN
    RAISE EXCEPTION 'A recovery code can only be used, once' USING ERRCODE = 'NM113';
  END IF;
  IF OLD.expires_at <= now() THEN
    RAISE EXCEPTION 'The recovery code has expired' USING ERRCODE = 'NM113';
  END IF;
  NEW.used_xact := pg_current_xact_id()::text::bigint;
  RETURN NEW;
END
$function$

CREATE OR REPLACE FUNCTION nemura.pack_record_guard()
 RETURNS trigger
 LANGUAGE plpgsql
 SET search_path TO 'pg_catalog', 'nemura', 'pg_temp'
AS $function$
BEGIN
  RAISE EXCEPTION '% is never changed or deleted', TG_ARGV[0] USING ERRCODE = 'NM129';
END
$function$

CREATE OR REPLACE FUNCTION nemura.passkey_challenge_guard()
 RETURNS trigger
 LANGUAGE plpgsql
 SET search_path TO 'pg_catalog', 'nemura', 'pg_temp'
AS $function$
BEGIN
  IF TG_OP = 'DELETE' OR OLD.used_at IS NOT NULL OR NEW.challenge IS DISTINCT FROM OLD.challenge OR NEW.session_id IS DISTINCT FROM OLD.session_id
     OR NEW.purpose IS DISTINCT FROM OLD.purpose OR NEW.expires_at IS DISTINCT FROM OLD.expires_at THEN
    RAISE EXCEPTION 'A passkey challenge is used once and never changed' USING ERRCODE = 'NM102';
  END IF;
  RETURN NEW;
END
$function$

CREATE OR REPLACE FUNCTION nemura.passkey_guard()
 RETURNS trigger
 LANGUAGE plpgsql
 SET search_path TO 'pg_catalog', 'nemura', 'pg_temp'
AS $function$
BEGIN
  IF TG_OP = 'DELETE' OR NEW.member_id IS DISTINCT FROM OLD.member_id OR NEW.credential_id IS DISTINCT FROM OLD.credential_id
     OR NEW.public_key IS DISTINCT FROM OLD.public_key OR NEW.created_at IS DISTINCT FROM OLD.created_at
     OR (OLD.revoked_at IS NOT NULL AND NEW.revoked_at IS DISTINCT FROM OLD.revoked_at) THEN
    RAISE EXCEPTION 'A passkey can only be used or revoked, once' USING ERRCODE = 'NM102';
  END IF;
  IF NEW.sign_count < OLD.sign_count AND NEW.sign_count <> 0 THEN
    RAISE EXCEPTION 'A passkey''s signature counter never goes back: the authenticator may be cloned' USING ERRCODE = 'NM103';
  END IF;
  RETURN NEW;
END
$function$

CREATE OR REPLACE FUNCTION nemura.pay_input_guard()
 RETURNS trigger
 LANGUAGE plpgsql
 SET search_path TO 'pg_catalog', 'nemura', 'pg_temp'
AS $function$
BEGIN
  IF TG_OP = 'DELETE' OR NEW.person_id IS DISTINCT FROM OLD.person_id OR NEW.kind IS DISTINCT FROM OLD.kind OR NEW.days IS DISTINCT FROM OLD.days OR NEW.from_date IS DISTINCT FROM OLD.from_date
     OR NEW.to_date IS DISTINCT FROM OLD.to_date OR NEW.source_type IS DISTINCT FROM OLD.source_type OR NEW.source_id IS DISTINCT FROM OLD.source_id OR NEW.note IS DISTINCT FROM OLD.note
     OR NEW.created_by IS DISTINCT FROM OLD.created_by OR NEW.created_at IS DISTINCT FROM OLD.created_at OR (OLD.used_in_run IS NOT NULL AND (NEW.used_in_run IS DISTINCT FROM OLD.used_in_run OR NEW.used_at IS DISTINCT FROM OLD.used_at)) THEN
    RAISE EXCEPTION 'A pay input is evidence: it is written once and used once' USING ERRCODE = 'NM155';
  END IF;
  RETURN NEW;
END
$function$

CREATE OR REPLACE FUNCTION nemura.pay_one_off_guard()
 RETURNS trigger
 LANGUAGE plpgsql
 SET search_path TO 'pg_catalog', 'nemura', 'pg_temp'
AS $function$
BEGIN
  IF TG_OP = 'DELETE' OR NEW.person_id IS DISTINCT FROM OLD.person_id OR NEW.month IS DISTINCT FROM OLD.month OR NEW.amount IS DISTINCT FROM OLD.amount OR NEW.name IS DISTINCT FROM OLD.name
     OR NEW.nature IS DISTINCT FROM OLD.nature OR NEW.cpf_wages IS DISTINCT FROM OLD.cpf_wages OR NEW.for_month IS DISTINCT FROM OLD.for_month OR NEW.payable_on IS DISTINCT FROM OLD.payable_on
     OR (OLD.used_in_run IS NOT NULL AND NEW.used_in_run IS DISTINCT FROM OLD.used_in_run) THEN
    RAISE EXCEPTION 'A one-off item keeps its words and its figures, and is used by one run once' USING ERRCODE = 'NM171';
  END IF;
  RETURN NEW;
END
$function$

CREATE OR REPLACE FUNCTION nemura.pay_payment_event_guard()
 RETURNS trigger
 LANGUAGE plpgsql
 SET search_path TO 'pg_catalog', 'nemura', 'pg_temp'
AS $function$
DECLARE
  prev text;
  last_seq integer;
  ok boolean;
BEGIN
  IF TG_OP <> 'INSERT' THEN
    RAISE EXCEPTION 'A payment state is evidence: a change is a new event' USING ERRCODE = 'NM127';
  END IF;
  PERFORM pg_advisory_xact_lock(hashtextextended('pay-payment:' || NEW.organisation_id::text || NEW.run_id::text || NEW.person_id::text, 0));
  SELECT state, seq INTO prev, last_seq FROM nemura.pay_payment_event
   WHERE organisation_id = NEW.organisation_id AND run_id = NEW.run_id AND person_id = NEW.person_id ORDER BY seq DESC LIMIT 1;
  IF NEW.seq IS DISTINCT FROM COALESCE(last_seq, 0) + 1 THEN
    RAISE EXCEPTION 'A payment state follows the last one: expected event number %', COALESCE(last_seq, 0) + 1 USING ERRCODE = 'NM175';
  END IF;
  IF prev IS NOT NULL THEN
    ok := CASE prev
      WHEN 'scheduled' THEN NEW.state IN ('released', 'sent', 'accepted', 'paid', 'rejected', 'unknown')
      WHEN 'released'  THEN NEW.state IN ('sent', 'accepted', 'paid', 'rejected', 'unknown')
      WHEN 'sent'      THEN NEW.state IN ('accepted', 'paid', 'rejected', 'returned', 'unknown')
      WHEN 'accepted'  THEN NEW.state IN ('paid', 'rejected', 'returned', 'unknown')
      WHEN 'paid'      THEN NEW.state IN ('returned')
      WHEN 'rejected'  THEN NEW.state IN ('scheduled')
      WHEN 'returned'  THEN NEW.state IN ('scheduled')
      WHEN 'unknown'   THEN NEW.state IN ('paid', 'rejected', 'returned')
      ELSE false END;
    IF NOT ok THEN
      RAISE EXCEPTION 'A payment cannot go from % to %: an unknown outcome is resolved as paid, rejected or returned before a new payment', prev, NEW.state USING ERRCODE = 'NM175';
    END IF;
  END IF;
  IF NEW.evidence_id IS NOT NULL AND NOT EXISTS (SELECT 1 FROM nemura.person_document WHERE organisation_id = NEW.organisation_id AND id = NEW.evidence_id AND person_id = NEW.person_id) THEN
    RAISE EXCEPTION 'The evidence of a payment is a document of the person paid' USING ERRCODE = 'NM176';
  END IF;
  RETURN NEW;
END
$function$

CREATE OR REPLACE FUNCTION nemura.pay_run_override_guard()
 RETURNS trigger
 LANGUAGE plpgsql
 SET search_path TO 'pg_catalog', 'nemura', 'pg_temp'
AS $function$
BEGIN
  IF TG_OP = 'DELETE' OR NEW.run_id IS DISTINCT FROM OLD.run_id OR NEW.person_id IS DISTINCT FROM OLD.person_id OR NEW.field IS DISTINCT FROM OLD.field OR NEW.value IS DISTINCT FROM OLD.value
     OR NEW.reason IS DISTINCT FROM OLD.reason OR NEW.created_by IS DISTINCT FROM OLD.created_by OR NEW.created_at IS DISTINCT FROM OLD.created_at OR OLD.withdrawn_at IS NOT NULL THEN
    RAISE EXCEPTION 'An override keeps its figure and its reason, and is withdrawn once' USING ERRCODE = 'NM174';
  END IF;
  RETURN NEW;
END
$function$

CREATE OR REPLACE FUNCTION nemura.pay_run_version_guard()
 RETURNS trigger
 LANGUAGE plpgsql
 SET search_path TO 'pg_catalog', 'nemura', 'pg_temp'
AS $function$
BEGIN
  IF TG_OP = 'DELETE' OR NEW.run_id IS DISTINCT FROM OLD.run_id OR NEW.version IS DISTINCT FROM OLD.version OR NEW.prepared_by IS DISTINCT FROM OLD.prepared_by OR NEW.prepared_at IS DISTINCT FROM OLD.prepared_at
     OR NEW.supersedes IS DISTINCT FROM OLD.supersedes OR NEW.reason IS DISTINCT FROM OLD.reason OR NEW.digest IS DISTINCT FROM OLD.digest OR NEW.pack_versions IS DISTINCT FROM OLD.pack_versions
     OR NEW.gross IS DISTINCT FROM OLD.gross OR NEW.net IS DISTINCT FROM OLD.net OR NEW.cpf_employee IS DISTINCT FROM OLD.cpf_employee OR NEW.cpf_employer IS DISTINCT FROM OLD.cpf_employer
     OR NEW.sdl_payable IS DISTINCT FROM OLD.sdl_payable OR NEW.shg IS DISTINCT FROM OLD.shg OR NEW.deductions IS DISTINCT FROM OLD.deductions OR NEW.disburse IS DISTINCT FROM OLD.disburse
     OR NEW.reimbursements IS DISTINCT FROM OLD.reimbursements OR NEW.employer_cost IS DISTINCT FROM OLD.employer_cost OR NEW.people IS DISTINCT FROM OLD.people
     OR (OLD.approved_by IS NOT NULL AND (NEW.approved_by IS DISTINCT FROM OLD.approved_by OR NEW.approved_at IS DISTINCT FROM OLD.approved_at OR NEW.approved_digest IS DISTINCT FROM OLD.approved_digest OR NEW.envelope IS DISTINCT FROM OLD.envelope)) THEN
    RAISE EXCEPTION 'A pay run version keeps its figures and its digest: a change is the next version' USING ERRCODE = 'NM173';
  END IF;
  IF NEW.state IS DISTINCT FROM OLD.state AND NOT ((OLD.state = 'calculated' AND NEW.state IN ('approved', 'superseded')) OR (OLD.state = 'approved' AND NEW.state IN ('superseded', 'posted'))
     OR (OLD.state = 'posted' AND NEW.state IN ('paid_in_part', 'paid', 'superseded')) OR (OLD.state = 'paid_in_part' AND NEW.state IN ('paid')) OR (OLD.state = 'paid' AND NEW.state = 'closed')) THEN
    RAISE EXCEPTION 'A % pay run version cannot become %', OLD.state, NEW.state USING ERRCODE = 'NM173';
  END IF;
  RETURN NEW;
END
$function$

CREATE OR REPLACE FUNCTION nemura.person_classification_guard()
 RETURNS trigger
 LANGUAGE plpgsql
 SET search_path TO 'pg_catalog', 'nemura', 'pg_temp'
AS $function$
BEGIN
  IF TG_OP = 'DELETE' OR (TG_OP = 'UPDATE' AND (NEW.person_id IS DISTINCT FROM OLD.person_id OR NEW.effective_from IS DISTINCT FROM OLD.effective_from
     OR NEW.contract_type IS DISTINCT FROM OLD.contract_type OR NEW.ea_covered IS DISTINCT FROM OLD.ea_covered OR NEW.part_iv_class IS DISTINCT FROM OLD.part_iv_class
     OR NEW.residency IS DISTINCT FROM OLD.residency OR NEW.pr_start_date IS DISTINCT FROM OLD.pr_start_date OR NEW.birth_date IS DISTINCT FROM OLD.birth_date
     OR (OLD.effective_to IS NOT NULL AND NEW.effective_to IS DISTINCT FROM OLD.effective_to))) THEN
    RAISE EXCEPTION 'A classification is history: it can only be ended, once' USING ERRCODE = 'NM123';
  END IF;
  IF EXISTS (SELECT 1 FROM nemura.person_classification c
              WHERE c.organisation_id = NEW.organisation_id AND c.person_id = NEW.person_id AND c.id <> NEW.id
                AND daterange(c.effective_from, coalesce(c.effective_to, 'infinity'), '[)') && daterange(NEW.effective_from, coalesce(NEW.effective_to, 'infinity'), '[)')) THEN
    RAISE EXCEPTION 'A person has one classification at a time' USING ERRCODE = 'NM124';
  END IF;
  RETURN NEW;
END
$function$

