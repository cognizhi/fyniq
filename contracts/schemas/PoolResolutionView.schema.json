{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "approval_id": {
      "description": "The approval request waiting, if one is.",
      "examples": [
        "01928f6e-7a3b-7c41-9d2e-5f8a1b3c6c11"
      ],
      "format": "uuid",
      "type": "string"
    },
    "checks": {
      "description": "A draft's status: ✖ while no evidence is attached.",
      "items": {
        "$ref": "BillCheck.schema.json"
      },
      "type": "array"
    },
    "class_account_id": {
      "description": "The share-capital account of the class the options are over.",
      "examples": [
        "01928f6e-7a3b-7c41-9d2e-5f8a1b3c4d30"
      ],
      "format": "uuid",
      "type": "string"
    },
    "class_code": {
      "description": "The class's account code.",
      "examples": [
        "3010"
      ],
      "type": "string"
    },
    "evidence": {
      "description": "How many files are attached and not removed: asking for approval needs one, the resolution.",
      "examples": [
        1
      ],
      "format": "int64",
      "type": "integer"
    },
    "id": {
      "description": "The resolution.",
      "examples": [
        "01928f6e-7a3b-7c41-9d2e-5f8a1b3c6c01"
      ],
      "format": "uuid",
      "type": "string"
    },
    "in_force": {
      "description": "It sets the pool's size today.",
      "examples": [
        true
      ],
      "type": "boolean"
    },
    "note": {
      "description": "A note.",
      "examples": [
        "ESOP 2026"
      ],
      "maxLength": 1000,
      "type": "string"
    },
    "recorded_at": {
      "description": "When it was recorded.",
      "examples": [
        "2026-10-02T09:30:00Z"
      ],
      "format": "date-time",
      "type": "string"
    },
    "recorded_by": {
      "$ref": "Person.schema.json",
      "description": "Who approved it, as it was recorded."
    },
    "resolution_ref": {
      "description": "The resolution that sets it.",
      "examples": [
        "Ordinary resolution 1 Oct 2026"
      ],
      "maxLength": 1000,
      "type": "string"
    },
    "resolved_on": {
      "description": "The day the resolution was passed: the pool has this size from then until a later resolution.",
      "examples": [
        "2026-10-01"
      ],
      "format": "date",
      "type": "string"
    },
    "size": {
      "description": "The shares the resolution sets aside for options, a whole number above zero.",
      "examples": [
        "1000000"
      ],
      "pattern": "^[0-9]{1,14}$",
      "type": "string"
    },
    "status": {
      "description": "draft: waiting for the resolution and approval; recorded: in the register.",
      "enum": [
        "draft",
        "recorded"
      ],
      "examples": [
        "recorded"
      ],
      "type": "string"
    },
    "version": {
      "description": "The version of its content; with its status it makes the ETag.",
      "examples": [
        1
      ],
      "format": "int64",
      "type": "integer"
    }
  },
  "required": [
    "id",
    "status",
    "version",
    "class_code",
    "in_force",
    "evidence",
    "checks",
    "size",
    "class_account_id",
    "resolution_ref",
    "resolved_on"
  ],
  "title": "PoolResolutionView",
  "type": "object"
}
