{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "approved_at": {
      "description": "When.",
      "examples": [
        "2027-01-03T02:00:00Z"
      ],
      "format": "date-time",
      "type": "string"
    },
    "approved_by": {
      "description": "The DPO who approved it, as records name actors.",
      "examples": [
        "user:01928f6e-7a3b-7c41-9d2e-5f8a1b3c5e10"
      ],
      "type": "string"
    },
    "cohort": {
      "description": "The last day of the financial year whose personal values it shreds.",
      "examples": [
        "2019-12-31"
      ],
      "format": "date",
      "type": "string"
    },
    "done_at": {
      "description": "When its keys went.",
      "examples": [
        "2027-01-03T17:50:00Z"
      ],
      "format": "date-time",
      "type": "string"
    },
    "id": {
      "description": "The run.",
      "examples": [
        "01928f6e-7a3b-7c41-9d2e-5f8a1b3c5e10"
      ],
      "format": "uuid",
      "type": "string"
    },
    "listed_at": {
      "description": "When the job listed it, the year's retention having ended.",
      "examples": [
        "2027-01-02T17:50:00Z"
      ],
      "format": "date-time",
      "type": "string"
    },
    "people": {
      "description": "How many people's keys of that year it shreds: one key per person.",
      "examples": [
        14
      ],
      "format": "int64",
      "type": "integer"
    },
    "reapplied": {
      "description": "true when a restore recreated it from the register.",
      "examples": [
        false
      ],
      "type": "boolean"
    },
    "register": {
      "description": "The signed register entry, written before the keys went.",
      "examples": [
        "pdpa-shredding/01928f6e-7a3b-7c41-9d2e-5f8a1b3c5e10/01928f6e-7a3b-7c41-9d2e-5f8a1b3c5e11.json"
      ],
      "type": "string"
    },
    "status": {
      "description": "listed: waiting for the DPO; approved: shredded on the next daily run, register first; done: the keys are gone.",
      "enum": [
        "listed",
        "approved",
        "done"
      ],
      "examples": [
        "listed"
      ],
      "type": "string"
    },
    "version": {
      "description": "Its version; the ETag carries it for If-Match.",
      "examples": [
        1
      ],
      "format": "int64",
      "type": "integer"
    }
  },
  "required": [
    "id",
    "cohort",
    "people",
    "listed_at",
    "status",
    "reapplied",
    "version"
  ],
  "title": "ShreddingRunView",
  "type": "object"
}
