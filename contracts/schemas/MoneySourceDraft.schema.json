{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "connector_id": {
      "description": "connector: the organisation connector that syncs it.",
      "examples": [
        "01928f6e-7a3b-7c41-9d2e-5f8a1b3c4b40"
      ],
      "format": "uuid",
      "type": "string"
    },
    "from_date": {
      "description": "The first day it is the source: after the current one's, so no day has two.",
      "examples": [
        "2026-11-01"
      ],
      "format": "date",
      "type": "string"
    },
    "kind": {
      "description": "file, email or connector.",
      "enum": [
        "file",
        "email",
        "connector"
      ],
      "examples": [
        "email"
      ],
      "type": "string"
    },
    "mapping_id": {
      "description": "CSV and XLSX: the saved column mapping.",
      "examples": [
        "01928f6e-7a3b-7c41-9d2e-5f8a1b3c4b30"
      ],
      "format": "uuid",
      "type": "string"
    },
    "report_format": {
      "description": "file and email: the statements' format.",
      "enum": [
        "csv",
        "xlsx",
        "ofx",
        "camt053",
        "mt940",
        "mt940_sap"
      ],
      "examples": [
        "csv"
      ],
      "type": "string"
    },
    "senders": {
      "description": "email: the bank's registered addresses (DMARC must pass for each, FR-INT-22).",
      "items": {
        "description": "An email address.",
        "examples": [
          "ideal@dbs.example"
        ],
        "format": "email",
        "type": "string"
      },
      "maxItems": 5,
      "type": [
        "array",
        "null"
      ]
    }
  },
  "required": [
    "kind",
    "from_date"
  ],
  "title": "MoneySourceDraft",
  "type": "object"
}
