{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "content_base64": {
      "description": "The PDF, in base64: archival (PDF/A-2a) and accessible (PDF/UA-1); masked for the DPO.",
      "examples": [
        "JVBERi0xLjc="
      ],
      "type": "string"
    },
    "file_name": {
      "description": "The file's name.",
      "examples": [
        "directors.approve_statements-2027-01-05.pdf"
      ],
      "type": "string"
    },
    "media_type": {
      "description": "Its type.",
      "examples": [
        "application/pdf"
      ],
      "type": "string"
    },
    "sha256": {
      "description": "The SHA-256 of the content, in hexadecimal; masked for the DPO.",
      "examples": [
        "9f86d081884c7d659a2feaa0c55ad015a3bf4f1b2b0b822cd15d6c15b0f00a08"
      ],
      "type": "string"
    },
    "size_bytes": {
      "description": "Its size, in bytes; 0 for the DPO.",
      "examples": [
        30877
      ],
      "format": "int64",
      "type": "integer"
    }
  },
  "required": [
    "file_name",
    "media_type",
    "sha256",
    "size_bytes",
    "content_base64"
  ],
  "title": "DocumentFile",
  "type": "object"
}
