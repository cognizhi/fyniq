{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "content_base64": {
      "description": "The file, in base64.",
      "examples": [
        "JVBERi0xLjcgQVUtMTAw"
      ],
      "type": "string"
    },
    "file_name": {
      "description": "As the uploader named it: data, never a path (FR-DOC-08). Save it under a name of your own choosing.",
      "examples": [
        "AU-100.pdf"
      ],
      "type": "string"
    },
    "id": {
      "description": "The file's ID.",
      "examples": [
        "01928f6e-7a3b-7c41-9d2e-5f8a1b3c4e20"
      ],
      "format": "uuid",
      "type": "string"
    },
    "media_type": {
      "description": "Its type, decided from its content when it was attached.",
      "examples": [
        "application/pdf"
      ],
      "type": "string"
    },
    "sha256": {
      "description": "The SHA-256 of the file as stored, in hexadecimal: the content was checked against it before it was sent.",
      "examples": [
        "9f86d081884c7d659a2feaa0c55ad015a3bf4f1b2b0b822cd15d6c15b0f00a08"
      ],
      "type": "string"
    },
    "size_bytes": {
      "description": "Its size in bytes.",
      "examples": [
        18432
      ],
      "format": "int64",
      "type": "integer"
    }
  },
  "required": [
    "id",
    "file_name",
    "media_type",
    "size_bytes",
    "sha256",
    "content_base64"
  ],
  "title": "EvidenceFileContent",
  "type": "object"
}
