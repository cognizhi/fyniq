{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "approval_asked": {
      "description": "The pending request to void it.",
      "examples": [
        "01928f6e-7a3b-7c41-9d2e-5f8a1b3c4dd1"
      ],
      "format": "uuid",
      "type": "string"
    },
    "batch_id": {
      "description": "The payment batch whose release paid it.",
      "examples": [
        "01928f6e-7a3b-7c41-9d2e-5f8a1b3c5c10"
      ],
      "format": "uuid",
      "type": "string"
    },
    "contact_id": {
      "description": "The director or shareholder repaid.",
      "examples": [
        "01928f6e-7a3b-7c41-9d2e-5f8a1b3c4c11"
      ],
      "format": "uuid",
      "type": "string"
    },
    "date": {
      "description": "The batch's payment date: the day it posted.",
      "examples": [
        "2026-11-30"
      ],
      "format": "date",
      "type": "string"
    },
    "id": {
      "description": "The repayment's ID.",
      "examples": [
        "01928f6e-7a3b-7c41-9d2e-5f8a1b3c5e10"
      ],
      "format": "uuid",
      "type": "string"
    },
    "ledger_impact": {
      "description": "The lines its entry wrote: debits positive.",
      "items": {
        "$ref": "EntryLine.schema.json"
      },
      "type": "array"
    },
    "legal_name": {
      "description": "Their name.",
      "examples": [
        "Mei Lin Tan"
      ],
      "type": "string"
    },
    "money_account_id": {
      "description": "The bank account it left.",
      "examples": [
        "01928f6e-7a3b-7c41-9d2e-5f8a1b3c4d10"
      ],
      "format": "uuid",
      "type": "string"
    },
    "number": {
      "description": "Its number from the repayment sequence (FR-ORG-04).",
      "examples": [
        "DR-0001"
      ],
      "type": "string"
    },
    "paid": {
      "description": "Bank import matched it to its statement line.",
      "examples": [
        false
      ],
      "type": "boolean"
    },
    "reference": {
      "description": "The batch's number, as the payment list carries it.",
      "examples": [
        "PB-0007"
      ],
      "type": "string"
    },
    "settlements": {
      "description": "What it repaid of each settlement.",
      "items": {
        "$ref": "DirectorRepaymentPart.schema.json"
      },
      "type": "array"
    },
    "status": {
      "description": "posted by the batch's release; reversed by a void, as when the bank rejected it.",
      "enum": [
        "posted",
        "reversed"
      ],
      "examples": [
        "posted"
      ],
      "type": "string"
    },
    "total": {
      "$ref": "Money.schema.json",
      "description": "What it repaid, in the base currency."
    },
    "version": {
      "description": "The version of its content; with the status it makes the ETag.",
      "examples": [
        1
      ],
      "format": "int64",
      "type": "integer"
    }
  },
  "required": [
    "id",
    "status",
    "version",
    "contact_id",
    "legal_name",
    "date",
    "money_account_id",
    "total",
    "settlements",
    "paid",
    "ledger_impact"
  ],
  "title": "DirectorRepayment",
  "type": "object"
}
