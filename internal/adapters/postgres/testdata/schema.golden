bank_match | bank_match_kind_refs | CHECK (
CASE kind
    WHEN 'categorised'::text THEN ((entry_id IS NOT NULL) AND (document_id IS NOT NULL) AND (transfer_id IS NULL))
    WHEN 'suspense'::text THEN ((entry_id IS NOT NULL) AND (document_id IS NOT NULL) AND (transfer_id IS NULL))
    WHEN 'receipt'::text THEN ((document_id IS NOT NULL) AND (transfer_id IS NULL))
    WHEN 'bill_payment'::text THEN ((document_id IS NOT NULL) AND (transfer_id IS NULL))
    WHEN 'recorded'::text THEN ((document_id IS NOT NULL) AND (entry_id IS NULL) AND (transfer_id IS NULL))
    ELSE ((transfer_id IS NOT NULL) AND (document_id IS NULL))
END)
