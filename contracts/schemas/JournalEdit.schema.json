{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "date": {
      "description": "The date of the new version; its period must be open, as must the period of the entry it replaces.",
      "examples": [
        "2026-10-31"
      ],
      "format": "date",
      "type": "string"
    },
    "lines": {
      "description": "Debits positive, credits negative.",
      "items": {
        "$ref": "JournalLineDraft.schema.json"
      },
      "maxItems": 1000,
      "type": [
        "array",
        "null"
      ]
    },
    "memo": {
      "description": "What the journal is for.",
      "examples": [
        "October rent accrual"
      ],
      "maxLength": 1000,
      "type": "string"
    },
    "reason": {
      "description": "Why it is edited: the audit trail and the reversal's memo keep it (FR-GL-12).",
      "examples": [
        "The rent is 1,250.00, not 1,200.00"
      ],
      "maxLength": 500,
      "minLength": 1,
      "type": "string"
    },
    "reverse_on": {
      "description": "The date the new version reverses by itself, if it does (FR-GL-02); after its date.",
      "examples": [
        "2026-11-01"
      ],
      "format": "date",
      "type": "string"
    }
  },
  "required": [
    "date",
    "lines",
    "reason"
  ],
  "title": "JournalEdit",
  "type": "object"
}
