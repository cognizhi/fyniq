{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "current": {
      "$ref": "Money.schema.json",
      "description": "The account's total for the period it explained."
    },
    "explanation": {
      "description": "Why the account moved.",
      "examples": [
        "The annual design-tool licence renewed in November."
      ],
      "type": "string"
    },
    "id": {
      "description": "The explanation's ID.",
      "examples": [
        "01928f6e-7a3b-7c41-9d2e-5f8a1b3c4de0"
      ],
      "format": "uuid",
      "type": "string"
    },
    "previous": {
      "$ref": "Money.schema.json",
      "description": "The account's total for the previous period it explained."
    },
    "written_at": {
      "description": "When.",
      "examples": [
        "2026-12-02T09:30:00Z"
      ],
      "format": "date-time",
      "type": "string"
    },
    "written_by": {
      "$ref": "Person.schema.json",
      "description": "Who wrote it."
    }
  },
  "required": [
    "id",
    "explanation",
    "current",
    "previous",
    "written_at"
  ],
  "title": "VarianceExplanation",
  "type": "object"
}
