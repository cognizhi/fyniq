{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "amount": {
      "$ref": "Money.schema.json",
      "description": "What was applied, in their currency."
    },
    "applied_at": {
      "description": "When it was applied.",
      "examples": [
        "2026-10-21T09:30:00Z"
      ],
      "format": "date-time",
      "type": "string"
    },
    "applied_by": {
      "$ref": "Person.schema.json",
      "description": "Who applied it."
    },
    "approval_asked": {
      "description": "The pending request to void it.",
      "examples": [
        "01928f6e-7a3b-7c41-9d2e-5f8a1b3c4dd3"
      ],
      "format": "uuid",
      "type": "string"
    },
    "credit": {
      "$ref": "CustomerAppliedDocument.schema.json",
      "description": "The credit applied."
    },
    "credit_cleared": {
      "$ref": "Money.schema.json",
      "description": "The credit's carrying amount it cleared, in the base currency."
    },
    "date": {
      "description": "The day it was applied.",
      "examples": [
        "2026-10-21"
      ],
      "format": "date",
      "type": "string"
    },
    "id": {
      "description": "The application's ID.",
      "examples": [
        "01928f6e-7a3b-7c41-9d2e-5f8a1b3c4f80"
      ],
      "format": "uuid",
      "type": "string"
    },
    "invoice": {
      "$ref": "CustomerAppliedDocument.schema.json",
      "description": "The invoice it settles."
    },
    "invoice_cleared": {
      "$ref": "Money.schema.json",
      "description": "The invoice's carrying amount it cleared, in the base currency."
    },
    "ledger_impact": {
      "description": "The lines its entry wrote; none when nothing posted.",
      "items": {
        "$ref": "EntryLine.schema.json"
      },
      "type": "array"
    },
    "realised_fx": {
      "$ref": "Money.schema.json",
      "description": "The realised gain (positive) or loss (negative): what the credit carried less what the invoice carried (ENG-41); zero when the two agree and nothing posted."
    },
    "status": {
      "description": "posted once applied; reversed by a void.",
      "enum": [
        "posted",
        "reversed"
      ],
      "examples": [
        "posted"
      ],
      "type": "string"
    },
    "version": {
      "description": "The version of its content; with the status it makes the ETag.",
      "examples": [
        1
      ],
      "format": "int64",
      "type": "integer"
    }
  },
  "required": [
    "id",
    "status",
    "version",
    "credit",
    "invoice",
    "date",
    "amount",
    "invoice_cleared",
    "credit_cleared",
    "realised_fx",
    "ledger_impact"
  ],
  "title": "CustomerCreditApplication",
  "type": "object"
}
