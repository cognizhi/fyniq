# syntax=docker/dockerfile:1.7
#
# TEMPLATE FOR P0: a reference for deploy/docker/Dockerfile.web. Not wired into any build yet.
# Used for local (`make up`) and preview environments only; production serves apps/web's
# static build from Cloud Storage behind Cloud CDN (PRD-001 §12.3, §12.9). Budget ≤ 25 MB.

# ---- build stage ------------------------------------------------------------------------
# Pin by digest in the real file.
FROM node:24-alpine AS build
WORKDIR /src
# pnpm from corepack, at the version pinned in package.json "packageManager".
RUN corepack enable
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY apps/web/package.json apps/web/
RUN --mount=type=cache,target=/root/.local/share/pnpm/store pnpm install --frozen-lockfile
COPY . .
ARG VERSION=0.0.0-dev
ARG GIT_SHA=unknown
# Vite reads VITE_* at build time (About dialog, REL-05).
ENV VITE_FYNIQ_VERSION=${VERSION} VITE_FYNIQ_COMMIT=${GIT_SHA}
RUN pnpm --filter web build

# ---- runtime stage ----------------------------------------------------------------------
# Runs as UID 101 on port 8080; no root needed. Pin by digest in the real file.
FROM nginxinc/nginx-unprivileged:alpine
COPY deploy/docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /src/apps/web/dist /usr/share/nginx/html
EXPOSE 8080

