{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "assessed_by": {
      "description": "Who assessed it.",
      "examples": [
        "Ann Lim, Data Protection Officer"
      ],
      "type": "string"
    },
    "assessed_on": {
      "description": "When it was assessed.",
      "examples": [
        "2026-11-09"
      ],
      "format": "date",
      "type": "string"
    },
    "basis": {
      "description": "What protects the data abroad.",
      "enum": [
        "contract",
        "binding_corporate_rules",
        "other_instrument",
        "certification",
        "consent"
      ],
      "examples": [
        "contract"
      ],
      "type": "string"
    },
    "countries": {
      "description": "Where the recipient processes it.",
      "examples": [
        "United States, India"
      ],
      "type": "string"
    },
    "data": {
      "description": "The personal data transferred.",
      "examples": [
        "Recipients' names and email addresses, and the messages"
      ],
      "type": "string"
    },
    "evidence": {
      "description": "Where the contract, rules or certificate are kept.",
      "examples": [
        "The provider's data processing addendum, in the shared drive"
      ],
      "type": "string"
    },
    "flow": {
      "description": "The catalogue flow it covers; absent for one of the company's own.",
      "examples": [
        "email"
      ],
      "type": "string"
    },
    "next_review_on": {
      "description": "When it is reviewed next.",
      "examples": [
        "2027-11-09"
      ],
      "format": "date",
      "type": "string"
    },
    "overdue": {
      "description": "true once the next review has passed, while open.",
      "examples": [
        false
      ],
      "type": "boolean"
    },
    "purpose": {
      "description": "Why.",
      "examples": [
        "To deliver the company's email"
      ],
      "type": "string"
    },
    "recipient": {
      "description": "Who receives the data.",
      "examples": [
        "Zoho Corporation (ZeptoMail)"
      ],
      "type": "string"
    },
    "review_due": {
      "description": "true from 30 days before the next review, while open.",
      "examples": [
        false
      ],
      "type": "boolean"
    },
    "saved_at": {
      "description": "When.",
      "examples": [
        "2026-11-09T02:00:00Z"
      ],
      "format": "date-time",
      "type": "string"
    },
    "saved_by": {
      "description": "Who saved this version, as records name actors.",
      "examples": [
        "user:01928f6e-7a3b-7c41-9d2e-5f8a1b3c5e10"
      ],
      "type": "string"
    },
    "state": {
      "description": "open while the transfer goes on; retired once it stops.",
      "enum": [
        "open",
        "retired"
      ],
      "examples": [
        "open"
      ],
      "type": "string"
    },
    "transfer_id": {
      "description": "The transfer.",
      "examples": [
        "01928f6e-7a3b-7c41-9d2e-5f8a1b3c5e10"
      ],
      "format": "uuid",
      "type": "string"
    },
    "version": {
      "description": "Its version; the ETag carries it for If-Match.",
      "examples": [
        1
      ],
      "format": "int64",
      "type": "integer"
    }
  },
  "required": [
    "transfer_id",
    "version",
    "recipient",
    "countries",
    "data",
    "purpose",
    "basis",
    "assessed_on",
    "assessed_by",
    "evidence",
    "next_review_on",
    "review_due",
    "overdue",
    "state",
    "saved_by",
    "saved_at"
  ],
  "title": "TransferView",
  "type": "object"
}
