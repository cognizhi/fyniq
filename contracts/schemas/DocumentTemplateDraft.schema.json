{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "content": {
      "$ref": "TemplateContent.schema.json",
      "description": "The draft's content. Left out, the template starts from the starter named, or the classic starter."
    },
    "document_type": {
      "description": "The document it serves.",
      "enum": [
        "invoice",
        "quote",
        "credit_note",
        "receipt",
        "statement",
        "reminder",
        "remittance",
        "purchase_order"
      ],
      "examples": [
        "invoice"
      ],
      "type": "string"
    },
    "kind": {
      "description": "document: the PDF; email: the message that carries it.",
      "enum": [
        "document",
        "email"
      ],
      "examples": [
        "document"
      ],
      "type": "string"
    },
    "name": {
      "description": "Its name.",
      "examples": [
        "Standard invoice"
      ],
      "maxLength": 100,
      "type": "string"
    },
    "starter": {
      "description": "The starter template to begin from (FR-TPL-07), when content is left out.",
      "enum": [
        "classic",
        "band",
        "minimal",
        "compact"
      ],
      "examples": [
        "band"
      ],
      "type": "string"
    }
  },
  "required": [
    "kind",
    "document_type",
    "name"
  ],
  "title": "DocumentTemplateDraft",
  "type": "object"
}
