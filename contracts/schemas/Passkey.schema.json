{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authenticator": {
      "description": "The authenticator's model (its AAGUID); all zeros when it names none.",
      "examples": [
        "ea9b8d66-4d01-1d21-3ce4-b6b48cb575d4"
      ],
      "format": "uuid",
      "type": "string"
    },
    "backed_up": {
      "description": "true when it was synced, as of its last use.",
      "examples": [
        true
      ],
      "type": "boolean"
    },
    "backup_eligible": {
      "description": "true for a passkey that syncs between your devices.",
      "examples": [
        true
      ],
      "type": "boolean"
    },
    "created_at": {
      "description": "When you registered it.",
      "examples": [
        "2026-10-20T09:00:00Z"
      ],
      "format": "date-time",
      "type": "string"
    },
    "id": {
      "description": "The passkey's ID.",
      "examples": [
        "01928f6e-7a3b-7c41-9d2e-5f8a1b3c4f40"
      ],
      "format": "uuid",
      "type": "string"
    },
    "last_used_at": {
      "description": "When you last confirmed it's you with it.",
      "examples": [
        "2026-10-20T09:30:00Z"
      ],
      "format": "date-time",
      "type": "string"
    },
    "name": {
      "description": "The name you gave it.",
      "examples": [
        "Work laptop"
      ],
      "type": "string"
    },
    "revoked_at": {
      "description": "When you revoked it; it works no more.",
      "examples": [
        "2026-10-21T09:00:00Z"
      ],
      "format": "date-time",
      "type": "string"
    },
    "transports": {
      "description": "How the browser reaches it, as it said.",
      "items": {
        "description": "How the browser reaches the authenticator: internal, hybrid, usb, nfc, ble or smart-card.",
        "examples": [
          "internal"
        ],
        "type": "string"
      },
      "type": [
        "array",
        "null"
      ]
    }
  },
  "required": [
    "id",
    "name",
    "authenticator",
    "transports",
    "backup_eligible",
    "backed_up",
    "created_at"
  ],
  "title": "Passkey",
  "type": "object"
}
