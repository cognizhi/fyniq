organisation | organisation_base_minor_units_not_null | NOT NULL base_minor_units
organisation | organisation_created_at_not_null | NOT NULL created_at
organisation | organisation_kind_known | CHECK ((kind = ANY (ARRAY['company'::text, 'installation'::text])))
organisation | organisation_kind_not_null | NOT NULL kind
organisation | organisation_name_length | CHECK (((length(btrim(name)) >= 1) AND (length(btrim(name)) <= 200)))
organisation | organisation_name_not_null | NOT NULL name
