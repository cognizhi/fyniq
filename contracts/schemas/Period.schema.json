{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "closed_revision": {
      "description": "The ledger revision at the close (ENG-46), while it is closed.",
      "examples": [
        412
      ],
      "format": "int64",
      "type": "integer"
    },
    "ends_on": {
      "description": "Its last day.",
      "examples": [
        "2026-10-31"
      ],
      "format": "date",
      "type": "string"
    },
    "financial_year": {
      "description": "Which financial year holds it, 1 for the first; left out when the books start is not set.",
      "examples": [
        1
      ],
      "format": "int64",
      "type": "integer"
    },
    "id": {
      "description": "The period's ID.",
      "examples": [
        "01928f6e-7a3b-7c41-9d2e-5f8a1b3c4d61"
      ],
      "type": "string"
    },
    "locked_modules": {
      "description": "The modules whose postings the period refuses apart from a pass (FR-GL-09): any of ar, ap, banking and payroll.",
      "examples": [
        [
          "ar"
        ]
      ],
      "items": {
        "type": "string"
      },
      "type": [
        "array",
        "null"
      ]
    },
    "starts_on": {
      "description": "Its first day.",
      "examples": [
        "2026-10-01"
      ],
      "format": "date",
      "type": "string"
    },
    "status": {
      "description": "open takes postings; soft_locked takes postings only from an Accountant who holds a pass for the period (FR-GL-09, enforced by the domain); closed is the hard lock of INV-03, which the database enforces.",
      "enum": [
        "open",
        "soft_locked",
        "closed"
      ],
      "examples": [
        "open"
      ],
      "type": "string"
    },
    "version": {
      "description": "The period's version.",
      "examples": [
        1
      ],
      "format": "int64",
      "type": "integer"
    }
  },
  "required": [
    "id",
    "starts_on",
    "ends_on",
    "status",
    "version"
  ],
  "title": "Period",
  "type": "object"
}
