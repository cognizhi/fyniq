{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "approval_id": {
      "description": "The approval it was released under.",
      "examples": [
        "01928f6e-7a3b-7c41-9d2e-5f8a1b3c5c20"
      ],
      "format": "uuid",
      "type": "string"
    },
    "file_name": {
      "description": "The file's name.",
      "examples": [
        "PB-0003-payment-list.csv"
      ],
      "type": "string"
    },
    "payment_ids": {
      "description": "The bill payments and reimbursements it posted, one per payee.",
      "examples": [
        [
          "01928f6e-7a3b-7c41-9d2e-5f8a1b3c5d10"
        ]
      ],
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "released_at": {
      "description": "When it was released.",
      "examples": [
        "2026-10-31T09:30:00+08:00"
      ],
      "format": "date-time",
      "type": "string"
    },
    "released_by": {
      "$ref": "Person.schema.json",
      "description": "Who released it."
    },
    "sha256": {
      "description": "The SHA-256 of the file as written, in hexadecimal: a downloaded copy can be checked against it.",
      "examples": [
        "9f86d081884c7d659a2feaa0c55ad015a3bf4f1b2b0b822cd15d6c15b0f00a08"
      ],
      "type": "string"
    },
    "writer": {
      "description": "The file's format and version: payment-list@1 is the payment list keyed into the bank (rev 0.156).",
      "examples": [
        "payment-list@1"
      ],
      "type": "string"
    }
  },
  "required": [
    "released_by",
    "released_at",
    "approval_id",
    "writer",
    "file_name",
    "sha256",
    "payment_ids"
  ],
  "title": "PaymentBatchRelease",
  "type": "object"
}
