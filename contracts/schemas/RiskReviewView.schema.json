{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "next_review_on": {
      "description": "The next review date it set.",
      "examples": [
        "2027-06-30"
      ],
      "format": "date",
      "type": "string"
    },
    "note": {
      "description": "What the reviewer noted.",
      "examples": [
        "Mitigations hold; no new exposure."
      ],
      "type": "string"
    },
    "reviewed_at": {
      "description": "When.",
      "examples": [
        "2027-03-30T09:12:00Z"
      ],
      "format": "date-time",
      "type": "string"
    },
    "reviewed_by": {
      "description": "Who reviewed it, as records name actors.",
      "examples": [
        "user:01928f6e-7a3b-7c41-9d2e-5f8a1b3c5e10"
      ],
      "type": "string"
    },
    "version": {
      "description": "The version reviewed.",
      "examples": [
        2
      ],
      "format": "int64",
      "type": "integer"
    }
  },
  "required": [
    "version",
    "reviewed_by",
    "reviewed_at",
    "next_review_on"
  ],
  "title": "RiskReviewView",
  "type": "object"
}
