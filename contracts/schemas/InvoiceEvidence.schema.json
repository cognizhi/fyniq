{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "data_class": {
      "description": "The personal data it holds (FR-DOC-09).",
      "enum": [
        "general",
        "personal",
        "bank",
        "payroll",
        "identity"
      ],
      "examples": [
        "general"
      ],
      "type": "string"
    },
    "evidence_type": {
      "description": "What the file is.",
      "examples": [
        "invoice"
      ],
      "type": "string"
    },
    "file_name": {
      "description": "The name it was uploaded with: data, never a path.",
      "examples": [
        "AU-1182.pdf"
      ],
      "type": "string"
    },
    "id": {
      "description": "The file's ID.",
      "examples": [
        "01928f6e-7a3b-7c41-9d2e-5f8a1b3c4e21"
      ],
      "format": "uuid",
      "type": "string"
    },
    "invoice_id": {
      "description": "The invoice it is attached to.",
      "examples": [
        "01928f6e-7a3b-7c41-9d2e-5f8a1b3c4e30"
      ],
      "format": "uuid",
      "type": "string"
    },
    "media_type": {
      "description": "Its type, decided from its content.",
      "examples": [
        "application/pdf"
      ],
      "type": "string"
    },
    "note": {
      "description": "A short note.",
      "examples": [
        "The customer's purchase order"
      ],
      "type": "string"
    },
    "original_sha256": {
      "description": "The SHA-256 of the file as received, in hexadecimal.",
      "examples": [
        "9f86d081884c7d659a2feaa0c55ad015a3bf4f1b2b0b822cd15d6c15b0f00a08"
      ],
      "type": "string"
    },
    "relates_on": {
      "description": "The date it relates to.",
      "examples": [
        "2026-10-14"
      ],
      "format": "date",
      "type": "string"
    },
    "retain_until": {
      "description": "Once final: kept, and never deletable, until then (FR-DOC-02).",
      "examples": [
        "2034-01-01T00:00:00+08:00"
      ],
      "format": "date-time",
      "type": "string"
    },
    "sha256": {
      "description": "The SHA-256 of the file as stored, in hexadecimal: image metadata such as location is stripped first.",
      "examples": [
        "9f86d081884c7d659a2feaa0c55ad015a3bf4f1b2b0b822cd15d6c15b0f00a08"
      ],
      "type": "string"
    },
    "size_bytes": {
      "description": "Its size as stored, in bytes.",
      "examples": [
        48213
      ],
      "format": "int64",
      "type": "integer"
    },
    "source": {
      "description": "How it arrived.",
      "enum": [
        "upload",
        "paste",
        "email",
        "api"
      ],
      "examples": [
        "upload"
      ],
      "type": "string"
    },
    "state": {
      "description": "Attached (in staging while the invoice is a draft), removed from a draft, or final: committed to the retention-locked store, append-only.",
      "enum": [
        "attached",
        "removed",
        "final"
      ],
      "examples": [
        "attached"
      ],
      "type": "string"
    },
    "uploaded_at": {
      "description": "When it was attached.",
      "examples": [
        "2026-10-14T09:15:00Z"
      ],
      "format": "date-time",
      "type": "string"
    },
    "uploaded_by": {
      "description": "Who uploaded it: an actor of the audit trail.",
      "examples": [
        "user:01928f6e-7a3b-7c41-9d2e-5f8a1b3c4d01"
      ],
      "type": "string"
    },
    "version": {
      "description": "The file's version; it makes the ETag.",
      "examples": [
        1
      ],
      "format": "int64",
      "type": "integer"
    }
  },
  "required": [
    "id",
    "invoice_id",
    "evidence_type",
    "file_name",
    "media_type",
    "size_bytes",
    "sha256",
    "original_sha256",
    "source",
    "data_class",
    "uploaded_by",
    "uploaded_at",
    "state",
    "version"
  ],
  "title": "InvoiceEvidence",
  "type": "object"
}
