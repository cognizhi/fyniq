{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "currency": {
      "description": "The base currency every amount is in.",
      "examples": [
        "SGD"
      ],
      "type": "string"
    },
    "customers": {
      "description": "Each customer with something billed, collected, recognised or moved in the run, side by side with its deferred revenue (rev 0.594).",
      "items": {
        "$ref": "RollForwardCustomer.schema.json"
      },
      "type": "array"
    },
    "from": {
      "description": "The run's first day.",
      "examples": [
        "2026-10-01"
      ],
      "format": "date",
      "type": "string"
    },
    "holdings": {
      "description": "1210 Prepayments and 2400 Deferred revenue, each that the chart has.",
      "items": {
        "$ref": "RollForwardHolding.schema.json"
      },
      "type": "array"
    },
    "to": {
      "description": "The run's last day.",
      "examples": [
        "2026-10-31"
      ],
      "format": "date",
      "type": "string"
    }
  },
  "required": [
    "currency",
    "from",
    "to",
    "holdings",
    "customers"
  ],
  "title": "RollForward",
  "type": "object"
}
