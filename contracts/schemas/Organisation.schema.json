{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "base_currency": {
      "description": "The currency the books are kept in.",
      "examples": [
        "SGD"
      ],
      "type": "string"
    },
    "base_minor_units": {
      "description": "How many decimals the base currency has.",
      "examples": [
        2
      ],
      "format": "int64",
      "type": "integer"
    },
    "id": {
      "description": "The organisation's ID.",
      "examples": [
        "01928f6e-7a3b-7c41-9d2e-5f8a1b3c4d5e"
      ],
      "format": "uuid",
      "type": "string"
    },
    "name": {
      "description": "Its name.",
      "examples": [
        "Northwind Analytics Pte. Ltd."
      ],
      "type": "string"
    },
    "team_mode": {
      "description": "The team mode (PRD-001 §6.4): Founder mode until a switch is approved (rev 0.42).",
      "enum": [
        "founder",
        "standard",
        "enterprise"
      ],
      "examples": [
        "founder"
      ],
      "type": "string"
    },
    "version": {
      "description": "The record's version; it also makes the ETag.",
      "examples": [
        1
      ],
      "format": "int64",
      "type": "integer"
    }
  },
  "required": [
    "id",
    "name",
    "base_currency",
    "base_minor_units",
    "team_mode",
    "version"
  ],
  "title": "Organisation",
  "type": "object"
}
