{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "client_id": {
      "description": "Its client ID at Fyniq's OAuth server.",
      "examples": [
        "mcp-0123456789abcdef0123"
      ],
      "type": "string"
    },
    "inventory_entry": {
      "description": "The data inventory entry made with the registration.",
      "examples": [
        "0193a3c2-6d0e-7a1b-9c4d-5e6f7a8b9c31"
      ],
      "format": "uuid",
      "type": "string"
    },
    "name": {
      "examples": [
        "Acme Books Assistant"
      ],
      "type": "string"
    },
    "outside_singapore": {
      "examples": [
        true
      ],
      "type": "boolean"
    },
    "processing_location": {
      "examples": [
        "United States"
      ],
      "type": "string"
    },
    "publisher": {
      "description": "As the Administrator stated it: Fyniq has not verified it.",
      "examples": [
        "Acme Software Pte Ltd"
      ],
      "type": "string"
    },
    "publisher_url": {
      "examples": [
        "https://acme.example"
      ],
      "type": "string"
    },
    "purpose": {
      "examples": [
        "Ask questions about the management accounts"
      ],
      "type": "string"
    },
    "redirect_uris": {
      "items": {
        "description": "An exact https or loopback redirect URI.",
        "examples": [
          "https://acme.example/oauth/callback"
        ],
        "type": "string"
      },
      "maxItems": 5,
      "type": "array"
    },
    "registered_at": {
      "examples": [
        "2026-11-21T09:30:00Z"
      ],
      "format": "date-time",
      "type": "string"
    },
    "registered_by": {
      "description": "The Administrator who registered it.",
      "examples": [
        "0193a3c2-6d0e-7a1b-9c4d-5e6f7a8b9c0e"
      ],
      "format": "uuid",
      "type": "string"
    },
    "removed_at": {
      "examples": [
        "2026-12-01T09:30:00Z"
      ],
      "format": "date-time",
      "type": "string"
    },
    "status": {
      "description": "pending until an Owner adds it to the apps that may connect; removed once an Administrator took it away.",
      "enum": [
        "pending",
        "approved",
        "denied",
        "expired",
        "removed"
      ],
      "examples": [
        "pending"
      ],
      "type": "string"
    }
  },
  "required": [
    "client_id",
    "name",
    "publisher",
    "redirect_uris",
    "purpose",
    "processing_location",
    "outside_singapore",
    "inventory_entry",
    "status",
    "registered_by",
    "registered_at"
  ],
  "title": "ThirdPartyApp",
  "type": "object"
}
