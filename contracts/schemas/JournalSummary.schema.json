{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "date": {
      "description": "The date it belongs to.",
      "examples": [
        "2026-10-31"
      ],
      "format": "date",
      "type": "string"
    },
    "debits": {
      "description": "The total of its debit lines, per currency, as entered.",
      "items": {
        "$ref": "Money.schema.json"
      },
      "type": "array"
    },
    "id": {
      "description": "The journal's ID.",
      "examples": [
        "01928f6e-7a3b-7c41-9d2e-5f8a1b3c4d70"
      ],
      "format": "uuid",
      "type": "string"
    },
    "lines": {
      "description": "How many lines it has.",
      "examples": [
        2
      ],
      "format": "int64",
      "type": "integer"
    },
    "memo": {
      "description": "What it is for.",
      "examples": [
        "October rent accrual"
      ],
      "type": "string"
    },
    "number": {
      "description": "Its number, once it has one.",
      "examples": [
        "JNL-0042"
      ],
      "type": "string"
    },
    "posted_at": {
      "description": "When it was posted.",
      "examples": [
        "2026-10-31T09:30:00Z"
      ],
      "format": "date-time",
      "type": "string"
    },
    "posted_by": {
      "$ref": "Person.schema.json",
      "description": "Who posted it."
    },
    "prepared_by": {
      "$ref": "Person.schema.json",
      "description": "Who saved the current version."
    },
    "status": {
      "description": "Draft (✎), posted, or reversed.",
      "enum": [
        "draft",
        "posted",
        "reversed"
      ],
      "examples": [
        "posted"
      ],
      "type": "string"
    },
    "version": {
      "description": "The version of its content.",
      "examples": [
        2
      ],
      "format": "int64",
      "type": "integer"
    }
  },
  "required": [
    "id",
    "status",
    "version",
    "lines",
    "debits"
  ],
  "title": "JournalSummary",
  "type": "object"
}
