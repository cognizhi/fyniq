{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "checks": {
      "description": "A draft's status: ✖ while no evidence is attached.",
      "items": {
        "$ref": "BillCheck.schema.json"
      },
      "type": "array"
    },
    "evidence": {
      "description": "How many files are attached and not removed: recording needs one, such as the ACRA business profile.",
      "examples": [
        1
      ],
      "format": "int64",
      "type": "integer"
    },
    "exempt": {
      "description": "An exempt private company from that day.",
      "examples": [
        true
      ],
      "type": "boolean"
    },
    "from": {
      "description": "The day it applies from.",
      "examples": [
        "2025-03-14"
      ],
      "format": "date",
      "type": "string"
    },
    "id": {
      "description": "Its ID.",
      "examples": [
        "01928f6e-7a3b-7c41-9d2e-5f8a1b3c4fe1"
      ],
      "format": "uuid",
      "type": "string"
    },
    "note": {
      "description": "Its note.",
      "examples": [
        "ACRA business profile of 14 Mar 2025"
      ],
      "type": "string"
    },
    "recorded_at": {
      "description": "When it was recorded.",
      "examples": [
        "2025-03-15T09:30:00Z"
      ],
      "format": "date-time",
      "type": "string"
    },
    "recorded_by": {
      "$ref": "Person.schema.json",
      "description": "Who recorded it."
    },
    "status": {
      "description": "draft: waiting for its evidence to be attached and recorded; recorded: in force from its day until a later one.",
      "enum": [
        "draft",
        "recorded"
      ],
      "examples": [
        "recorded"
      ],
      "type": "string"
    },
    "version": {
      "description": "The version of its content; with its status it makes the ETag.",
      "examples": [
        1
      ],
      "format": "int64",
      "type": "integer"
    }
  },
  "required": [
    "id",
    "status",
    "version",
    "from",
    "exempt",
    "evidence",
    "checks"
  ],
  "title": "ExemptStatusRecord",
  "type": "object"
}
