{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "book_balance": {
      "$ref": "Money.schema.json",
      "description": "The account's balance in the books at the period's end, in its currency."
    },
    "difference": {
      "$ref": "Money.schema.json",
      "description": "What they leave unexplained: statement − book − unreconciled. Zero when it matches."
    },
    "id": {
      "description": "The reconciliation's ID.",
      "examples": [
        "01928f6e-7a3b-7c41-9d2e-5f8a1b3c4c10"
      ],
      "format": "uuid",
      "type": "string"
    },
    "ledger_revision": {
      "description": "The ledger revision it saw (ENG-46): a later posting to the account in the period means preparing it again.",
      "examples": [
        42
      ],
      "format": "int64",
      "type": "integer"
    },
    "money_account_id": {
      "description": "The money account.",
      "examples": [
        "01928f6e-7a3b-7c41-9d2e-5f8a1b3c4b10"
      ],
      "format": "uuid",
      "type": "string"
    },
    "period_id": {
      "description": "The period.",
      "examples": [
        "01928f6e-7a3b-7c41-9d2e-5f8a1b3c4a50"
      ],
      "format": "uuid",
      "type": "string"
    },
    "prepared_at": {
      "description": "When.",
      "examples": [
        "2026-11-03T09:00:00Z"
      ],
      "format": "date-time",
      "type": "string"
    },
    "prepared_by": {
      "description": "Who prepared it.",
      "examples": [
        "user:01928f6e-7a3b-7c41-9d2e-5f8a1b3c4a01"
      ],
      "type": "string"
    },
    "signed_at": {
      "description": "When.",
      "examples": [
        "2026-11-04T09:00:00Z"
      ],
      "format": "date-time",
      "type": "string"
    },
    "signed_by": {
      "description": "Who signed it off: never its preparer.",
      "examples": [
        "user:01928f6e-7a3b-7c41-9d2e-5f8a1b3c4a02"
      ],
      "type": "string"
    },
    "statement_balance": {
      "$ref": "Money.schema.json",
      "description": "The statement's balance at the period's end."
    },
    "statement_date": {
      "description": "On preparing: the day the statement balance is of.",
      "examples": [
        "2026-10-31"
      ],
      "format": "date",
      "type": "string"
    },
    "unreconciled": {
      "$ref": "Money.schema.json",
      "description": "The lines booked by then that the books do not hold yet: unreconciled or possible duplicates."
    },
    "unreconciled_count": {
      "description": "How many.",
      "examples": [
        3
      ],
      "format": "int64",
      "type": "integer"
    },
    "unreconciled_lines": {
      "description": "On preparing and reading one: the lines it counts as unreconciled, earliest first.",
      "items": {
        "$ref": "BankLine.schema.json"
      },
      "type": "array"
    },
    "version": {
      "description": "Its version, as its ETag.",
      "examples": [
        1
      ],
      "format": "int64",
      "type": "integer"
    }
  },
  "required": [
    "id",
    "money_account_id",
    "period_id",
    "statement_balance",
    "book_balance",
    "unreconciled",
    "unreconciled_count",
    "difference",
    "ledger_revision",
    "prepared_by",
    "prepared_at",
    "version",
    "unreconciled_lines"
  ],
  "title": "BankReconciliation",
  "type": "object"
}
