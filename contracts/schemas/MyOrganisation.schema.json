{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "current": {
      "description": "true for the one this session is in.",
      "examples": [
        true
      ],
      "type": "boolean"
    },
    "id": {
      "description": "The organisation's ID.",
      "examples": [
        "01928f6e-7a3b-7c41-9d2e-5f8a1b3c5b01"
      ],
      "format": "uuid",
      "type": "string"
    },
    "name": {
      "description": "Its name.",
      "examples": [
        "Northwind Analytics Pte. Ltd."
      ],
      "type": "string"
    },
    "practice": {
      "description": "true for a practice organisation (FR-UX-36).",
      "examples": [
        false
      ],
      "type": "boolean"
    },
    "sandbox": {
      "description": "true for a sandbox organisation, made for integration testing with the sample company (FR-INT-18).",
      "examples": [
        false
      ],
      "type": "boolean"
    }
  },
  "required": [
    "id",
    "name",
    "practice",
    "sandbox",
    "current"
  ],
  "title": "MyOrganisation",
  "type": "object"
}
