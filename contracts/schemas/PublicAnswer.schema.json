{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "date": {
      "description": "The day.",
      "examples": [
        "2026-10-30"
      ],
      "format": "date",
      "type": "string"
    },
    "name": {
      "description": "Who accepted it.",
      "examples": [
        "Jane Tan"
      ],
      "type": "string"
    },
    "outcome": {
      "description": "What happened.",
      "enum": [
        "accepted",
        "declined",
        "expired"
      ],
      "examples": [
        "accepted"
      ],
      "type": "string"
    }
  },
  "required": [
    "outcome",
    "date"
  ],
  "title": "PublicAnswer",
  "type": "object"
}
