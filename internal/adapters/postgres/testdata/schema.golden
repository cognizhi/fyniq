super_admin | super_admin_user_id_not_null | NOT NULL user_id
super_admin_grant | require_audit | TRIGGER DEFERRABLE INITIALLY DEFERRED
super_admin_grant | super_admin_grant_code_hash_not_null | NOT NULL code_hash
super_admin_grant | super_admin_grant_code_sha256 | CHECK ((length(code_hash) = 32))
super_admin_grant | super_admin_grant_created_at_not_null | NOT NULL created_at
super_admin_grant | super_admin_grant_created_by_fkey | FOREIGN KEY (created_by) REFERENCES super_admin(user_id)
super_admin_grant | super_admin_grant_kind_known | CHECK ((kind = ANY (ARRAY['invitation'::text, 'recovery'::text, 'recovery_confirmation'::text, 'deployment_recovery'::text])))
super_admin_grant | super_admin_grant_kind_not_null | NOT NULL kind
super_admin_grant | super_admin_grant_pkey | PRIMARY KEY (code_hash)
super_admin_grant | super_admin_grant_shape | CHECK ((((kind = 'invitation'::text) AND (created_by IS NOT NULL) AND (user_id IS NULL) AND (issued_by IS NULL) AND (expires_at IS NOT NULL)) OR ((kind = 'recovery'::text) AND (user_id IS NOT NULL) AND (created_by IS NULL) AND (issued_by IS NULL) AND (expires_at IS NULL)) OR ((kind = 'recovery_confirmation'::text) AND (user_id IS NOT NULL) AND (created_by IS NOT NULL) AND (created_by <> user_id) AND (issued_by IS NULL) AND (expires_at IS NOT NULL)) OR ((kind = 'deployment_recovery'::text) AND (user_id IS NOT NULL) AND (created_by IS NULL) AND ((length(issued_by) >= 3) AND (length(issued_by) <= 200)) AND (expires_at IS NOT NULL))))
super_admin_grant | super_admin_grant_used_by_fkey | FOREIGN KEY (used_by) REFERENCES app_user(user_id)
super_admin_grant | super_admin_grant_used_whole | CHECK (((used_at IS NULL) = (used_by IS NULL)))
super_admin_grant | super_admin_grant_user_fkey | FOREIGN KEY (user_id) REFERENCES super_admin(user_id)
