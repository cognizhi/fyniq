{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "description": {
      "description": "What it is.",
      "examples": [
        "The Mail Agent's send token."
      ],
      "type": "string"
    },
    "name": {
      "description": "The secret's name in the manifest.",
      "examples": [
        "send_token"
      ],
      "type": "string"
    },
    "rotation_overlap_hours": {
      "description": "How long a replaced value stays valid, so work in flight and webhooks still pass (FR-INT-26).",
      "examples": [
        24
      ],
      "format": "int64",
      "type": "integer"
    },
    "title": {
      "description": "What it is called.",
      "examples": [
        "Send token"
      ],
      "type": "string"
    }
  },
  "required": [
    "name",
    "title",
    "description",
    "rotation_overlap_hours"
  ],
  "title": "ConnectorSecretInfo",
  "type": "object"
}
