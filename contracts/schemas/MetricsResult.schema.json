{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "currency": {
      "examples": [
        "SGD"
      ],
      "type": "string"
    },
    "facts": {
      "items": {
        "$ref": "MetricFact.schema.json"
      },
      "type": "array"
    },
    "ledger_revision": {
      "description": "The ledger revision every figure is read as at (FR-RPT-08).",
      "examples": [
        1204
      ],
      "format": "int64",
      "type": "integer"
    }
  },
  "required": [
    "facts",
    "currency",
    "ledger_revision"
  ],
  "title": "MetricsResult",
  "type": "object"
}
