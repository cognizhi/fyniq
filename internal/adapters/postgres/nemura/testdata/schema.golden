## triggers
CREATE TRIGGER access_request_guard BEFORE DELETE OR UPDATE ON nemura.access_request FOR EACH ROW EXECUTE FUNCTION nemura.access_request_guard()
CREATE CONSTRAINT TRIGGER require_audit AFTER INSERT OR UPDATE ON nemura.access_request DEFERRABLE INITIALLY DEFERRED FOR EACH ROW EXECUTE FUNCTION nemura.require_audit('access_request', 'id')
CREATE TRIGGER access_request_item_guard BEFORE INSERT OR DELETE OR UPDATE ON nemura.access_request_item FOR EACH ROW EXECUTE FUNCTION nemura.access_request_item_guard()
CREATE TRIGGER ai_draft_append_only BEFORE DELETE OR UPDATE ON nemura.ai_draft FOR EACH ROW EXECUTE FUNCTION nemura.append_only_guard('A draft')
CREATE CONSTRAINT TRIGGER require_audit AFTER INSERT ON nemura.ai_draft DEFERRABLE INITIALLY DEFERRED FOR EACH ROW EXECUTE FUNCTION nemura.require_audit('ai_draft', 'id')
CREATE TRIGGER ai_proposal_guard BEFORE INSERT OR DELETE OR UPDATE ON nemura.ai_proposal FOR EACH ROW EXECUTE FUNCTION nemura.ai_proposal_guard()
CREATE CONSTRAINT TRIGGER require_audit AFTER INSERT OR UPDATE ON nemura.ai_proposal DEFERRABLE INITIALLY DEFERRED FOR EACH ROW EXECUTE FUNCTION nemura.require_audit('ai_proposal', 'id')
CREATE CONSTRAINT TRIGGER require_audit AFTER INSERT OR UPDATE ON nemura.ai_settings DEFERRABLE INITIALLY DEFERRED FOR EACH ROW EXECUTE FUNCTION nemura.require_audit('ai_settings', 'organisation_id')
CREATE TRIGGER api_client_guard BEFORE DELETE OR UPDATE ON nemura.api_client FOR EACH ROW EXECUTE FUNCTION nemura.api_client_guard()
CREATE CONSTRAINT TRIGGER require_audit AFTER INSERT OR UPDATE ON nemura.api_client DEFERRABLE INITIALLY DEFERRED FOR EACH ROW EXECUTE FUNCTION nemura.require_audit('api_client', 'id')
CREATE TRIGGER api_client_request_guard BEFORE DELETE OR UPDATE ON nemura.api_client_request FOR EACH ROW EXECUTE FUNCTION nemura.link_append_only()
CREATE CONSTRAINT TRIGGER require_audit AFTER INSERT ON nemura.api_client_request DEFERRABLE INITIALLY DEFERRED FOR EACH ROW EXECUTE FUNCTION nemura.require_audit('api_client_request', 'id')
CREATE TRIGGER approval_request_guard BEFORE DELETE OR UPDATE ON nemura.approval_request FOR EACH ROW EXECUTE FUNCTION nemura.approval_request_guard()
