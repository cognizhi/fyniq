{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "action": {
      "description": "What happened.",
      "examples": [
        "document.posted"
      ],
      "type": "string"
    },
    "actor": {
      "$ref": "AuditActor.schema.json",
      "description": "Who acted."
    },
    "fields": {
      "description": "The fields it changed; getAuditEvent gives their before and after.",
      "items": {
        "description": "A field of the record the event changed.",
        "examples": [
          "status"
        ],
        "type": "string"
      },
      "type": "array"
    },
    "id": {
      "description": "The event.",
      "examples": [
        "01928f6e-7a3b-7c41-9d2e-5f8a1b3c4f01"
      ],
      "format": "uuid",
      "type": "string"
    },
    "occurred_at": {
      "description": "When it happened.",
      "examples": [
        "2026-10-31T09:00:00Z"
      ],
      "format": "date-time",
      "type": "string"
    },
    "on_behalf_of": {
      "$ref": "AuditActor.schema.json",
      "description": "The person an AI or a service acted for."
    },
    "originator": {
      "description": "The AI proposal the change carried out.",
      "examples": [
        "01928f6e-7a3b-7c41-9d2e-5f8a1b3c4e55"
      ],
      "type": "string"
    },
    "reason": {
      "description": "The reason given.",
      "examples": [
        "A supplier's October invoice arrived late"
      ],
      "type": "string"
    },
    "record": {
      "$ref": "AuditRecord.schema.json",
      "description": "What it is about."
    },
    "seq": {
      "description": "Its place in the organisation's hash chain.",
      "examples": [
        342
      ],
      "format": "int64",
      "type": "integer"
    }
  },
  "required": [
    "id",
    "seq",
    "occurred_at",
    "actor",
    "action",
    "record",
    "fields"
  ],
  "title": "AuditEventSummary",
  "type": "object"
}
