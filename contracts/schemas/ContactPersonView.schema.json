  "additionalProperties": false,
  "properties": {
    "email": {
      "examples": [
        "jane@example.com"
      ],
      "maxLength": 254,
      "type": "string"
    },
    "name": {
      "examples": [
        "Jane Lim"
      ],
      "maxLength": 100,
