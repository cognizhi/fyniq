{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "conflict": {
      "description": "The conflict, as the team mode lists it.",
      "examples": [
        "SOD-6"
      ],
      "pattern": "^SOD-([1-9]|10)$",
      "type": "string"
    },
    "member_id": {
      "description": "The member's membership.",
      "examples": [
        "01928f6e-7a3b-7c41-9d2e-5f8a1b3c4f01"
      ],
      "format": "uuid",
      "type": "string"
    },
    "reason": {
      "description": "Why they keep both sides of it.",
      "examples": [
        "Founder who also keeps the books until we hire"
      ],
      "maxLength": 500,
      "type": "string"
    }
  },
  "required": [
    "member_id",
    "conflict",
    "reason"
  ],
  "title": "TeamModeOverride",
  "type": "object"
}
