webhook_endpoint | webhook_endpoint_events | CHECK ((((cardinality(event_types) >= 1) AND (cardinality(event_types) <= 50)) AND (array_position(event_types, NULL::text) IS NULL)))
webhook_endpoint | webhook_endpoint_failure_run_not_null | NOT NULL failure_run
webhook_endpoint | webhook_endpoint_failures | CHECK ((failure_run >= 0))
webhook_endpoint | webhook_endpoint_hint | CHECK ((length(secret_hint) = 4))
webhook_endpoint | webhook_endpoint_id_not_null | NOT NULL id
webhook_endpoint | webhook_endpoint_label_length | CHECK (((length(label) >= 1) AND (length(label) <= 100)))
webhook_endpoint | webhook_endpoint_label_not_null | NOT NULL label
webhook_endpoint | webhook_endpoint_organisation_id_not_null | NOT NULL organisation_id
webhook_endpoint | webhook_endpoint_paused_reason | CHECK (((paused_reason IS NULL) OR ((length(paused_reason) >= 1) AND (length(paused_reason) <= 500))))
webhook_endpoint | webhook_endpoint_pkey | PRIMARY KEY (organisation_id, id)
webhook_endpoint | webhook_endpoint_roll_form | CHECK (((previous_secret_sealed IS NULL) = (previous_secret_until IS NULL)))
webhook_endpoint | webhook_endpoint_secret_hint_not_null | NOT NULL secret_hint
webhook_endpoint | webhook_endpoint_secret_sealed_not_null | NOT NULL secret_sealed
webhook_endpoint | webhook_endpoint_state_known | CHECK ((state = ANY (ARRAY['pending'::text, 'active'::text, 'paused'::text, 'disabled'::text])))
webhook_endpoint | webhook_endpoint_state_not_null | NOT NULL state
webhook_endpoint | webhook_endpoint_updated_at_not_null | NOT NULL updated_at
webhook_endpoint | webhook_endpoint_url_form | CHECK (((url ~ '^https?://[^[:space:]]+$'::text) AND (length(url) <= 2048)))
webhook_endpoint | webhook_endpoint_url_not_null | NOT NULL url
webhook_endpoint | webhook_endpoint_version_not_null | NOT NULL version
webhook_endpoint | webhook_endpoint_version_positive | CHECK ((version >= 1))
withholding_decision | require_audit | TRIGGER DEFERRABLE INITIALLY DEFERRED
withholding_decision | withholding_decision_bill_fkey | FOREIGN KEY (organisation_id, bill_id) REFERENCES document(organisation_id, id)
withholding_decision | withholding_decision_id_not_null | NOT NULL id
withholding_decision | withholding_decision_nature_known | CHECK ((nature = ANY (ARRAY['goods'::text, 'software_use'::text, 'software_rights'::text, 'services_in_singapore'::text, 'services_outside_singapore'::text, 'interest'::text, 'movable_rent'::text, 'other'::text])))
withholding_decision | withholding_decision_nature_not_null | NOT NULL nature
withholding_decision | withholding_decision_note_length | CHECK (((length(note) >= 1) AND (length(note) <= 2000)))
withholding_decision | withholding_decision_organisation_id_not_null | NOT NULL organisation_id
withholding_decision | withholding_decision_outcome_known | CHECK ((outcome = ANY (ARRAY['not_applicable'::text, 'withhold'::text, 'treaty'::text])))
withholding_decision | withholding_decision_outcome_not_null | NOT NULL outcome
withholding_decision | withholding_decision_pkey | PRIMARY KEY (organisation_id, id)
withholding_decision | withholding_decision_rate_range | CHECK (((rate_percent <> 'NaN'::numeric) AND (rate_percent > (0)::numeric) AND (rate_percent <= (100)::numeric) AND (rate_percent = trunc(rate_percent, 2))))
withholding_decision | withholding_decision_rate_with_outcome | CHECK (((outcome = 'not_applicable'::text) = (rate_percent IS NULL)))
withholding_decision | withholding_decision_recorded_at_not_null | NOT NULL recorded_at
withholding_decision | withholding_decision_recorded_by_format | CHECK ((recorded_by ~ '^[a-z][a-z_]{0,19}:[!-~]{1,200}$'::text))
withholding_decision | withholding_decision_recorded_by_not_null | NOT NULL recorded_by
withholding_decision | withholding_decision_supplier_fkey | FOREIGN KEY (organisation_id, supplier_id) REFERENCES contact(organisation_id, id)
withholding_decision | withholding_decision_supplier_id_not_null | NOT NULL supplier_id
withholding_decision | withholding_decision_tax_agent_length | CHECK (((length(btrim(tax_agent)) >= 1) AND (length(btrim(tax_agent)) <= 200)))
withholding_decision | withholding_decision_tax_agent_not_null | NOT NULL tax_agent

