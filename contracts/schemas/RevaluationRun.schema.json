{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "current": {
      "description": "No posting dated in or before the period came after it.",
      "examples": [
        true
      ],
      "type": "boolean"
    },
    "document_id": {
      "description": "The revaluation document.",
      "examples": [
        "01928f6e-7a3b-7c41-9d2e-5f8a1b3c4e20"
      ],
      "format": "uuid",
      "type": "string"
    },
    "entry_id": {
      "description": "Its entry, dated the period's last day; absent when nothing changed.",
      "examples": [
        "01928f6e-7a3b-7c41-9d2e-5f8a1b3c4e21"
      ],
      "format": "uuid",
      "type": "string"
    },
    "posted_at": {
      "description": "When.",
      "examples": [
        "2026-11-01T02:00:00Z"
      ],
      "format": "date-time",
      "type": "string"
    },
    "posted_by": {
      "$ref": "Person.schema.json",
      "description": "Who ran it."
    },
    "reversal_id": {
      "description": "The entry's reversal on the next period's first day; absent while it waits for that period to open.",
      "examples": [
        "01928f6e-7a3b-7c41-9d2e-5f8a1b3c4e22"
      ],
      "format": "uuid",
      "type": "string"
    },
    "revision": {
      "description": "The ledger revision it read (ENG-46).",
      "examples": [
        318
      ],
      "format": "int64",
      "type": "integer"
    }
  },
  "required": [
    "document_id",
    "revision",
    "current"
  ],
  "title": "RevaluationRun",
  "type": "object"
}
