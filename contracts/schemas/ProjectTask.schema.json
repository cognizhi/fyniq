{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "active": {
      "description": "false once put out of use: kept, as time names it.",
      "examples": [
        true
      ],
      "type": "boolean"
    },
    "billable": {
      "description": "Whether time on it is billable unless an entry says otherwise.",
      "examples": [
        true
      ],
      "type": "boolean"
    },
    "id": {
      "description": "The task's ID.",
      "examples": [
        "01928f6e-7a3b-7c41-9d2e-5f8a1b3c4e51"
      ],
      "format": "uuid",
      "type": "string"
    },
    "name": {
      "description": "Its name, unique among the project's live tasks.",
      "examples": [
        "Data migration"
      ],
      "type": "string"
    },
    "project_id": {
      "description": "The project it belongs to.",
      "examples": [
        "01928f6e-7a3b-7c41-9d2e-5f8a1b3c4e31"
      ],
      "format": "uuid",
      "type": "string"
    },
    "version": {
      "description": "Its version, for If-Match.",
      "examples": [
        1
      ],
      "format": "int64",
      "type": "integer"
    }
  },
  "required": [
    "id",
    "project_id",
    "name",
    "billable",
    "active",
    "version"
  ],
  "title": "ProjectTask",
  "type": "object"
}
