outbox | worker_class | text | true | 
outbox | kind | text | true | 
outbox | payload | jsonb | true | '{}'::jsonb
outbox | business_key | text | false | 
outbox | state | text | true | 'pending'::text
outbox | attempts | integer | true | 0
outbox | max_attempts | integer | true | 5
outbox | dispatches | integer | true | 0
outbox | task_name | text | false | 
outbox | lease_holder | text | false | 
outbox | lease_expires_at | timestamp with time zone | false | 
outbox | deadline_at | timestamp with time zone | false | 
outbox | last_error | text | false | 
outbox | created_at | timestamp with time zone | true | now()
outbox | updated_at | timestamp with time zone | true | now()
tenant_directory | organisation_id | uuid | true | 
tenant_directory | created_at | timestamp with time zone | true | now()

## constraints (table | name | definition)
audit_chain | audit_chain_hash_sha256 | CHECK ((length(head_hash) = 32))
audit_chain | audit_chain_head_hash_not_null | NOT NULL head_hash
audit_chain | audit_chain_organisation_fkey | FOREIGN KEY (organisation_id) REFERENCES nemura.organisation(organisation_id)
audit_chain | audit_chain_organisation_id_not_null | NOT NULL organisation_id
audit_chain | audit_chain_pkey | PRIMARY KEY (organisation_id)
audit_chain | audit_chain_seq_not_negative | CHECK ((seq >= 0))
audit_chain | audit_chain_seq_not_null | NOT NULL seq
audit_event | audit_event_body_fields | CHECK (((body)::jsonb ?& ARRAY['schema'::text, 'event_id'::text, 'organisation_id'::text, 'occurred_at'::text, 'actor'::text, 'action'::text, 'object'::text]))
audit_event | audit_event_body_ids | CHECK ((((((body)::jsonb ->> 'event_id'::text))::uuid = id) AND ((((body)::jsonb ->> 'organisation_id'::text))::uuid = organisation_id)))
audit_event | audit_event_body_not_null | NOT NULL body
audit_event | audit_event_body_object | CHECK ((jsonb_typeof((body)::jsonb) = 'object'::text))
audit_event | audit_event_body_size | CHECK ((octet_length(body) <= 2097152))
audit_event | audit_event_created_xact_not_null | NOT NULL created_xact
audit_event | audit_event_hash_not_null | NOT NULL hash
audit_event | audit_event_hashes_sha256 | CHECK (((length(prev_hash) = 32) AND (length(hash) = 32)))
audit_event | audit_event_id_not_null | NOT NULL id
audit_event | audit_event_organisation_fkey | FOREIGN KEY (organisation_id) REFERENCES nemura.organisation(organisation_id)
audit_event | audit_event_organisation_id_not_null | NOT NULL organisation_id
audit_event | audit_event_pkey | PRIMARY KEY (organisation_id, id)
audit_event | audit_event_prev_hash_not_null | NOT NULL prev_hash
audit_event | audit_event_seq_key | UNIQUE (organisation_id, seq)
audit_event | audit_event_seq_not_null | NOT NULL seq
audit_event | audit_event_seq_positive | CHECK ((seq > 0))
organisation | organisation_created_at_not_null | NOT NULL created_at
organisation | organisation_name_length | CHECK (((length(btrim(name)) >= 1) AND (length(btrim(name)) <= 200)))
organisation | organisation_name_not_null | NOT NULL name
organisation | organisation_organisation_id_not_null | NOT NULL organisation_id
organisation | organisation_pkey | PRIMARY KEY (organisation_id)
organisation | require_audit | TRIGGER DEFERRABLE INITIALLY DEFERRED
outbox | outbox_attempts_not_null | NOT NULL attempts
outbox | outbox_attempts_range | CHECK (((attempts >= 0) AND ((max_attempts >= 1) AND (max_attempts <= 100))))
outbox | outbox_business_key | UNIQUE (organisation_id, kind, business_key)
outbox | outbox_business_key_length | CHECK (((length(business_key) >= 1) AND (length(business_key) <= 500)))
outbox | outbox_created_at_not_null | NOT NULL created_at
outbox | outbox_dispatches_not_negative | CHECK ((dispatches >= 0))
outbox | outbox_dispatches_not_null | NOT NULL dispatches
outbox | outbox_id_not_null | NOT NULL id
outbox | outbox_kind_format | CHECK (((kind ~ '^[a-z][a-z0-9_]*(\.[a-z][a-z0-9_]*)+$'::text) AND (length(kind) <= 100)))
outbox | outbox_kind_not_null | NOT NULL kind
outbox | outbox_last_error_length | CHECK ((length(last_error) <= 2000))
outbox | outbox_lease_whole | CHECK (((lease_holder IS NULL) = (lease_expires_at IS NULL)))
outbox | outbox_max_attempts_not_null | NOT NULL max_attempts
outbox | outbox_organisation_fkey | FOREIGN KEY (organisation_id) REFERENCES nemura.organisation(organisation_id)
outbox | outbox_organisation_id_not_null | NOT NULL organisation_id
outbox | outbox_payload_not_null | NOT NULL payload
outbox | outbox_payload_object | CHECK (((jsonb_typeof(payload) = 'object'::text) AND (octet_length((payload)::text) <= 262144)))
outbox | outbox_pkey | PRIMARY KEY (organisation_id, id)
outbox | outbox_state_known | CHECK ((state = ANY (ARRAY['pending'::text, 'dispatched'::text, 'running'::text, 'done'::text, 'failed'::text, 'dead'::text])))
outbox | outbox_state_not_null | NOT NULL state
outbox | outbox_task_name_length | CHECK ((length(task_name) <= 500))
outbox | outbox_updated_at_not_null | NOT NULL updated_at
outbox | outbox_worker_class_known | CHECK ((worker_class = ANY (ARRAY['worker'::text, 'executor'::text])))
outbox | outbox_worker_class_not_null | NOT NULL worker_class
tenant_directory | tenant_directory_created_at_not_null | NOT NULL created_at
tenant_directory | tenant_directory_organisation_fkey | FOREIGN KEY (organisation_id) REFERENCES nemura.organisation(organisation_id)
tenant_directory | tenant_directory_organisation_id_not_null | NOT NULL organisation_id
tenant_directory | tenant_directory_pkey | PRIMARY KEY (organisation_id)

## indexes
CREATE UNIQUE INDEX audit_chain_pkey ON nemura.audit_chain USING btree (organisation_id)
CREATE INDEX audit_event_object_idx ON nemura.audit_event USING btree (organisation_id, created_xact, object_type, object_id)
CREATE UNIQUE INDEX audit_event_pkey ON nemura.audit_event USING btree (organisation_id, id)
CREATE UNIQUE INDEX audit_event_seq_key ON nemura.audit_event USING btree (organisation_id, seq)
CREATE UNIQUE INDEX organisation_pkey ON nemura.organisation USING btree (organisation_id)
CREATE UNIQUE INDEX outbox_business_key ON nemura.outbox USING btree (organisation_id, kind, business_key)
CREATE UNIQUE INDEX outbox_pkey ON nemura.outbox USING btree (organisation_id, id)
CREATE INDEX outbox_state_idx ON nemura.outbox USING btree (organisation_id, state, deadline_at)
CREATE UNIQUE INDEX tenant_directory_pkey ON nemura.tenant_directory USING btree (organisation_id)

## triggers
CREATE TRIGGER audit_chain_guard BEFORE DELETE OR UPDATE ON nemura.audit_chain FOR EACH ROW EXECUTE FUNCTION nemura.audit_chain_guard()
CREATE TRIGGER audit_chain_no_truncate BEFORE TRUNCATE ON nemura.audit_chain FOR EACH STATEMENT EXECUTE FUNCTION nemura.audit_immutable()
CREATE TRIGGER audit_event_append BEFORE INSERT ON nemura.audit_event FOR EACH ROW EXECUTE FUNCTION nemura.audit_event_append()
CREATE TRIGGER audit_event_immutable BEFORE DELETE OR UPDATE ON nemura.audit_event FOR EACH ROW EXECUTE FUNCTION nemura.audit_immutable()
CREATE TRIGGER audit_event_no_truncate BEFORE TRUNCATE ON nemura.audit_event FOR EACH STATEMENT EXECUTE FUNCTION nemura.audit_immutable()
CREATE TRIGGER organisation_registered AFTER INSERT ON nemura.organisation FOR EACH ROW EXECUTE FUNCTION nemura.organisation_registered()
CREATE TRIGGER outbox_guard BEFORE UPDATE ON nemura.outbox FOR EACH ROW EXECUTE FUNCTION nemura.outbox_guard()
CREATE TRIGGER outbox_no_delete BEFORE DELETE ON nemura.outbox FOR EACH ROW EXECUTE FUNCTION nemura.outbox_no_delete()
CREATE TRIGGER outbox_no_truncate BEFORE TRUNCATE ON nemura.outbox FOR EACH STATEMENT EXECUTE FUNCTION nemura.outbox_no_delete()
CREATE CONSTRAINT TRIGGER require_audit AFTER INSERT OR UPDATE ON nemura.organisation DEFERRABLE INITIALLY DEFERRED FOR EACH ROW EXECUTE FUNCTION nemura.require_audit('organisation', 'organisation_id')

## policies (table | name | using | with check)
audit_chain | tenant_isolation | (organisation_id = nemura.current_org()) | (organisation_id = nemura.current_org())
audit_event | tenant_isolation | (organisation_id = nemura.current_org()) | (organisation_id = nemura.current_org())
organisation | tenant_isolation | (organisation_id = nemura.current_org()) | (organisation_id = nemura.current_org())
outbox | tenant_isolation | (organisation_id = nemura.current_org()) | (organisation_id = nemura.current_org())

## functions (definition)
CREATE OR REPLACE FUNCTION nemura.audit_chain_guard()
 RETURNS trigger
 LANGUAGE plpgsql
 SET search_path TO 'pg_catalog', 'nemura', 'pg_temp'
AS $function$
BEGIN
  IF TG_OP = 'DELETE' OR NEW.seq <> OLD.seq + 1 THEN
    RAISE EXCEPTION 'The audit chain head only moves forward by one event' USING ERRCODE = 'NM060';
  END IF;
  RETURN NEW;
END
$function$

CREATE OR REPLACE FUNCTION nemura.audit_event_append()
 RETURNS trigger
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'pg_catalog', 'nemura', 'pg_temp'
AS $function$
DECLARE
  org uuid := nemura.require_org();
  h   record;
BEGIN
  SELECT seq, head_hash INTO h FROM nemura.audit_chain WHERE organisation_id = org FOR UPDATE;
  IF NOT FOUND THEN
    RAISE EXCEPTION 'The organisation of this transaction has no audit chain' USING ERRCODE = 'NM006';
  END IF;
  NEW.organisation_id := org;
  NEW.seq := h.seq + 1;
  NEW.prev_hash := h.head_hash;
  NEW.hash := sha256(h.head_hash || convert_to(NEW.body, 'UTF8'));
  NEW.created_xact := pg_current_xact_id()::text::bigint;
  UPDATE nemura.audit_chain SET seq = NEW.seq, head_hash = NEW.hash WHERE organisation_id = org;
  RETURN NEW;
END
$function$

CREATE OR REPLACE FUNCTION nemura.audit_immutable()
 RETURNS trigger
 LANGUAGE plpgsql
 SET search_path TO 'pg_catalog', 'nemura', 'pg_temp'
AS $function$
BEGIN
  RAISE EXCEPTION 'The audit trail cannot be changed or deleted (% on %)', TG_OP, TG_TABLE_NAME
    USING ERRCODE = 'NM060', HINT = 'Audit events are append-only (AUD-08).';
END
$function$

CREATE OR REPLACE FUNCTION nemura.current_org()
 RETURNS uuid
 LANGUAGE sql
 STABLE PARALLEL SAFE
AS $function$
  SELECT CAST(nullif(pg_catalog.current_setting('app.org_id', true), '') AS pg_catalog.uuid)
$function$

CREATE OR REPLACE FUNCTION nemura.organisation_registered()
 RETURNS trigger
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'pg_catalog', 'nemura', 'pg_temp'
AS $function$
BEGIN
  INSERT INTO nemura.audit_chain (organisation_id) VALUES (NEW.organisation_id);
  INSERT INTO nemura.tenant_directory (organisation_id) VALUES (NEW.organisation_id);
  RETURN NULL;
END
$function$

CREATE OR REPLACE FUNCTION nemura.outbox_guard()
 RETURNS trigger
 LANGUAGE plpgsql
 SET search_path TO 'pg_catalog', 'nemura', 'pg_temp'
AS $function$
BEGIN
  IF NEW.worker_class IS DISTINCT FROM OLD.worker_class OR NEW.kind IS DISTINCT FROM OLD.kind
     OR NEW.payload IS DISTINCT FROM OLD.payload OR NEW.business_key IS DISTINCT FROM OLD.business_key
     OR NEW.created_at IS DISTINCT FROM OLD.created_at THEN
    RAISE EXCEPTION 'Outbox row % cannot change what it is', OLD.id USING ERRCODE = 'NM070';
  END IF;
  IF NEW.state IS DISTINCT FROM OLD.state AND NOT (
       (OLD.state = 'pending'    AND NEW.state IN ('dispatched', 'dead')) OR
       (OLD.state = 'dispatched' AND NEW.state IN ('running', 'dead')) OR
       (OLD.state = 'running'    AND NEW.state IN ('done', 'failed', 'dispatched', 'dead')) OR
       (OLD.state = 'failed'     AND NEW.state IN ('running', 'dispatched', 'dead')) OR
       (OLD.state = 'dead'       AND NEW.state IN ('pending'))) THEN
    RAISE EXCEPTION 'Outbox row % cannot go from % to %', OLD.id, OLD.state, NEW.state
      USING ERRCODE = 'NM071', HINT = 'pending -> dispatched -> running -> done | failed | dead (§12.11).';
  END IF;
  IF NEW.attempts < OLD.attempts OR NEW.dispatches < OLD.dispatches THEN
    RAISE EXCEPTION 'Outbox row % cannot count attempts or dispatches backwards', OLD.id USING ERRCODE = 'NM070';
  END IF;
  NEW.updated_at := now();
  RETURN NEW;
END
$function$

CREATE OR REPLACE FUNCTION nemura.outbox_no_delete()
 RETURNS trigger
 LANGUAGE plpgsql
 SET search_path TO 'pg_catalog', 'nemura', 'pg_temp'
AS $function$
BEGIN
  RAISE EXCEPTION 'Outbox rows are kept (% on %)', TG_OP, TG_TABLE_NAME USING ERRCODE = 'NM070';
END
$function$

CREATE OR REPLACE FUNCTION nemura.require_audit()
 RETURNS trigger
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'pg_catalog', 'nemura', 'pg_temp'
AS $function$
DECLARE
  audited_type text := TG_ARGV[0];
  audited_id   uuid := (to_jsonb(NEW) ->> TG_ARGV[1])::uuid;
BEGIN
  IF NOT EXISTS (
    SELECT 1 FROM nemura.audit_event e
     WHERE e.organisation_id = NEW.organisation_id
       AND e.created_xact = pg_current_xact_id()::text::bigint
       AND e.object_type = audited_type
       AND e.object_id = audited_id) THEN
    RAISE EXCEPTION 'The change to % % has no audit event in its transaction', audited_type, audited_id
      USING ERRCODE = 'NM061',
            HINT = 'Write changes through the unit of work, which records their audit events (AUD-08).';
  END IF;
  RETURN NULL;
END
$function$

CREATE OR REPLACE FUNCTION nemura.require_org()
 RETURNS uuid
 LANGUAGE plpgsql
 STABLE
 SET search_path TO 'pg_catalog', 'nemura', 'pg_temp'
AS $function$
DECLARE
  org uuid := nemura.current_org();
BEGIN
  IF org IS NULL THEN
    RAISE EXCEPTION 'No organisation is set for this transaction'
      USING ERRCODE = 'NM006',
            HINT = 'Run the work through the unit of work, which sets app.org_id first (INV-06).';
  END IF;
  RETURN org;
END
$function$


