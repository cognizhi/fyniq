{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "currency": {
      "description": "The project's currency.",
      "examples": [
        "USD"
      ],
      "type": "string"
    },
    "rate": {
      "description": "Base currency per one unit.",
      "examples": [
        "1.3472"
      ],
      "type": "string"
    },
    "rate_date": {
      "description": "The date the rate is of.",
      "examples": [
        "2026-10-30"
      ],
      "format": "date",
      "type": "string"
    },
    "source": {
      "description": "Where it came from.",
      "examples": [
        "MAS daily feed of 2026-10-30"
      ],
      "type": "string"
    }
  },
  "required": [
    "currency",
    "rate",
    "rate_date",
    "source"
  ],
  "title": "ProjectRevenueRate",
  "type": "object"
}
