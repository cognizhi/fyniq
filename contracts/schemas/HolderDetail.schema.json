{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "contact_id": {
      "description": "The holder's contact.",
      "examples": [
        "01928f6e-7a3b-7c41-9d2e-5f8a1b3c4c11"
      ],
      "format": "uuid",
      "type": "string"
    },
    "controller": {
      "$ref": "ControllerEntryView.schema.json",
      "description": "The registrable controller entry in force."
    },
    "controller_history": {
      "description": "Every controller entry, drafts and superseded ones included, the latest first.",
      "items": {
        "$ref": "ControllerEntryView.schema.json"
      },
      "type": "array"
    },
    "director": {
      "description": "Also a director.",
      "examples": [
        true
      ],
      "type": "boolean"
    },
    "history": {
      "description": "Every record, drafts and superseded ones included, the latest first.",
      "items": {
        "$ref": "HolderRecordView.schema.json"
      },
      "type": "array"
    },
    "holdings": {
      "description": "The shares held, by class, from the register of share issues.",
      "items": {
        "$ref": "HolderShares.schema.json"
      },
      "type": "array"
    },
    "identifier": {
      "description": "From the record in force: an individual's identifier type and last 4 characters, or an entity's number.",
      "examples": [
        "NRIC ending 567A"
      ],
      "type": "string"
    },
    "investor": {
      "description": "Marked investor: a SAFE, note or option holder.",
      "examples": [
        false
      ],
      "type": "boolean"
    },
    "issues": {
      "description": "The holder's share issues, earliest effective date first.",
      "items": {
        "$ref": "ShareIssue.schema.json"
      },
      "type": "array"
    },
    "kind": {
      "description": "From the record in force; absent before one is recorded.",
      "enum": [
        "individual",
        "entity"
      ],
      "examples": [
        "individual"
      ],
      "type": "string"
    },
    "name": {
      "description": "The holder's legal name.",
      "examples": [
        "Mei Lin Tan"
      ],
      "type": "string"
    },
    "pending_record_id": {
      "description": "A drafted record not recorded yet.",
      "examples": [
        "01928f6e-7a3b-7c41-9d2e-5f8a1b3c5e21"
      ],
      "format": "uuid",
      "type": "string"
    },
    "record": {
      "$ref": "HolderRecordView.schema.json",
      "description": "The record in force."
    },
    "recorded": {
      "description": "Whether a holder record is in force.",
      "examples": [
        true
      ],
      "type": "boolean"
    },
    "rights": {
      "$ref": "InvestorRightsView.schema.json",
      "description": "Their rights from the agreements in force."
    },
    "rights_history": {
      "description": "Every version of their rights, drafts and superseded ones included, the latest first.",
      "items": {
        "$ref": "InvestorRightsView.schema.json"
      },
      "type": "array"
    },
    "shareholder": {
      "description": "Marked shareholder.",
      "examples": [
        true
      ],
      "type": "boolean"
    }
  },
  "required": [
    "history",
    "issues",
    "rights_history",
    "controller_history",
    "contact_id",
    "name",
    "shareholder",
    "investor",
    "director",
    "recorded",
    "holdings"
  ],
  "title": "HolderDetail",
  "type": "object"
}
