person_secret | tenant_isolation | (organisation_id = nemura.current_org()) | (organisation_id = nemura.current_org())
reporting_line | tenant_isolation | (organisation_id = nemura.current_org()) | (organisation_id = nemura.current_org())
role_assignment | tenant_isolation | (organisation_id = nemura.current_org()) | (organisation_id = nemura.current_org())
session | tenant_isolation | (organisation_id = nemura.current_org()) | (organisation_id = nemura.current_org())
sick_notification | tenant_isolation | (organisation_id = nemura.current_org()) | (organisation_id = nemura.current_org())
sick_unpaid_decision | tenant_isolation | (organisation_id = nemura.current_org()) | (organisation_id = nemura.current_org())
transfer_assessment | tenant_isolation | (organisation_id = nemura.current_org()) | (organisation_id = nemura.current_org())
work_pass | tenant_isolation | (organisation_id = nemura.current_org()) | (organisation_id = nemura.current_org())
working_pattern | tenant_isolation | (organisation_id = nemura.current_org()) | (organisation_id = nemura.current_org())

## functions (definition)
CREATE OR REPLACE FUNCTION nemura.access_request_guard()
 RETURNS trigger
 LANGUAGE plpgsql
 SET search_path TO 'pg_catalog', 'nemura', 'pg_temp'
AS $function$
BEGIN
  IF TG_OP = 'DELETE' OR NEW.requester_id IS DISTINCT FROM OLD.requester_id OR NEW.received_on IS DISTINCT FROM OLD.received_on
     OR NEW.due_on IS DISTINCT FROM OLD.due_on OR OLD.state = 'answered' THEN
    RAISE EXCEPTION 'An access request keeps what was asked and, once answered, its answer' USING ERRCODE = 'NM090';
  END IF;
  RETURN NEW;
END
$function$

CREATE OR REPLACE FUNCTION nemura.access_request_item_guard()
 RETURNS trigger
 LANGUAGE plpgsql
 SET search_path TO 'pg_catalog', 'nemura', 'pg_temp'
AS $function$
BEGIN
  IF TG_OP = 'DELETE' OR EXISTS (SELECT 1 FROM nemura.access_request r
       WHERE r.organisation_id = coalesce(NEW.organisation_id, OLD.organisation_id) AND r.id = coalesce(NEW.request_id, OLD.request_id) AND r.state = 'answered') THEN
    RAISE EXCEPTION 'The decisions of an answered access request are kept' USING ERRCODE = 'NM090';
  END IF;
  RETURN NEW;
END
$function$

CREATE OR REPLACE FUNCTION nemura.api_client_guard()
 RETURNS trigger
 LANGUAGE plpgsql
 SET search_path TO 'pg_catalog', 'nemura', 'pg_temp'
AS $function$
BEGIN
  IF TG_OP = 'DELETE' OR NEW.name IS DISTINCT FROM OLD.name OR NEW.scopes IS DISTINCT FROM OLD.scopes OR NEW.hydra_client_id IS DISTINCT FROM OLD.hydra_client_id
     OR NEW.created_by IS DISTINCT FROM OLD.created_by OR (OLD.revoked_at IS NOT NULL AND NEW.revoked_at IS DISTINCT FROM OLD.revoked_at) THEN
    RAISE EXCEPTION 'An API client can only be revoked, once' USING ERRCODE = 'NM104';
  END IF;
  RETURN NEW;
END
$function$

CREATE OR REPLACE FUNCTION nemura.append_only()
 RETURNS trigger
 LANGUAGE plpgsql
 SET search_path TO 'pg_catalog', 'nemura', 'pg_temp'
AS $function$
BEGIN
  RAISE EXCEPTION '% is append-only (% refused)', TG_TABLE_NAME, TG_OP USING ERRCODE = 'NM091';
END
$function$

CREATE OR REPLACE FUNCTION nemura.append_only_guard()
 RETURNS trigger
 LANGUAGE plpgsql
 SET search_path TO 'pg_catalog', 'nemura', 'pg_temp'
AS $function$
BEGIN
  RAISE EXCEPTION '% is append-only: a correction is a new record', TG_ARGV[0] USING ERRCODE = 'NM127';
END
$function$

CREATE OR REPLACE FUNCTION nemura.approval_request_guard()
 RETURNS trigger
 LANGUAGE plpgsql
 SET search_path TO 'pg_catalog', 'nemura', 'pg_temp'
AS $function$
BEGIN
  IF TG_OP = 'DELETE' OR NEW.object_type IS DISTINCT FROM OLD.object_type OR NEW.object_id IS DISTINCT FROM OLD.object_id
     OR NEW.version IS DISTINCT FROM OLD.version OR NEW.digest IS DISTINCT FROM OLD.digest
     OR NEW.requested_by IS DISTINCT FROM OLD.requested_by OR NEW.required_role IS DISTINCT FROM OLD.required_role
     OR NEW.expires_at IS DISTINCT FROM OLD.expires_at OR OLD.state <> 'pending' THEN
    RAISE EXCEPTION 'An approval request is decided once and never changed' USING ERRCODE = 'NM082';
  END IF;
  RETURN NEW;
END
$function$

CREATE OR REPLACE FUNCTION nemura.audit_chain_guard()
 RETURNS trigger
 LANGUAGE plpgsql
 SET search_path TO 'pg_catalog', 'nemura', 'pg_temp'
AS $function$
BEGIN
  IF TG_OP = 'DELETE' OR NEW.seq <> OLD.seq + 1 THEN
    RAISE EXCEPTION 'The audit chain head only moves forward by one event' USING ERRCODE = 'NM060';
  END IF;
  RETURN NEW;
END
$function$

CREATE OR REPLACE FUNCTION nemura.audit_event_append()
 RETURNS trigger
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'pg_catalog', 'nemura', 'pg_temp'
AS $function$
DECLARE
  org uuid := nemura.require_org();
  h   record;
BEGIN
  SELECT seq, head_hash INTO h FROM nemura.audit_chain WHERE organisation_id = org FOR UPDATE;
  IF NOT FOUND THEN
    RAISE EXCEPTION 'The organisation of this transaction has no audit chain' USING ERRCODE = 'NM006';
  END IF;
  NEW.organisation_id := org;
  NEW.seq := h.seq + 1;
  NEW.prev_hash := h.head_hash;
  NEW.hash := sha256(h.head_hash || convert_to(NEW.body, 'UTF8'));
  NEW.created_xact := pg_current_xact_id()::text::bigint;
  UPDATE nemura.audit_chain SET seq = NEW.seq, head_hash = NEW.hash WHERE organisation_id = org;
  RETURN NEW;
END
$function$

CREATE OR REPLACE FUNCTION nemura.audit_immutable()
 RETURNS trigger
 LANGUAGE plpgsql
 SET search_path TO 'pg_catalog', 'nemura', 'pg_temp'
AS $function$
BEGIN
  RAISE EXCEPTION 'The audit trail cannot be changed or deleted (% on %)', TG_OP, TG_TABLE_NAME
    USING ERRCODE = 'NM060', HINT = 'Audit events are append-only (AUD-08).';
END
$function$

CREATE OR REPLACE FUNCTION nemura.bank_account_change_guard()
 RETURNS trigger
 LANGUAGE plpgsql
 SET search_path TO 'pg_catalog', 'nemura', 'pg_temp'
AS $function$
BEGIN
  IF TG_OP = 'DELETE' OR NEW.person_id IS DISTINCT FROM OLD.person_id OR NEW.new_sealed IS DISTINCT FROM OLD.new_sealed OR NEW.new_masked IS DISTINCT FROM OLD.new_masked
     OR NEW.proposed_by IS DISTINCT FROM OLD.proposed_by OR NEW.approval_id IS DISTINCT FROM OLD.approval_id
     OR NOT ((OLD.state = 'proposed' AND NEW.state IN ('approved', 'refused')) OR (OLD.state = 'approved' AND NEW.state = 'confirmed')) THEN
    RAISE EXCEPTION 'A bank account change moves forward only: proposed, approved or refused, then confirmed' USING ERRCODE = 'NM126';
  END IF;
  RETURN NEW;
END
$function$

CREATE OR REPLACE FUNCTION nemura.claim_setup(p_hash bytea)
 RETURNS boolean
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'pg_catalog', 'nemura', 'pg_temp'
AS $function$
DECLARE
  n integer;
BEGIN
  UPDATE nemura.installation SET setup_code_hash = NULL, setup_completed_at = now()
   WHERE setup_code_hash = p_hash AND setup_completed_at IS NULL;
  GET DIAGNOSTICS n = ROW_COUNT;
  RETURN n = 1;
END
$function$

CREATE OR REPLACE FUNCTION nemura.company_policy_guard()
 RETURNS trigger
 LANGUAGE plpgsql
 SET search_path TO 'pg_catalog', 'nemura', 'pg_temp'
AS $function$
BEGIN
  IF TG_OP = 'DELETE' OR (TG_OP = 'UPDATE' AND (NEW.effective_from IS DISTINCT FROM OLD.effective_from OR NEW.rules IS DISTINCT FROM OLD.rules OR NEW.pack_version IS DISTINCT FROM OLD.pack_version
     OR (OLD.effective_to IS NOT NULL AND NEW.effective_to IS DISTINCT FROM OLD.effective_to))) THEN
    RAISE EXCEPTION 'A company policy is history: it can only be ended, once' USING ERRCODE = 'NM130';
  END IF;
  IF EXISTS (SELECT 1 FROM nemura.company_policy p WHERE p.organisation_id = NEW.organisation_id AND p.id <> NEW.id
               AND daterange(p.effective_from, coalesce(p.effective_to, 'infinity'), '[)') && daterange(NEW.effective_from, coalesce(NEW.effective_to, 'infinity'), '[)')) THEN
    RAISE EXCEPTION 'A company has one policy at a time' USING ERRCODE = 'NM131';
  END IF;
  RETURN NEW;
END
$function$

CREATE OR REPLACE FUNCTION nemura.current_org()
 RETURNS uuid
 LANGUAGE sql
 STABLE PARALLEL SAFE
AS $function$
  SELECT CAST(nullif(pg_catalog.current_setting('app.org_id', true), '') AS pg_catalog.uuid)
$function$

CREATE OR REPLACE FUNCTION nemura.current_person()
 RETURNS uuid
 LANGUAGE sql
 STABLE PARALLEL SAFE
AS $function$
  SELECT CAST(nullif(pg_catalog.current_setting('app.person_id', true), '') AS pg_catalog.uuid)
$function$

CREATE OR REPLACE FUNCTION nemura.decision_once_guard()
 RETURNS trigger
 LANGUAGE plpgsql
 SET search_path TO 'pg_catalog', 'nemura', 'pg_temp'
AS $function$
BEGIN
  RAISE EXCEPTION '% is evidence: a decision is made once', TG_ARGV[0] USING ERRCODE = 'NM155';
END
$function$

CREATE OR REPLACE FUNCTION nemura.feature_state_guard()
 RETURNS trigger
 LANGUAGE plpgsql
 SET search_path TO 'pg_catalog', 'nemura', 'pg_temp'
AS $function$
BEGIN
  IF TG_OP = 'DELETE' OR NEW.feature IS DISTINCT FROM OLD.feature THEN
    RAISE EXCEPTION 'A feature switch is changed, never removed or renamed' USING ERRCODE = 'NM125';
  END IF;
  RETURN NEW;
END
$function$

CREATE OR REPLACE FUNCTION nemura.flex_request_guard()
 RETURNS trigger
 LANGUAGE plpgsql
 SET search_path TO 'pg_catalog', 'nemura', 'pg_temp'
AS $function$
BEGIN
  IF TG_OP = 'DELETE' THEN
    RAISE EXCEPTION 'A flexible work request is evidence: it is withdrawn, never deleted' USING ERRCODE = 'NM151';
  END IF;
  IF TG_OP = 'INSERT' THEN
    IF NEW.state <> 'received' THEN
      RAISE EXCEPTION 'A flexible work request starts received' USING ERRCODE = 'NM151';
    END IF;
    RETURN NEW;
  END IF;
  IF NEW.person_id IS DISTINCT FROM OLD.person_id OR NEW.arrangement IS DISTINCT FROM OLD.arrangement OR NEW.start_date IS DISTINCT FROM OLD.start_date
     OR NEW.end_date IS DISTINCT FROM OLD.end_date OR NEW.reason IS DISTINCT FROM OLD.reason OR NEW.received_on IS DISTINCT FROM OLD.received_on
     OR NEW.reply_due IS DISTINCT FROM OLD.reply_due OR NEW.pack_version IS DISTINCT FROM OLD.pack_version OR NEW.requested_by IS DISTINCT FROM OLD.requested_by
     OR NEW.requested_at IS DISTINCT FROM OLD.requested_at THEN
    RAISE EXCEPTION 'A flexible work request keeps its words, its receipt date and its deadline' USING ERRCODE = 'NM151';
  END IF;
  IF OLD.state <> 'received' THEN
    RAISE EXCEPTION 'A % flexible work request is closed', OLD.state USING ERRCODE = 'NM151';
  END IF;
  IF NEW.state = 'replied' AND EXISTS (SELECT 1 FROM nemura.person p WHERE p.organisation_id = NEW.organisation_id AND p.id = NEW.person_id AND p.member_id = NEW.replied_by) THEN
    RAISE EXCEPTION 'Nobody answers their own flexible work request' USING ERRCODE = 'NM152';
  END IF;
  RETURN NEW;
END
$function$

CREATE OR REPLACE FUNCTION nemura.gov_leave_guard()
 RETURNS trigger
 LANGUAGE plpgsql
 SET search_path TO 'pg_catalog', 'nemura', 'pg_temp'
AS $function$
BEGIN
  IF TG_OP <> 'INSERT' THEN
    RAISE EXCEPTION '% is evidence: a correction is a new record', TG_ARGV[0] USING ERRCODE = 'NM149';
  END IF;
  IF TG_TABLE_NAME = 'gov_leave' THEN
    PERFORM pg_advisory_xact_lock(hashtextextended(NEW.organisation_id::text || NEW.person_id::text, 0));
    IF nemura.person_has_leave(NEW.organisation_id, NEW.person_id, NEW.start_date, NEW.end_date) THEN
      RAISE EXCEPTION 'The person has leave, sick leave or government-paid leave on some of those days' USING ERRCODE = 'NM150';
    END IF;
  END IF;
  RETURN NEW;
END
$function$

CREATE OR REPLACE FUNCTION nemura.has_role(wanted text)
 RETURNS boolean
 LANGUAGE sql
 STABLE SECURITY DEFINER
 SET search_path TO 'pg_catalog', 'nemura', 'pg_temp'
AS $function$
  SELECT EXISTS (
    SELECT 1 FROM nemura.role_assignment a
     WHERE a.organisation_id = nemura.current_org() AND a.member_id = nemura.current_person() AND a.role = wanted
       AND a.effective_from <= coalesce(nullif(pg_catalog.current_setting('app.on', true), '')::date, current_date)
       AND (a.effective_to IS NULL OR a.effective_to > coalesce(nullif(pg_catalog.current_setting('app.on', true), '')::date, current_date)))
$function$

CREATE OR REPLACE FUNCTION nemura.is_manager_of(report uuid)
 RETURNS boolean
 LANGUAGE sql
 STABLE SECURITY DEFINER
 SET search_path TO 'pg_catalog', 'nemura', 'pg_temp'
AS $function$
  SELECT EXISTS (
    SELECT 1 FROM nemura.reporting_line l
     WHERE l.organisation_id = nemura.current_org() AND l.report_id = report AND l.manager_id = nemura.current_person()
       AND l.effective_from <= coalesce(nullif(pg_catalog.current_setting('app.on', true), '')::date, current_date)
       AND (l.effective_to IS NULL OR l.effective_to > coalesce(nullif(pg_catalog.current_setting('app.on', true), '')::date, current_date)))
$function$

CREATE OR REPLACE FUNCTION nemura.issue_owner_recovery(p_org uuid, p_id uuid, p_member uuid, p_hash bytea, p_operators text[], p_event_id uuid, p_body text, p_on date)
 RETURNS timestamp with time zone
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'pg_catalog', 'nemura', 'pg_temp'
AS $function$
DECLARE
  expires timestamptz := now() + interval '24 hours';
  names text[];
BEGIN
  PERFORM set_config('app.org_id', p_org::text, true);
  SELECT array_agg(btrim(n)) INTO names FROM unnest(p_operators) AS n;
  IF names IS NULL OR cardinality(names) <> 2 OR EXISTS (SELECT 1 FROM unnest(names) n WHERE length(n) NOT BETWEEN 1 AND 100)
     OR lower(names[1]) = lower(names[2]) THEN
    RAISE EXCEPTION 'A recovery needs exactly two different operators, by name' USING ERRCODE = 'NM110';
  END IF;
  IF NOT EXISTS (
    SELECT 1 FROM nemura.member m JOIN nemura.role_assignment a ON a.organisation_id = m.organisation_id AND a.member_id = m.id
     WHERE m.organisation_id = p_org AND m.id = p_member AND m.deactivated_at IS NULL AND a.role = 'owner'
       AND a.effective_from <= p_on AND (a.effective_to IS NULL OR a.effective_to > p_on)) THEN
    RAISE EXCEPTION 'The member is not an active Owner of that organisation' USING ERRCODE = 'NM111';
  END IF;
  INSERT INTO nemura.audit_event (id, body) VALUES (p_event_id, p_body);
  INSERT INTO nemura.owner_recovery (id, member_id, code_hash, operators, created_at, expires_at)
  VALUES (p_id, p_member, p_hash, names, now(), expires);
  RETURN expires;
END
$function$

CREATE OR REPLACE FUNCTION nemura.leave_accrual_guard()
 RETURNS trigger
 LANGUAGE plpgsql
 SET search_path TO 'pg_catalog', 'nemura', 'pg_temp'
AS $function$
BEGIN
  IF TG_OP = 'DELETE' OR NEW.month IS DISTINCT FROM OLD.month OR NEW.person_id IS DISTINCT FROM OLD.person_id OR NEW.carried_days IS DISTINCT FROM OLD.carried_days
     OR NEW.annual_left IS DISTINCT FROM OLD.annual_left OR NEW.drafted_by IS DISTINCT FROM OLD.drafted_by OR NEW.drafted_at IS DISTINCT FROM OLD.drafted_at
     OR (OLD.state = 'approved' AND NEW IS DISTINCT FROM OLD) THEN
    RAISE EXCEPTION 'An accrual draft is evidence: it is approved once and never edited or deleted' USING ERRCODE = 'NM156';
  END IF;
  RETURN NEW;
END
$function$

CREATE OR REPLACE FUNCTION nemura.leave_ledger_guard()
 RETURNS trigger
 LANGUAGE plpgsql
 SET search_path TO 'pg_catalog', 'nemura', 'pg_temp'
AS $function$
DECLARE
  total numeric;
BEGIN
  IF TG_OP <> 'INSERT' THEN
    RAISE EXCEPTION 'The leave ledger is append-only: a correction is a new entry' USING ERRCODE = 'NM142';
  END IF;
  IF NOT NEW.negative_ok AND NEW.amount < 0 THEN
    SELECT coalesce(sum(amount), 0) INTO total FROM nemura.leave_ledger
     WHERE organisation_id = NEW.organisation_id AND person_id = NEW.person_id AND type_key = NEW.type_key AND leave_year = NEW.leave_year;
    IF total + NEW.amount < 0 THEN
      RAISE EXCEPTION 'That would take the balance below zero' USING ERRCODE = 'NM143';
    END IF;
  END IF;
  RETURN NEW;
END
$function$

CREATE OR REPLACE FUNCTION nemura.leave_request_guard()
 RETURNS trigger
 LANGUAGE plpgsql
 SET search_path TO 'pg_catalog', 'nemura', 'pg_temp'
AS $function$
BEGIN
  IF TG_OP = 'DELETE' THEN
    RAISE EXCEPTION 'A leave request is evidence: it is cancelled, never deleted' USING ERRCODE = 'NM144';
  END IF;
  IF TG_OP = 'INSERT' THEN
    IF NEW.state <> 'pending' THEN
      RAISE EXCEPTION 'A leave request starts pending' USING ERRCODE = 'NM144';
    END IF;
    PERFORM pg_advisory_xact_lock(hashtextextended(NEW.organisation_id::text || NEW.person_id::text, 0));
    IF nemura.person_has_leave(NEW.organisation_id, NEW.person_id, NEW.start_date, NEW.end_date) THEN
      RAISE EXCEPTION 'The person has leave requested, approved, sick or government-paid on some of those days' USING ERRCODE = 'NM145';
    END IF;
    RETURN NEW;
  END IF;
  IF NEW.person_id IS DISTINCT FROM OLD.person_id OR NEW.type_key IS DISTINCT FROM OLD.type_key OR NEW.leave_year IS DISTINCT FROM OLD.leave_year
     OR NEW.start_date IS DISTINCT FROM OLD.start_date OR NEW.end_date IS DISTINCT FROM OLD.end_date OR NEW.start_half IS DISTINCT FROM OLD.start_half
     OR NEW.end_half IS DISTINCT FROM OLD.end_half OR NEW.days IS DISTINCT FROM OLD.days OR NEW.note IS DISTINCT FROM OLD.note
     OR NEW.requested_by IS DISTINCT FROM OLD.requested_by OR NEW.requested_at IS DISTINCT FROM OLD.requested_at THEN
    RAISE EXCEPTION 'A leave request is evidence: only its decision changes' USING ERRCODE = 'NM144';
  END IF;
  IF NEW.state IS DISTINCT FROM OLD.state AND NOT ((OLD.state = 'pending' AND NEW.state IN ('approved', 'refused', 'cancelled')) OR (OLD.state = 'approved' AND NEW.state = 'cancelled')) THEN
    RAISE EXCEPTION 'A % leave request cannot become %', OLD.state, NEW.state USING ERRCODE = 'NM144';
  END IF;
  IF OLD.decided_by IS NOT NULL AND NEW.state IN ('approved', 'refused') AND (NEW.decided_by IS DISTINCT FROM OLD.decided_by OR NEW.decided_at IS DISTINCT FROM OLD.decided_at OR NEW.decision_reason IS DISTINCT FROM OLD.decision_reason) THEN
    RAISE EXCEPTION 'A decision is written once' USING ERRCODE = 'NM144';
  END IF;
  IF OLD.settled_at IS NOT NULL AND NEW.settled_at IS DISTINCT FROM OLD.settled_at THEN
    RAISE EXCEPTION 'A settled request stays settled' USING ERRCODE = 'NM144';
  END IF;
  RETURN NEW;
END
$function$

CREATE OR REPLACE FUNCTION nemura.link_identity(p_issuer text, p_subject text, p_tenant text, p_member uuid)
 RETURNS void
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'pg_catalog', 'nemura', 'pg_temp'
AS $function$
BEGIN
  INSERT INTO nemura.identity_directory (issuer, subject, tenant, organisation_id, member_id)
  VALUES (p_issuer, p_subject, p_tenant, nemura.require_org(), p_member);
END
$function$

CREATE OR REPLACE FUNCTION nemura.lock_leave_head(p_person uuid, p_type text, p_year integer)
 RETURNS void
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'pg_catalog', 'nemura', 'pg_temp'
AS $function$
BEGIN
  INSERT INTO nemura.leave_head (person_id, type_key, leave_year) VALUES (p_person, p_type, p_year) ON CONFLICT DO NOTHING;
  PERFORM 1 FROM nemura.leave_head WHERE organisation_id = nemura.current_org() AND person_id = p_person AND type_key = p_type AND leave_year = p_year FOR UPDATE;
END
$function$

CREATE OR REPLACE FUNCTION nemura.member_deactivated()
 RETURNS trigger
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'pg_catalog', 'nemura', 'pg_temp'
AS $function$
BEGIN
  UPDATE nemura.identity_directory SET active = (NEW.deactivated_at IS NULL) WHERE organisation_id = NEW.organisation_id AND member_id = NEW.id;
  RETURN NULL;
END
$function$

CREATE OR REPLACE FUNCTION nemura.members_for_identity(p_issuer text, p_subject text, p_tenant text)
 RETURNS TABLE(organisation_id uuid, member_id uuid)
 LANGUAGE sql
 STABLE SECURITY DEFINER
 SET search_path TO 'pg_catalog', 'nemura', 'pg_temp'
AS $function$
  SELECT d.organisation_id, d.member_id
    FROM nemura.identity_directory d
   WHERE d.issuer = p_issuer AND d.subject = p_subject AND d.tenant = p_tenant AND d.active
   ORDER BY d.linked_at
$function$

CREATE OR REPLACE FUNCTION nemura.members_no_delete()
 RETURNS trigger
 LANGUAGE plpgsql
 SET search_path TO 'pg_catalog', 'nemura', 'pg_temp'
AS $function$
BEGIN
  RAISE EXCEPTION 'Members are deactivated, not deleted' USING ERRCODE = 'NM081';
END
$function$

CREATE OR REPLACE FUNCTION nemura.organisation_registered()
 RETURNS trigger
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'pg_catalog', 'nemura', 'pg_temp'
AS $function$
BEGIN
  INSERT INTO nemura.audit_chain (organisation_id) VALUES (NEW.organisation_id);
  INSERT INTO nemura.tenant_directory (organisation_id) VALUES (NEW.organisation_id);
  RETURN NULL;
END
$function$

CREATE OR REPLACE FUNCTION nemura.outbox_guard()
 RETURNS trigger
 LANGUAGE plpgsql
 SET search_path TO 'pg_catalog', 'nemura', 'pg_temp'
AS $function$
BEGIN
  IF NEW.worker_class IS DISTINCT FROM OLD.worker_class OR NEW.kind IS DISTINCT FROM OLD.kind
     OR NEW.payload IS DISTINCT FROM OLD.payload OR NEW.business_key IS DISTINCT FROM OLD.business_key
     OR NEW.created_at IS DISTINCT FROM OLD.created_at THEN
    RAISE EXCEPTION 'Outbox row % cannot change what it is', OLD.id USING ERRCODE = 'NM070';
  END IF;
  IF NEW.state IS DISTINCT FROM OLD.state AND NOT (
       (OLD.state = 'pending'    AND NEW.state IN ('dispatched', 'dead')) OR
       (OLD.state = 'dispatched' AND NEW.state IN ('running', 'dead')) OR
       (OLD.state = 'running'    AND NEW.state IN ('done', 'failed', 'dispatched', 'dead')) OR
       (OLD.state = 'failed'     AND NEW.state IN ('running', 'dispatched', 'dead')) OR
       (OLD.state = 'dead'       AND NEW.state IN ('pending'))) THEN
    RAISE EXCEPTION 'Outbox row % cannot go from % to %', OLD.id, OLD.state, NEW.state
      USING ERRCODE = 'NM071', HINT = 'pending -> dispatched -> running -> done | failed | dead (§12.11).';
  END IF;
  IF NEW.attempts < OLD.attempts OR NEW.dispatches < OLD.dispatches THEN
    RAISE EXCEPTION 'Outbox row % cannot count attempts or dispatches backwards', OLD.id USING ERRCODE = 'NM070';
  END IF;
  NEW.updated_at := now();
  RETURN NEW;
END
$function$

CREATE OR REPLACE FUNCTION nemura.outbox_no_delete()
 RETURNS trigger
 LANGUAGE plpgsql
 SET search_path TO 'pg_catalog', 'nemura', 'pg_temp'
AS $function$
BEGIN
  RAISE EXCEPTION 'Outbox rows are kept (% on %)', TG_OP, TG_TABLE_NAME USING ERRCODE = 'NM070';
END
$function$

CREATE OR REPLACE FUNCTION nemura.overtime_entry_guard()
 RETURNS trigger
 LANGUAGE plpgsql
 SET search_path TO 'pg_catalog', 'nemura', 'pg_temp'
AS $function$
BEGIN
  IF TG_OP = 'DELETE' THEN
    RAISE EXCEPTION 'An overtime record is never deleted: work beyond the limit stays recorded' USING ERRCODE = 'NM153';
  END IF;
  IF TG_OP = 'INSERT' THEN
    IF NEW.state <> 'pending' OR NEW.used_in_run IS NOT NULL THEN
      RAISE EXCEPTION 'An overtime record starts pending and unused' USING ERRCODE = 'NM153';
    END IF;
    RETURN NEW;
  END IF;
  IF NEW.person_id IS DISTINCT FROM OLD.person_id OR NEW.work_date IS DISTINCT FROM OLD.work_date OR NEW.kind IS DISTINCT FROM OLD.kind OR NEW.hours IS DISTINCT FROM OLD.hours
     OR NEW.branch IS DISTINCT FROM OLD.branch OR NEW.over_limit IS DISTINCT FROM OLD.over_limit OR NEW.note IS DISTINCT FROM OLD.note
     OR NEW.requested_by IS DISTINCT FROM OLD.requested_by OR NEW.requested_at IS DISTINCT FROM OLD.requested_at THEN
    RAISE EXCEPTION 'An overtime record is evidence: only its decision and its use change' USING ERRCODE = 'NM153';
  END IF;
  IF NEW.state IS DISTINCT FROM OLD.state AND OLD.state <> 'pending' THEN
    RAISE EXCEPTION 'A % overtime record cannot become %', OLD.state, NEW.state USING ERRCODE = 'NM153';
  END IF;
  IF OLD.decided_by IS NOT NULL AND (NEW.decided_by IS DISTINCT FROM OLD.decided_by OR NEW.decided_at IS DISTINCT FROM OLD.decided_at OR NEW.decision_reason IS DISTINCT FROM OLD.decision_reason) THEN
    RAISE EXCEPTION 'A decision is written once' USING ERRCODE = 'NM153';
  END IF;
  IF OLD.used_in_run IS NOT NULL AND (NEW.used_in_run IS DISTINCT FROM OLD.used_in_run OR NEW.used_at IS DISTINCT FROM OLD.used_at) THEN
    RAISE EXCEPTION 'A record used by a pay run is used once' USING ERRCODE = 'NM153';
  END IF;
  IF NEW.state IN ('approved', 'refused') AND OLD.state = 'pending' AND EXISTS (SELECT 1 FROM nemura.person p WHERE p.organisation_id = NEW.organisation_id AND p.id = NEW.person_id AND p.member_id = NEW.decided_by) THEN
    RAISE EXCEPTION 'Nobody decides their own overtime' USING ERRCODE = 'NM154';
  END IF;
  RETURN NEW;
END
$function$

CREATE OR REPLACE FUNCTION nemura.owner_recovery_guard()
 RETURNS trigger
 LANGUAGE plpgsql
 SET search_path TO 'pg_catalog', 'nemura', 'pg_temp'
AS $function$
BEGIN
  IF TG_OP = 'DELETE' OR NEW.member_id IS DISTINCT FROM OLD.member_id OR NEW.code_hash IS DISTINCT FROM OLD.code_hash
     OR NEW.operators IS DISTINCT FROM OLD.operators OR NEW.expires_at IS DISTINCT FROM OLD.expires_at OR NEW.created_at IS DISTINCT FROM OLD.created_at
     OR OLD.used_at IS NOT NULL OR NEW.used_at IS NULL OR NEW.used_xact IS DISTINCT FROM OLD.used_xact THEN
    RAISE EXCEPTION 'A recovery code can only be used, once' USING ERRCODE = 'NM113';
  END IF;
  IF OLD.expires_at <= now() THEN
    RAISE EXCEPTION 'The recovery code has expired' USING ERRCODE = 'NM113';
  END IF;
  NEW.used_xact := pg_current_xact_id()::text::bigint;
  RETURN NEW;
END
$function$

CREATE OR REPLACE FUNCTION nemura.pack_record_guard()
 RETURNS trigger
 LANGUAGE plpgsql
 SET search_path TO 'pg_catalog', 'nemura', 'pg_temp'
AS $function$
BEGIN
  RAISE EXCEPTION '% is never changed or deleted', TG_ARGV[0] USING ERRCODE = 'NM129';
END
$function$

CREATE OR REPLACE FUNCTION nemura.passkey_challenge_guard()
 RETURNS trigger
 LANGUAGE plpgsql
 SET search_path TO 'pg_catalog', 'nemura', 'pg_temp'
AS $function$
BEGIN
  IF TG_OP = 'DELETE' OR OLD.used_at IS NOT NULL OR NEW.challenge IS DISTINCT FROM OLD.challenge OR NEW.session_id IS DISTINCT FROM OLD.session_id
     OR NEW.purpose IS DISTINCT FROM OLD.purpose OR NEW.expires_at IS DISTINCT FROM OLD.expires_at THEN
    RAISE EXCEPTION 'A passkey challenge is used once and never changed' USING ERRCODE = 'NM102';
  END IF;
  RETURN NEW;
END
$function$

CREATE OR REPLACE FUNCTION nemura.passkey_guard()
 RETURNS trigger
 LANGUAGE plpgsql
 SET search_path TO 'pg_catalog', 'nemura', 'pg_temp'
AS $function$
BEGIN
  IF TG_OP = 'DELETE' OR NEW.member_id IS DISTINCT FROM OLD.member_id OR NEW.credential_id IS DISTINCT FROM OLD.credential_id
     OR NEW.public_key IS DISTINCT FROM OLD.public_key OR NEW.created_at IS DISTINCT FROM OLD.created_at
     OR (OLD.revoked_at IS NOT NULL AND NEW.revoked_at IS DISTINCT FROM OLD.revoked_at) THEN
    RAISE EXCEPTION 'A passkey can only be used or revoked, once' USING ERRCODE = 'NM102';
  END IF;
  IF NEW.sign_count < OLD.sign_count AND NEW.sign_count <> 0 THEN
    RAISE EXCEPTION 'A passkey''s signature counter never goes back: the authenticator may be cloned' USING ERRCODE = 'NM103';
  END IF;
  RETURN NEW;
END
$function$

CREATE OR REPLACE FUNCTION nemura.pay_input_guard()
 RETURNS trigger
 LANGUAGE plpgsql
 SET search_path TO 'pg_catalog', 'nemura', 'pg_temp'
AS $function$
BEGIN
  IF TG_OP = 'DELETE' OR NEW.person_id IS DISTINCT FROM OLD.person_id OR NEW.kind IS DISTINCT FROM OLD.kind OR NEW.days IS DISTINCT FROM OLD.days OR NEW.from_date IS DISTINCT FROM OLD.from_date
     OR NEW.to_date IS DISTINCT FROM OLD.to_date OR NEW.source_type IS DISTINCT FROM OLD.source_type OR NEW.source_id IS DISTINCT FROM OLD.source_id OR NEW.note IS DISTINCT FROM OLD.note
     OR NEW.created_by IS DISTINCT FROM OLD.created_by OR NEW.created_at IS DISTINCT FROM OLD.created_at OR (OLD.used_in_run IS NOT NULL AND (NEW.used_in_run IS DISTINCT FROM OLD.used_in_run OR NEW.used_at IS DISTINCT FROM OLD.used_at)) THEN
    RAISE EXCEPTION 'A pay input is evidence: it is written once and used once' USING ERRCODE = 'NM155';
  END IF;
  RETURN NEW;
END
$function$

CREATE OR REPLACE FUNCTION nemura.person_classification_guard()
 RETURNS trigger
 LANGUAGE plpgsql
 SET search_path TO 'pg_catalog', 'nemura', 'pg_temp'
AS $function$
BEGIN
  IF TG_OP = 'DELETE' OR (TG_OP = 'UPDATE' AND (NEW.person_id IS DISTINCT FROM OLD.person_id OR NEW.effective_from IS DISTINCT FROM OLD.effective_from
     OR NEW.contract_type IS DISTINCT FROM OLD.contract_type OR NEW.ea_covered IS DISTINCT FROM OLD.ea_covered OR NEW.part_iv_class IS DISTINCT FROM OLD.part_iv_class
     OR NEW.residency IS DISTINCT FROM OLD.residency OR NEW.pr_start_date IS DISTINCT FROM OLD.pr_start_date OR NEW.birth_date IS DISTINCT FROM OLD.birth_date
     OR (OLD.effective_to IS NOT NULL AND NEW.effective_to IS DISTINCT FROM OLD.effective_to))) THEN
    RAISE EXCEPTION 'A classification is history: it can only be ended, once' USING ERRCODE = 'NM123';
  END IF;
  IF EXISTS (SELECT 1 FROM nemura.person_classification c
              WHERE c.organisation_id = NEW.organisation_id AND c.person_id = NEW.person_id AND c.id <> NEW.id
                AND daterange(c.effective_from, coalesce(c.effective_to, 'infinity'), '[)') && daterange(NEW.effective_from, coalesce(NEW.effective_to, 'infinity'), '[)')) THEN
    RAISE EXCEPTION 'A person has one classification at a time' USING ERRCODE = 'NM124';
  END IF;
  RETURN NEW;
END
$function$

CREATE OR REPLACE FUNCTION nemura.person_dependant_guard()
 RETURNS trigger
 LANGUAGE plpgsql
 SET search_path TO 'pg_catalog', 'nemura', 'pg_temp'
AS $function$
BEGIN
  IF TG_OP = 'DELETE' OR NEW.person_id IS DISTINCT FROM OLD.person_id OR NEW.relationship IS DISTINCT FROM OLD.relationship OR NEW.birth_date IS DISTINCT FROM OLD.birth_date
     OR NEW.adoption_intent IS DISTINCT FROM OLD.adoption_intent OR NEW.citizenship IS DISTINCT FROM OLD.citizenship OR NEW.effective_from IS DISTINCT FROM OLD.effective_from
     OR NEW.evidence_id IS DISTINCT FROM OLD.evidence_id OR (OLD.effective_to IS NOT NULL AND NEW.effective_to IS DISTINCT FROM OLD.effective_to) THEN
    RAISE EXCEPTION 'A dependant record is history: it can only be ended, once' USING ERRCODE = 'NM128';
  END IF;
  RETURN NEW;
END
$function$

CREATE OR REPLACE FUNCTION nemura.person_guard()
 RETURNS trigger
 LANGUAGE plpgsql
 SET search_path TO 'pg_catalog', 'nemura', 'pg_temp'
AS $function$
BEGIN
  IF TG_OP = 'DELETE' OR NEW.employment_start IS DISTINCT FROM OLD.employment_start OR NEW.created_at IS DISTINCT FROM OLD.created_at
     OR (OLD.member_id IS NOT NULL AND NEW.member_id IS DISTINCT FROM OLD.member_id) THEN
    RAISE EXCEPTION 'A person is never deleted, and their start date and login are set once' USING ERRCODE = 'NM120';
  END IF;
  RETURN NEW;
END
$function$

CREATE OR REPLACE FUNCTION nemura.person_has_leave(p_org uuid, p_person uuid, p_from date, p_to date)
 RETURNS boolean
 LANGUAGE sql
 STABLE
 SET search_path TO 'pg_catalog', 'nemura', 'pg_temp'
AS $function$
  SELECT EXISTS (SELECT 1 FROM nemura.leave_request r WHERE r.organisation_id = p_org AND r.person_id = p_person AND r.state IN ('pending', 'approved')
                   AND daterange(r.start_date, r.end_date, '[]') && daterange(p_from, p_to, '[]'))
      OR EXISTS (SELECT 1 FROM nemura.sick_notification s WHERE s.organisation_id = p_org AND s.person_id = p_person
                   AND daterange(s.start_date, s.end_date, '[]') && daterange(p_from, p_to, '[]'))
      OR EXISTS (SELECT 1 FROM nemura.gov_leave g WHERE g.organisation_id = p_org AND g.person_id = p_person
                   AND daterange(g.start_date, g.end_date, '[]') && daterange(p_from, p_to, '[]'))
$function$

CREATE OR REPLACE FUNCTION nemura.person_job_guard()
 RETURNS trigger
 LANGUAGE plpgsql
 SET search_path TO 'pg_catalog', 'nemura', 'pg_temp'
AS $function$
BEGIN
  IF TG_OP = 'DELETE' OR (TG_OP = 'UPDATE' AND (NEW.person_id IS DISTINCT FROM OLD.person_id OR NEW.effective_from IS DISTINCT FROM OLD.effective_from
     OR NEW.job_title IS DISTINCT FROM OLD.job_title OR NEW.department IS DISTINCT FROM OLD.department OR NEW.worksite IS DISTINCT FROM OLD.worksite
     OR NEW.employment_type IS DISTINCT FROM OLD.employment_type OR NEW.manager_person_id IS DISTINCT FROM OLD.manager_person_id
     OR (OLD.effective_to IS NOT NULL AND NEW.effective_to IS DISTINCT FROM OLD.effective_to))) THEN
    RAISE EXCEPTION 'A job record is history: it can only be ended, once' USING ERRCODE = 'NM121';
  END IF;
  IF EXISTS (SELECT 1 FROM nemura.person_job j
              WHERE j.organisation_id = NEW.organisation_id AND j.person_id = NEW.person_id AND j.id <> NEW.id
                AND daterange(j.effective_from, coalesce(j.effective_to, 'infinity'), '[)') && daterange(NEW.effective_from, coalesce(NEW.effective_to, 'infinity'), '[)')) THEN
    RAISE EXCEPTION 'A person has one job record at a time' USING ERRCODE = 'NM122';
  END IF;
  RETURN NEW;
END
$function$

CREATE OR REPLACE FUNCTION nemura.replace_member_identities(p_member uuid, p_issuer text, p_subject text, p_tenant text)
 RETURNS integer
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'pg_catalog', 'nemura', 'pg_temp'
AS $function$
DECLARE
  org uuid := nemura.require_org();
  replaced integer;
  holder uuid;
BEGIN
  IF NOT EXISTS (SELECT 1 FROM nemura.owner_recovery r WHERE r.organisation_id = org AND r.member_id = p_member AND r.used_xact = pg_current_xact_id()::text::bigint) THEN
    RAISE EXCEPTION 'Sign-ins are replaced only by a recovery used in this transaction' USING ERRCODE = 'NM112';
  END IF;
  SELECT member_id INTO holder FROM nemura.identity_directory WHERE issuer = p_issuer AND subject = p_subject AND tenant = p_tenant AND organisation_id = org;
  IF holder IS NOT NULL AND holder <> p_member THEN
    RAISE EXCEPTION 'That account belongs to another member of the organisation' USING ERRCODE = 'NM112';
  END IF;
  DELETE FROM nemura.identity_directory
   WHERE organisation_id = org AND member_id = p_member AND NOT (issuer = p_issuer AND subject = p_subject AND tenant = p_tenant);
  GET DIAGNOSTICS replaced = ROW_COUNT;
  IF holder IS NULL THEN
    INSERT INTO nemura.identity_directory (issuer, subject, tenant, organisation_id, member_id) VALUES (p_issuer, p_subject, p_tenant, org, p_member);
  END IF;
  RETURN replaced;
END
$function$

CREATE OR REPLACE FUNCTION nemura.reporting_line_guard()
 RETURNS trigger
 LANGUAGE plpgsql
 SET search_path TO 'pg_catalog', 'nemura', 'pg_temp'
AS $function$
BEGIN
  IF TG_OP = 'DELETE' OR NEW.report_id IS DISTINCT FROM OLD.report_id OR NEW.manager_id IS DISTINCT FROM OLD.manager_id
     OR NEW.effective_from IS DISTINCT FROM OLD.effective_from OR (OLD.effective_to IS NOT NULL AND NEW.effective_to IS DISTINCT FROM OLD.effective_to) THEN
    RAISE EXCEPTION 'A reporting line is history: it can only be ended, once' USING ERRCODE = 'NM081';
  END IF;
  RETURN NEW;
END
$function$

CREATE OR REPLACE FUNCTION nemura.require_audit()
 RETURNS trigger
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'pg_catalog', 'nemura', 'pg_temp'
AS $function$
DECLARE
  audited_type text := TG_ARGV[0];
  audited_id   uuid := (to_jsonb(NEW) ->> TG_ARGV[1])::uuid;
BEGIN
  IF NOT EXISTS (
    SELECT 1 FROM nemura.audit_event e
     WHERE e.organisation_id = NEW.organisation_id
       AND e.created_xact = pg_current_xact_id()::text::bigint
       AND e.object_type = audited_type
       AND e.object_id = audited_id) THEN
    RAISE EXCEPTION 'The change to % % has no audit event in its transaction', audited_type, audited_id
      USING ERRCODE = 'NM061',
            HINT = 'Write changes through the unit of work, which records their audit events (AUD-08).';
  END IF;
  RETURN NULL;
END
$function$

CREATE OR REPLACE FUNCTION nemura.require_org()
 RETURNS uuid
 LANGUAGE plpgsql
 STABLE
 SET search_path TO 'pg_catalog', 'nemura', 'pg_temp'
AS $function$
DECLARE
  org uuid := nemura.current_org();
BEGIN
  IF org IS NULL THEN
    RAISE EXCEPTION 'No organisation is set for this transaction'
      USING ERRCODE = 'NM006',
            HINT = 'Run the work through the unit of work, which sets app.org_id first (INV-06).';
  END IF;
  RETURN org;
END
$function$

CREATE OR REPLACE FUNCTION nemura.role_assignment_check()
 RETURNS trigger
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'pg_catalog', 'nemura', 'pg_temp'
AS $function$
BEGIN
  -- Only first-run setup grants with no granter, and only the organisation's first Owner.
  IF NEW.granted_by IS NULL AND EXISTS (SELECT 1 FROM nemura.role_assignment o WHERE o.organisation_id = NEW.organisation_id AND o.role = 'owner') THEN
    RAISE EXCEPTION 'The organisation already has an Owner: another Owner is granted by an Owner and approved by a second Owner'
      USING ERRCODE = 'NM080', HINT = 'First-run setup makes the first Owner, once (NM-ROLE-05).';
  END IF;
  IF NEW.role IN ('payroll_admin', 'owner') AND NEW.granted_by IS NOT NULL THEN
    IF NOT EXISTS (
      SELECT 1 FROM nemura.approval_request a
       WHERE a.organisation_id = NEW.organisation_id AND a.id = NEW.approval_id
         AND a.state = 'approved' AND a.object_type = 'role_assignment' AND a.object_id = NEW.member_id
         AND a.decided_by <> NEW.member_id AND a.decided_by <> NEW.granted_by AND a.requested_by <> NEW.member_id
         AND EXISTS (SELECT 1 FROM nemura.role_assignment o
                      WHERE o.organisation_id = a.organisation_id AND o.member_id = a.decided_by AND o.role = 'owner'
                        AND o.effective_from <= NEW.effective_from AND (o.effective_to IS NULL OR o.effective_to > NEW.effective_from))) THEN
      RAISE EXCEPTION 'The % role needs an approval from an Owner who is not the one asking, granting or receiving it', NEW.role
        USING ERRCODE = 'NM080', HINT = 'Ask for the approval first (NM-ROLE-05).';
    END IF;
  END IF;
  RETURN NEW;
END
$function$

CREATE OR REPLACE FUNCTION nemura.role_assignment_guard()
 RETURNS trigger
 LANGUAGE plpgsql
 SET search_path TO 'pg_catalog', 'nemura', 'pg_temp'
AS $function$
BEGIN
  IF TG_OP = 'DELETE' OR NEW.member_id IS DISTINCT FROM OLD.member_id OR NEW.role IS DISTINCT FROM OLD.role
     OR NEW.effective_from IS DISTINCT FROM OLD.effective_from OR NEW.granted_by IS DISTINCT FROM OLD.granted_by
     OR NEW.approval_id IS DISTINCT FROM OLD.approval_id OR (OLD.effective_to IS NOT NULL AND NEW.effective_to IS DISTINCT FROM OLD.effective_to) THEN
    RAISE EXCEPTION 'A role assignment is history: it can only be ended, once' USING ERRCODE = 'NM081';
  END IF;
  RETURN NEW;
END
$function$

CREATE OR REPLACE FUNCTION nemura.session_guard()
 RETURNS trigger
 LANGUAGE plpgsql
 SET search_path TO 'pg_catalog', 'nemura', 'pg_temp'
AS $function$
BEGIN
  IF TG_OP = 'DELETE' OR NEW.member_id IS DISTINCT FROM OLD.member_id OR NEW.token_hash IS DISTINCT FROM OLD.token_hash
     OR NEW.expires_at IS DISTINCT FROM OLD.expires_at OR (OLD.revoked_at IS NOT NULL AND NEW.revoked_at IS DISTINCT FROM OLD.revoked_at) THEN
    RAISE EXCEPTION 'A session can only be revoked, once, or confirmed again' USING ERRCODE = 'NM101';
  END IF;
  RETURN NEW;
END
$function$

CREATE OR REPLACE FUNCTION nemura.set_setup_code(p_hash bytea)
 RETURNS void
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'pg_catalog', 'nemura', 'pg_temp'
AS $function$
BEGIN
  IF EXISTS (SELECT 1 FROM nemura.installation WHERE setup_completed_at IS NOT NULL) THEN
    RAISE EXCEPTION 'Setup is already done' USING ERRCODE = 'NM100', HINT = 'The first-run setup code works once.';
  END IF;
  INSERT INTO nemura.installation (singleton, setup_code_hash) VALUES (true, p_hash)
    ON CONFLICT (singleton) DO UPDATE SET setup_code_hash = EXCLUDED.setup_code_hash;
END
$function$

CREATE OR REPLACE FUNCTION nemura.setup_done()
 RETURNS boolean
 LANGUAGE sql
 STABLE SECURITY DEFINER
 SET search_path TO 'pg_catalog', 'nemura', 'pg_temp'
AS $function$ SELECT coalesce((SELECT setup_completed_at IS NOT NULL FROM nemura.installation), false) $function$

CREATE OR REPLACE FUNCTION nemura.sick_notification_guard()
 RETURNS trigger
 LANGUAGE plpgsql
 SET search_path TO 'pg_catalog', 'nemura', 'pg_temp'
AS $function$
BEGIN
  IF TG_OP = 'DELETE' THEN
    RAISE EXCEPTION 'A sick leave notification is evidence: it is never deleted' USING ERRCODE = 'NM146';
  END IF;
  IF TG_OP = 'INSERT' THEN
    PERFORM pg_advisory_xact_lock(hashtextextended(NEW.organisation_id::text || NEW.person_id::text, 0));
    IF nemura.person_has_leave(NEW.organisation_id, NEW.person_id, NEW.start_date, NEW.end_date) THEN
      RAISE EXCEPTION 'The person has sick leave or other leave on some of those days' USING ERRCODE = 'NM147';
    END IF;
    RETURN NEW;
  END IF;
  IF NEW.person_id IS DISTINCT FROM OLD.person_id OR NEW.kind IS DISTINCT FROM OLD.kind OR NEW.leave_year IS DISTINCT FROM OLD.leave_year OR NEW.start_date IS DISTINCT FROM OLD.start_date
     OR NEW.end_date IS DISTINCT FROM OLD.end_date OR NEW.days IS DISTINCT FROM OLD.days OR NEW.paid_days IS DISTINCT FROM OLD.paid_days OR NEW.unpaid_days IS DISTINCT FROM OLD.unpaid_days
     OR NEW.late IS DISTINCT FROM OLD.late OR NEW.note IS DISTINCT FROM OLD.note OR NEW.notified_by IS DISTINCT FROM OLD.notified_by OR NEW.notified_at IS DISTINCT FROM OLD.notified_at THEN
    RAISE EXCEPTION 'A sick leave notification is evidence: only its certificate and its verification are added' USING ERRCODE = 'NM146';
  END IF;
  IF OLD.certificate_id IS NOT NULL AND (NEW.certificate_id IS DISTINCT FROM OLD.certificate_id OR NEW.issuer IS DISTINCT FROM OLD.issuer OR NEW.certificate_added_at IS DISTINCT FROM OLD.certificate_added_at) THEN
    RAISE EXCEPTION 'A certificate is given once' USING ERRCODE = 'NM146';
  END IF;
  IF OLD.verified_by IS NOT NULL AND (NEW.verified_by IS DISTINCT FROM OLD.verified_by OR NEW.verified_at IS DISTINCT FROM OLD.verified_at) THEN
    RAISE EXCEPTION 'A certificate is verified once' USING ERRCODE = 'NM146';
  END IF;
  IF NEW.verified_by IS NOT NULL AND OLD.verified_by IS NULL AND EXISTS (SELECT 1 FROM nemura.person p WHERE p.organisation_id = NEW.organisation_id AND p.id = NEW.person_id AND p.member_id = NEW.verified_by) THEN
    RAISE EXCEPTION 'Nobody verifies their own certificate' USING ERRCODE = 'NM148';
  END IF;
  RETURN NEW;
END
$function$

CREATE OR REPLACE FUNCTION nemura.working_pattern_guard()
 RETURNS trigger
 LANGUAGE plpgsql
 SET search_path TO 'pg_catalog', 'nemura', 'pg_temp'
AS $function$
BEGIN
  IF TG_OP = 'DELETE' OR (TG_OP = 'UPDATE' AND (NEW.person_id IS DISTINCT FROM OLD.person_id OR NEW.effective_from IS DISTINCT FROM OLD.effective_from
     OR NEW.weekdays IS DISTINCT FROM OLD.weekdays OR NEW.hours_per_week IS DISTINCT FROM OLD.hours_per_week
     OR (OLD.effective_to IS NOT NULL AND NEW.effective_to IS DISTINCT FROM OLD.effective_to))) THEN
    RAISE EXCEPTION 'A working pattern is history: it can only be ended, once' USING ERRCODE = 'NM140';
  END IF;
  IF EXISTS (SELECT 1 FROM nemura.working_pattern w WHERE w.organisation_id = NEW.organisation_id AND w.person_id = NEW.person_id AND w.id <> NEW.id
               AND daterange(w.effective_from, coalesce(w.effective_to, 'infinity'), '[)') && daterange(NEW.effective_from, coalesce(NEW.effective_to, 'infinity'), '[)')) THEN
    RAISE EXCEPTION 'A person has one working pattern at a time' USING ERRCODE = 'NM141';
  END IF;
  RETURN NEW;
END
$function$


