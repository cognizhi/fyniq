CREATE CONSTRAINT TRIGGER payroll_entry_needs_receipt AFTER INSERT ON fyniq.journal_entry DEFERRABLE INITIALLY DEFERRED FOR EACH ROW WHEN ((new.source_type = 'payroll_run'::text)) EXECUTE FUNCTION payroll_entry_needs_receipt()
