{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "id": {
      "description": "The forecast's ID.",
      "examples": [
        "01928f6e-7a3b-7c41-9d2e-5f8a1b3c9c01"
      ],
      "format": "uuid",
      "type": "string"
    },
    "plan": {
      "$ref": "ForecastPlan.schema.json",
      "description": "Its drivers, plans and scenarios."
    },
    "recorded_at": {
      "description": "When it was recorded.",
      "examples": [
        "2026-11-20T09:30:00Z"
      ],
      "format": "date-time",
      "type": "string"
    },
    "recorded_by": {
      "$ref": "Person.schema.json",
      "description": "Who recorded it."
    },
    "status": {
      "description": "draft: a sandbox to change and run; recorded: the latest recorded, the company's own and Home's; superseded: a later one is recorded.",
      "enum": [
        "draft",
        "recorded",
        "superseded"
      ],
      "examples": [
        "recorded"
      ],
      "type": "string"
    },
    "version": {
      "description": "The version of its content; with its status it makes the ETag.",
      "examples": [
        1
      ],
      "format": "int64",
      "type": "integer"
    }
  },
  "required": [
    "id",
    "status",
    "version",
    "plan"
  ],
  "title": "ForecastView",
  "type": "object"
}
