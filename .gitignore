# OS / editor
.DS_Store
*.swp
.idea/
.vscode/*
!.vscode/extensions.json

# Secrets and local config (never commit)
.env
.env.*
!.env.example
*.pem
*.key
.claude/settings.local.json
.claude/worktrees/

# Build output
dist/
build/
bin/
coverage/
*.out
*.test

# Node / web
node_modules/
.pnpm-store/
.vite/
playwright-report/
test-results/
storybook-static/

# Go
vendor/

# Python (oracle, scripts)
__pycache__/
*.pyc
.pytest_cache/
.venv/
.hypothesis/

# Local data
.data/
*.local.yaml

# OpenTofu (infra/): providers, plans, state and values (billing account, emails) stay out of git; the lock files are committed
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
tfplan
*.tfvars
*.tfvars.json
crash.log

# TypeScript build info from `tsc -b`
*.tsbuildinfo
