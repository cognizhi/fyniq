access_request_item | access_request_item_decision_known | CHECK ((decision = ANY (ARRAY['release'::text, 'redact'::text, 'withhold'::text])))
access_request_item | access_request_item_decision_not_null | NOT NULL decision
access_request_item | access_request_item_exception_for_withhold | CHECK (((decision = 'withhold'::text) = (length(btrim(COALESCE(exception, ''::text))) > 0)))
access_request_item | access_request_item_organisation_id_not_null | NOT NULL organisation_id
access_request_item | access_request_item_pkey | PRIMARY KEY (organisation_id, request_id, category)
