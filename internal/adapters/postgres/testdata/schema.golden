outbox | outbox_kind_not_null | NOT NULL kind
outbox | outbox_last_error_length | CHECK ((length(last_error) <= 2000))
outbox | outbox_lease_whole | CHECK (((lease_holder IS NULL) = (lease_expires_at IS NULL)))
outbox | outbox_max_attempts_not_null | NOT NULL max_attempts
outbox | outbox_organisation_fkey | FOREIGN KEY (organisation_id) REFERENCES organisation(organisation_id)
