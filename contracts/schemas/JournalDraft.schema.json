{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "date": {
      "description": "The date the journal belongs to.",
      "examples": [
        "2026-10-31"
      ],
      "format": "date",
      "type": "string"
    },
    "lines": {
      "description": "Debits positive, credits negative.",
      "items": {
        "$ref": "JournalLineDraft.schema.json"
      },
      "maxItems": 1000,
      "type": [
        "array",
        "null"
      ]
    },
    "memo": {
      "description": "What the journal is for.",
      "examples": [
        "October rent accrual"
      ],
      "maxLength": 1000,
      "type": "string"
    },
    "reverse_on": {
      "description": "For a journal that reverses by itself, such as an accrual (FR-GL-02; PRD-001 rev 0.55): the date the scheduler posts its reversal, after the journal's date, often the first day of the next month. Posting refuses one on or before the journal's date (JOURNAL-11).",
      "examples": [
        "2026-11-01"
      ],
      "format": "date",
      "type": "string"
    }
  },
  "required": [
    "lines"
  ],
  "title": "JournalDraft",
  "type": "object"
}
