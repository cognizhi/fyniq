{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "date": {
      "description": "The books start: the date they post on.",
      "examples": [
        "2026-04-01"
      ],
      "format": "date",
      "type": "string"
    },
    "id": {
      "description": "The document's ID, once saved.",
      "examples": [
        "01928f6e-7a3b-7c41-9d2e-5f8a1b3c4d72"
      ],
      "format": "uuid",
      "type": "string"
    },
    "lines": {
      "description": "The balances as entered.",
      "items": {
        "$ref": "OpeningLine.schema.json"
      },
      "type": "array"
    },
    "memo": {
      "description": "Where the balances come from.",
      "examples": [
        "Balances from the 31 March 2026 trial balance"
      ],
      "type": "string"
    },
    "posted_at": {
      "description": "When they were posted.",
      "examples": [
        "2026-10-21T09:30:00Z"
      ],
      "format": "date-time",
      "type": "string"
    },
    "posted_by": {
      "$ref": "Person.schema.json",
      "description": "Who posted them."
    },
    "prepared_by": {
      "$ref": "Person.schema.json",
      "description": "Who saved the current version."
    },
    "status": {
      "description": "none until they are first saved; then a draft (✎) until posted.",
      "enum": [
        "none",
        "draft",
        "posted",
        "reversed"
      ],
      "examples": [
        "draft"
      ],
      "type": "string"
    },
    "version": {
      "description": "The version of their content; 0 while none is saved.",
      "examples": [
        2
      ],
      "format": "int64",
      "type": "integer"
    }
  },
  "required": [
    "status",
    "version",
    "lines"
  ],
  "title": "OpeningBalances",
  "type": "object"
}
