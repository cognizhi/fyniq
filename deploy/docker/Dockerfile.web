# syntax=docker/dockerfile:1.7
#
# The web app's image, for `make up` and preview environments only; production serves the static
# build from Cloud Storage behind Cloud CDN (PRD-001 §12.3, §12.9).

FROM node:25-alpine@sha256:bdf2cca6fe3dabd014ea60163eca3f0f7015fbd5c7ee1b0e9ccb4ced6eb02ef4 AS build
WORKDIR /src
RUN corepack enable
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY apps/web/package.json apps/web/
RUN --mount=type=cache,target=/root/.local/share/pnpm/store pnpm install --frozen-lockfile --filter @fyniq/web
COPY apps/web apps/web
COPY docs/design-system/fyniq/tokens.css docs/design-system/fyniq/tokens.css
RUN pnpm --filter @fyniq/web build

# Runs as UID 101 on port 8080, with a read-only root filesystem in Compose.
FROM nginxinc/nginx-unprivileged:1.29-alpine@sha256:0c79d56aee561a1d81c63f00eee5fb5fe29279560cdc55e91425133104c7fbe6
COPY deploy/docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY deploy/docker/security-headers.inc /etc/nginx/conf.d/security-headers.inc
COPY --from=build /src/apps/web/dist /usr/share/nginx/html
# The base image already runs as nginx (UID 101); stated here so the image says so itself. The files
# above stay root-owned, so the server cannot change them (NFR-IMG-02).
USER 101
EXPOSE 8080
