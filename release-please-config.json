{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "bump-minor-pre-major": true,
  "bump-patch-for-minor-pre-major": false,
  "include-v-in-tag": true,
  "include-component-in-tag": false,
  "pull-request-title-pattern": "chore(release): release ${version}",
  "pull-request-header": "Release pull request generated by release-please from Conventional Commits. Review it like any other change (PRD-001 REL-04); merging it tags the release.",
  "changelog-sections": [
    { "type": "feat", "section": "Features" },
    { "type": "fix", "section": "Bug fixes" },
    { "type": "perf", "section": "Performance" },
    { "type": "revert", "section": "Reverts" },
    { "type": "docs", "section": "Documentation" },
    { "type": "refactor", "section": "Refactoring" },
    { "type": "build", "section": "Build and images" },
    { "type": "ci", "section": "CI" },
    { "type": "deps", "section": "Dependencies" },
    { "type": "test", "section": "Tests", "hidden": true },
    { "type": "chore", "section": "Chores", "hidden": true }
  ],
  "packages": {
    ".": {
      "package-name": "finance-hub",
      "changelog-path": "CHANGELOG.md",
      "version-file": "VERSION",
      "initial-version": "0.1.0"
    }
  }
}
