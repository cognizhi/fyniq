{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "added_at": {
      "description": "When.",
      "examples": [
        "2026-11-13T09:05:00Z"
      ],
      "format": "date-time",
      "type": "string"
    },
    "added_by": {
      "description": "Who added it: a person, or the validation.",
      "examples": [
        "user:01928f6e-7a3b-7c41-9d2e-5f8a1b3c5e10"
      ],
      "type": "string"
    },
    "data_class": {
      "description": "payroll for a workbook, which holds the pay of each employee, and for a PDF of its reports; general for a Checks export.",
      "enum": [
        "general",
        "payroll"
      ],
      "examples": [
        "payroll"
      ],
      "type": "string"
    },
    "file_name": {
      "description": "As the uploader named it, or checks.csv.",
      "examples": [
        "Cognizhi-Finance-Hub.xlsx"
      ],
      "type": "string"
    },
    "id": {
      "description": "The file.",
      "examples": [
        "01928f6e-7a3b-7c41-9d2e-5f8a1b3c6a30"
      ],
      "format": "uuid",
      "type": "string"
    },
    "kind": {
      "description": "workbook: as uploaded; checks: the Checks export made from one; pdf: a PDF of the workbook's reports, for the archive (M6).",
      "enum": [
        "workbook",
        "checks",
        "pdf"
      ],
      "examples": [
        "workbook"
      ],
      "type": "string"
    },
    "media_type": {
      "description": "Decided from the content.",
      "examples": [
        "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
      ],
      "type": "string"
    },
    "original_sha256": {
      "description": "The SHA-256 of the file as received.",
      "examples": [
        "4d8057dc…"
      ],
      "type": "string"
    },
    "sha256": {
      "description": "The SHA-256 of the file as kept.",
      "examples": [
        "4d8057dc…"
      ],
      "type": "string"
    },
    "size_bytes": {
      "description": "Its size in bytes.",
      "examples": [
        6684378
      ],
      "format": "int64",
      "type": "integer"
    }
  },
  "required": [
    "id",
    "kind",
    "file_name",
    "media_type",
    "size_bytes",
    "sha256",
    "original_sha256",
    "data_class",
    "added_by",
    "added_at"
  ],
  "title": "MigrationFileView",
  "type": "object"
}
