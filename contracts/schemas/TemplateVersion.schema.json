{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "content": {
      "$ref": "TemplateContent.schema.json",
      "description": "What it holds; in a list, absent: read the version for it."
    },
    "content_hash": {
      "description": "The SHA-256 of its content's RFC 8785 JSON, in hex.",
      "examples": [
        "9f86d081884c7d659a2feaa0c55ad015a3bf4f1b2b0b822cd15d6c15b0f00a08"
      ],
      "type": "string"
    },
    "note": {
      "description": "Why it was published.",
      "examples": [
        "New PayNow details"
      ],
      "type": "string"
    },
    "number": {
      "description": "Its number, from 1.",
      "examples": [
        2
      ],
      "format": "int64",
      "type": "integer"
    },
    "published_at": {
      "description": "When.",
      "examples": [
        "2026-10-23T10:00:00Z"
      ],
      "format": "date-time",
      "type": "string"
    },
    "published_by": {
      "$ref": "Person.schema.json",
      "description": "Who published it: the approver, when another person approved it."
    },
    "republished_from": {
      "description": "A rollback: the earlier version whose content it holds.",
      "examples": [
        1
      ],
      "format": "int64",
      "type": "integer"
    }
  },
  "required": [
    "number",
    "content_hash",
    "published_at"
  ],
  "title": "TemplateVersion",
  "type": "object"
}
