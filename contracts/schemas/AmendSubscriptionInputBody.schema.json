{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "effective_on": {
      "description": "The first day of the change: after the contract's last amendment and in an open month.",
      "examples": [
        "2026-04-01"
      ],
      "format": "date",
      "type": "string"
    },
    "kind": {
      "description": "What changes.",
      "enum": [
        "upgrade",
        "downgrade",
        "cancel",
        "renew"
      ],
      "examples": [
        "upgrade"
      ],
      "type": "string"
    },
    "mrr": {
      "description": "The new monthly value from that day, above nothing; left out for a cancellation.",
      "examples": [
        "150.00"
      ],
      "pattern": "^(0|[1-9][0-9]{0,15})(\\.[0-9]{1,4})?$",
      "type": "string"
    },
    "reason": {
      "description": "Why it changes.",
      "examples": [
        "The customer moved to the larger plan"
      ],
      "maxLength": 500,
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "kind",
    "effective_on",
    "reason"
  ],
  "title": "AmendSubscriptionInputBody",
  "type": "object"
}
