{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "checks": {
      "description": "A draft's status: ✖ while no signed decision is attached.",
      "items": {
        "$ref": "BillCheck.schema.json"
      },
      "type": "array"
    },
    "choice": {
      "description": "The choice.",
      "enum": [
        "no_salary",
        "salary_paid",
        "salary_deferred",
        "director_fee",
        "shares_instead_of_pay"
      ],
      "examples": [
        "no_salary"
      ],
      "type": "string"
    },
    "contact_id": {
      "description": "The director or shareholder.",
      "examples": [
        "01928f6e-7a3b-7c41-9d2e-5f8a1b3c4c11"
      ],
      "format": "uuid",
      "type": "string"
    },
    "decisions": {
      "description": "How many files are attached and not removed: recording needs one, the signed decision.",
      "examples": [
        1
      ],
      "format": "int64",
      "type": "integer"
    },
    "from": {
      "description": "The first day of the month it applies from.",
      "examples": [
        "2026-01-01"
      ],
      "format": "date",
      "type": "string"
    },
    "id": {
      "description": "Its ID.",
      "examples": [
        "01928f6e-7a3b-7c41-9d2e-5f8a1b3c4fc1"
      ],
      "format": "uuid",
      "type": "string"
    },
    "legal_name": {
      "description": "Their name.",
      "examples": [
        "Mei Lin Tan"
      ],
      "type": "string"
    },
    "note": {
      "description": "Its note.",
      "examples": [
        "Board minute of 2 Jan 2026: no salary until the seed round."
      ],
      "type": "string"
    },
    "recorded_at": {
      "description": "When it was recorded.",
      "examples": [
        "2026-01-02T09:30:00Z"
      ],
      "format": "date-time",
      "type": "string"
    },
    "recorded_by": {
      "$ref": "Person.schema.json",
      "description": "Who recorded it."
    },
    "status": {
      "description": "draft: waiting for its signed decision to be attached and recorded; recorded: in force from its month until a later one.",
      "enum": [
        "draft",
        "recorded"
      ],
      "examples": [
        "recorded"
      ],
      "type": "string"
    },
    "version": {
      "description": "The version of its content; with its status it makes the ETag.",
      "examples": [
        1
      ],
      "format": "int64",
      "type": "integer"
    }
  },
  "required": [
    "id",
    "status",
    "version",
    "contact_id",
    "legal_name",
    "from",
    "choice",
    "decisions",
    "checks"
  ],
  "title": "DirectorPayChoice",
  "type": "object"
}
