{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "number": {
      "description": "Its number, EQ-, once approved.",
      "examples": [
        "EQ-0004"
      ],
      "type": "string"
    },
    "status": {
      "description": "draft: drafted for approval; approved: waiting for ACRA's date; effective: its shares were allotted.",
      "enum": [
        "draft",
        "approved",
        "effective"
      ],
      "examples": [
        "effective"
      ],
      "type": "string"
    },
    "transaction_id": {
      "description": "The instrument_conversion equity transaction.",
      "examples": [
        "01928f6e-7a3b-7c41-9d2e-5f8a1b3c6a31"
      ],
      "format": "uuid",
      "type": "string"
    }
  },
  "required": [
    "transaction_id",
    "status"
  ],
  "title": "InstrumentConversionRef",
  "type": "object"
}
