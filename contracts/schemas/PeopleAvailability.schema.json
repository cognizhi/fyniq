{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "days": {
      "description": "The days of leave, a decimal string.",
      "examples": [
        "3.5"
      ],
      "pattern": "^[0-9]{1,3}(\\.[0-9]{1,2})?$",
      "type": "string"
    },
    "end_date": {
      "description": "The last day away.",
      "examples": [
        "2026-12-24"
      ],
      "format": "date",
      "type": "string"
    },
    "end_half": {
      "description": "The last day is a half day.",
      "examples": [
        false
      ],
      "type": "boolean"
    },
    "entry_id": {
      "description": "Nemura's leave entry.",
      "examples": [
        "01928f6e-7a3b-7c41-9d2e-5f8a1b3c4e01"
      ],
      "format": "uuid",
      "type": "string"
    },
    "person_id": {
      "description": "The person, as in the projection.",
      "examples": [
        "01928f6e-7a3b-7c41-9d2e-5f8a1b3c4e02"
      ],
      "format": "uuid",
      "type": "string"
    },
    "person_name": {
      "description": "The person's name in the projection.",
      "examples": [
        "Ana Lim"
      ],
      "type": "string"
    },
    "start_date": {
      "description": "The first day away.",
      "examples": [
        "2026-12-21"
      ],
      "format": "date",
      "type": "string"
    },
    "start_half": {
      "description": "The first day is a half day.",
      "examples": [
        false
      ],
      "type": "boolean"
    }
  },
  "required": [
    "entry_id",
    "person_id",
    "start_date",
    "end_date",
    "start_half",
    "end_half",
    "days"
  ],
  "title": "PeopleAvailability",
  "type": "object"
}
