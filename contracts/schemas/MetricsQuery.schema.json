{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "by": {
      "description": "The dimension to split it by, which the measure must offer.",
      "enum": [
        "account",
        "customer",
        "vendor",
        "department",
        "project"
      ],
      "examples": [
        "customer"
      ],
      "type": "string"
    },
    "from": {
      "description": "The first month, YYYY-MM; left out, the last month's.",
      "examples": [
        "2026-07"
      ],
      "pattern": "^[0-9]{4}-[0-9]{2}$",
      "type": "string"
    },
    "grain": {
      "default": "total",
      "description": "month: a fact a month; total: one over the months, a flow summed, a stock at the last month's end.",
      "enum": [
        "month",
        "total"
      ],
      "examples": [
        "total"
      ],
      "type": "string"
    },
    "measure": {
      "description": "A measure of the semantic layer (AI-03).",
      "enum": [
        "revenue",
        "gross_profit",
        "ebitda",
        "net_profit",
        "costs",
        "spend_sm",
        "spend_rd",
        "spend_ga",
        "net_burn",
        "cash",
        "receivables",
        "payables",
        "current_assets",
        "current_liabilities",
        "total_liabilities",
        "equity",
        "project_minutes",
        "account_movement",
        "account_balance",
        "gross_margin",
        "ebitda_margin",
        "net_margin",
        "revenue_growth",
        "booked_mrr",
        "arr",
        "runway",
        "burn_multiple",
        "current_ratio",
        "quick_ratio",
        "working_capital",
        "dso",
        "dpo"
      ],
      "examples": [
        "revenue"
      ],
      "type": "string"
    },
    "member": {
      "description": "Keep one member of the dimension: its ID (an account's code too).",
      "examples": [
        "0193a3f2-7c1e-7a2b-9c4d-5e6f70819a2b"
      ],
      "maxLength": 60,
      "type": "string"
    },
    "revision": {
      "description": "Read the ledger as at this revision (FR-RPT-08); 0 or left out, as it stands.",
      "examples": [
        1204
      ],
      "format": "int64",
      "minimum": 0,
      "type": "integer"
    },
    "to": {
      "description": "The last month, YYYY-MM; left out, the month of the organisation's today.",
      "examples": [
        "2026-09"
      ],
      "pattern": "^[0-9]{4}-[0-9]{2}$",
      "type": "string"
    }
  },
  "required": [
    "measure"
  ],
  "title": "MetricsQuery",
  "type": "object"
}
