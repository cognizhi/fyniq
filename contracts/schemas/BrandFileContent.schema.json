{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "content_base64": {
      "description": "The file, in base64: show it as an image, never inline as markup.",
      "examples": [
        "PHN2ZyB4bWxucz0i"
      ],
      "type": "string"
    },
    "kind": {
      "enum": [
        "light",
        "dark",
        "icon",
        "print"
      ],
      "examples": [
        "light"
      ],
      "type": "string"
    },
    "media_type": {
      "enum": [
        "image/svg+xml",
        "image/png"
      ],
      "examples": [
        "image/svg+xml"
      ],
      "type": "string"
    },
    "sha256": {
      "examples": [
        "9f86d081884c7d659a2feaa0c55ad015a3bf4f1b2b0b822cd15d6c15b0f00a08"
      ],
      "type": "string"
    },
    "version": {
      "examples": [
        2
      ],
      "format": "int64",
      "type": "integer"
    }
  },
  "required": [
    "kind",
    "version",
    "media_type",
    "sha256",
    "content_base64"
  ],
  "title": "BrandFileContent",
  "type": "object"
}
