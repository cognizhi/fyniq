# One origin for the web app and the services, as behind the production load balancer
# (PRD-001 §12.2 "Edge for local and preview", §12.8). `make up` serves it on
# http://localhost:8080 (FYNIQ_HTTP_PORT). The OAuth server is under /oauth/ (its issuer is
# http://localhost:8080/oauth/), and its login and consent pages are the API's /api/auth/….
{
	auto_https off
	admin off
}

:8080 {
	encode zstd gzip

	# The API's routes have no /api prefix; the web app calls /api/… on its own origin. Caddy names the client, as the
	# load balancer does, for the per-IP limits (SEC-23); whatever the client sent in that header is replaced.
	# The API's internal operations are the AI service's alone, on the Compose network: never through the edge (PRD-001
	# §9.3 rev 0.277; Cloud Armor refuses them in the cloud).
	handle /api/internal/* {
		respond 404
	}
	handle_path /api/* {
		reverse_proxy api:8080 {
			header_up X-Fyniq-Client-IP {remote_host}
		}
	}
	# The OAuth server's public endpoints (authorise, token, revoke, discovery); its admin port is internal.
	handle_path /oauth/* {
		reverse_proxy oauth:4444
	}
	handle_path /ai/* {
		reverse_proxy ai:8080 {
			flush_interval -1
		}
	}
	handle /mcp* {
		reverse_proxy mcp:8080 {
			flush_interval -1
		}
	}
	handle {
		reverse_proxy web:8080
	}

	header {
		-Server
	}
}
