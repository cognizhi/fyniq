{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "event_id": {
      "description": "The event's ID.",
      "examples": [
        "01928f6e-7a3b-7c41-9d2e-5f8a1b3c4d77"
      ],
      "format": "uuid",
      "type": "string"
