{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "attested_at": {
      "description": "When the month was attested and closed.",
      "examples": [
        "2026-10-12T02:00:00Z"
      ],
      "format": "date-time",
      "type": "string"
    },
    "id": {
      "description": "The close's ID.",
      "examples": [
        "01928f6e-7a3b-7c41-9d2e-5f8a1b3c5f30"
      ],
      "format": "uuid",
      "type": "string"
    },
    "snapshot_sha256": {
      "description": "The SHA-256 of the close's snapshot, the trial balance at the month end (AUD-04), in hexadecimal.",
      "examples": [
        "9f86d081884c7d659a2feaa0c55ad015a3bf4f1b2b0b822cd15d6c15b0f00a08"
      ],
      "type": "string"
    }
  },
  "required": [
    "id",
    "attested_at",
    "snapshot_sha256"
  ],
  "title": "ReviewClose",
  "type": "object"
}
