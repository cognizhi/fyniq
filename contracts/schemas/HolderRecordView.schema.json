{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "approval_id": {
      "description": "The approval request waiting, if one is.",
      "examples": [
        "01928f6e-7a3b-7c41-9d2e-5f8a1b3c5e31"
      ],
      "format": "uuid",
      "type": "string"
    },
    "checks": {
      "description": "A draft's status: ✖ while no evidence is attached.",
      "items": {
        "$ref": "BillCheck.schema.json"
      },
      "type": "array"
    },
    "contact_id": {
      "description": "The holder.",
      "examples": [
        "01928f6e-7a3b-7c41-9d2e-5f8a1b3c4c11"
      ],
      "format": "uuid",
      "type": "string"
    },
    "details": {
      "$ref": "HolderRecordDraft.schema.json",
      "description": "The holder's details."
    },
    "evidence": {
      "description": "How many files are attached and not removed: asking for approval needs one, such as the identity document.",
      "examples": [
        1
      ],
      "format": "int64",
      "type": "integer"
    },
    "id": {
      "description": "The record's ID.",
      "examples": [
        "01928f6e-7a3b-7c41-9d2e-5f8a1b3c5e21"
      ],
      "format": "uuid",
      "type": "string"
    },
    "masked": {
      "description": "true when the caller reads it masked (Appendix D's M): the identifier, address, contact people and note are left out.",
      "examples": [
        false
      ],
      "type": "boolean"
    },
    "recorded_at": {
      "description": "When it was recorded.",
      "examples": [
        "2026-11-07T09:30:00Z"
      ],
      "format": "date-time",
      "type": "string"
    },
    "recorded_by": {
      "$ref": "Person.schema.json",
      "description": "Who approved it, as it was recorded."
    },
    "status": {
      "description": "draft: waiting for its identity document and approval; recorded: in force; superseded: a later record is in force.",
      "enum": [
        "draft",
        "recorded",
        "superseded"
      ],
      "examples": [
        "recorded"
      ],
      "type": "string"
    },
    "version": {
      "description": "The version of its content; with its status it makes the ETag.",
      "examples": [
        1
      ],
      "format": "int64",
      "type": "integer"
    }
  },
  "required": [
    "id",
    "contact_id",
    "status",
    "version",
    "details",
    "evidence",
    "checks"
  ],
  "title": "HolderRecordView",
  "type": "object"
}
