{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "holder_id": {
      "description": "The holder.",
      "examples": [
        "01928f6e-7a3b-7c41-9d2e-5f8a1b3c4c11"
      ],
      "format": "uuid",
      "type": "string"
    },
    "holder_name": {
      "description": "Their name.",
      "examples": [
        "Seedling Ventures Pte. Ltd."
      ],
      "type": "string"
    },
    "invested": {
      "$ref": "Money.schema.json",
      "description": "The money invested in the class that is theirs: the class's issues shared by shares (ALLOC-PRORATA)."
    },
    "shares": {
      "description": "Their shares of the class, as converted.",
      "examples": [
        "1500000"
      ],
      "type": "string"
    },
    "total": {
      "$ref": "Money.schema.json",
      "description": "What they receive."
    }
  },
  "required": [
    "holder_id",
    "holder_name",
    "shares",
    "invested",
    "total"
  ],
  "title": "WaterfallHolderView",
  "type": "object"
}
