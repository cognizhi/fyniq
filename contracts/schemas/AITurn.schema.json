{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "answer": {
      "description": "The answer as the person reads it, in Fyniq's Markdown subset.",
      "examples": [
        "Cash lasts 18.0 months."
      ],
      "type": "string"
    },
    "answered_at": {
      "examples": [
        "2026-11-15T08:00:04Z"
      ],
      "format": "date-time",
      "type": "string"
    },
    "asked_at": {
      "examples": [
        "2026-11-15T08:00:00Z"
      ],
      "format": "date-time",
      "type": "string"
    },
    "cited": {
      "description": "The facts the answer cites, each with its source and lineage (AI-68).",
      "items": {
        "$ref": "AIFact.schema.json"
      },
      "type": "array"
    },
    "code": {
      "description": "What stopped it.",
      "examples": [
        "AI-ROUTE-05"
      ],
      "type": "string"
    },
    "context": {
      "$ref": "AITurnContext.schema.json"
    },
    "feedback": {
      "$ref": "AITurnRating.schema.json",
      "description": "Your rating of its answer, once given (QA-AI-05)."
    },
    "id": {
      "examples": [
        "0193a3f2-7c1e-7a2b-9c4d-5e6f70819a2c"
      ],
      "format": "uuid",
      "type": "string"
    },
    "question": {
      "examples": [
        "What is our cash runway?"
      ],
      "type": "string"
    },
    "regenerated": {
      "description": "true when the answer failed the figures' check once and was asked for again (AI-08).",
      "examples": [
        false
      ],
      "type": "boolean"
    },
    "segments": {
      "items": {
        "$ref": "AISegment.schema.json"
      },
      "type": "array"
    },
    "sources": {
      "description": "The guide pages the answer's explanations come from (AI-51), which you can open.",
      "items": {
        "$ref": "AISource.schema.json"
      },
      "type": "array"
    },
    "status": {
      "description": "answering until it ends; refused with the code of what stopped it; failed when the AI service did not finish.",
      "enum": [
        "answering",
        "answered",
        "refused",
        "failed"
      ],
      "examples": [
        "answered"
      ],
      "type": "string"
    },
    "withheld": {
      "description": "Figures or words withheld because they still failed the check.",
      "examples": [
        0
      ],
      "format": "int64",
      "type": "integer"
    }
  },
  "required": [
    "id",
    "question",
    "status",
    "segments",
    "cited",
    "sources",
    "regenerated",
    "withheld",
    "asked_at"
  ],
  "title": "AITurn",
  "type": "object"
}
