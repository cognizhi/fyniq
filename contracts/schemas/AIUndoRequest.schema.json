{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "proposal_id": {
      "description": "The executed proposal to undo.",
      "examples": [
        "0193a3c2-6d0e-7a1b-9c4d-5e6f7a8b9c0d"
      ],
      "format": "uuid",
      "type": "string"
    },
    "reason": {
      "description": "Why it is undone: the audit trail and the undo's record keep it.",
      "examples": [
        "The supplier credited the bill"
      ],
      "maxLength": 500,
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "proposal_id",
    "reason"
  ],
  "title": "AIUndoRequest",
  "type": "object"
}
