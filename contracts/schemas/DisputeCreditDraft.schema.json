{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "credit_note_id": {
      "description": "The issued credit note that credits the disputed charge's invoice, whose credit is settled.",
      "examples": [
        "01928f6e-7a3b-7c41-9d2e-5f8a1b3c4b90"
      ],
      "format": "uuid",
      "type": "string"
    },
    "date": {
      "description": "The settlement's date; today when left out.",
      "examples": [
        "2026-11-19"
      ],
      "format": "date",
      "type": "string"
    },
    "money_account_id": {
      "description": "The provider's clearing money account the dispute is on.",
      "examples": [
        "01928f6e-7a3b-7c41-9d2e-5f8a1b3c4b10"
      ],
      "format": "uuid",
      "type": "string"
    }
  },
  "required": [
    "money_account_id",
    "credit_note_id"
  ],
  "title": "DisputeCreditDraft",
  "type": "object"
}
