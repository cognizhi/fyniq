{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "amount": {
      "$ref": "Money.schema.json",
      "description": "What it settled of the credit, in its currency."
    },
    "approval_asked": {
      "description": "The pending request to void it.",
      "examples": [
        "01928f6e-7a3b-7c41-9d2e-5f8a1b3c4dd4"
      ],
      "format": "uuid",
      "type": "string"
    },
    "cleared": {
      "$ref": "Money.schema.json",
      "description": "The credit's carrying amount it cleared, in the base currency."
    },
    "credit": {
      "$ref": "CustomerAppliedDocument.schema.json",
      "description": "The credit it settles."
    },
    "date": {
      "description": "The day the money left.",
      "examples": [
        "2026-10-22"
      ],
      "format": "date",
      "type": "string"
    },
    "fx_rate": {
      "description": "The rate typed, if one was.",
      "examples": [
        "1.34"
      ],
      "type": "string"
    },
    "id": {
      "description": "The refund's ID.",
      "examples": [
        "01928f6e-7a3b-7c41-9d2e-5f8a1b3c4f90"
      ],
      "format": "uuid",
      "type": "string"
    },
    "ledger_impact": {
      "description": "The lines its entry wrote.",
      "items": {
        "$ref": "EntryLine.schema.json"
      },
      "type": "array"
    },
    "money_account": {
      "$ref": "BillPaymentAccount.schema.json",
      "description": "The account it left."
    },
    "number": {
      "description": "Its number from the customer refund sequence (FR-ORG-04).",
      "examples": [
        "CR-0001"
      ],
      "type": "string"
    },
    "paid": {
      "$ref": "Money.schema.json",
      "description": "What a base-currency account paid for a credit in another currency."
    },
    "realised_fx": {
      "$ref": "Money.schema.json",
      "description": "The realised gain (positive) or loss (negative): what the credit carried less what was paid (ENG-41)."
    },
    "recorded_at": {
      "description": "When it was recorded.",
      "examples": [
        "2026-10-22T09:30:00Z"
      ],
      "format": "date-time",
      "type": "string"
    },
    "recorded_by": {
      "$ref": "Person.schema.json",
      "description": "Who recorded it."
    },
    "reference": {
      "description": "The bank's reference.",
      "examples": [
        "FAST 77120"
      ],
      "type": "string"
    },
    "status": {
      "description": "posted once recorded; reversed by a void.",
      "enum": [
        "posted",
        "reversed"
      ],
      "examples": [
        "posted"
      ],
      "type": "string"
    },
    "version": {
      "description": "The version of its content; with the status it makes the ETag.",
      "examples": [
        1
      ],
      "format": "int64",
      "type": "integer"
    }
  },
  "required": [
    "id",
    "status",
    "version",
    "credit",
    "date",
    "amount",
    "cleared",
    "realised_fx",
    "ledger_impact"
  ],
  "title": "CustomerRefund",
  "type": "object"
}
