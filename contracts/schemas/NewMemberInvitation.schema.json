{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "display_name": {
      "description": "The name of the person you invite.",
      "examples": [
        "Wei Ling Tan"
      ],
      "maxLength": 200,
      "type": "string"
    },
    "roles": {
      "description": "The roles they will hold (PRD-001 §6.2).",
      "items": {
        "description": "A role of PRD-001 §7.1, such as owner, accountant or bookkeeper.",
        "examples": [
          "owner"
        ],
        "type": "string"
      },
      "maxItems": 16,
      "minItems": 1,
      "type": [
        "array",
        "null"
      ]
    },
    "roles_expire_at": {
      "description": "For an external user, such as an auditor: when their roles end. Never on the Owner role.",
      "examples": [
        "2027-03-31T00:00:00Z"
      ],
      "format": "date-time",
      "type": "string"
    }
  },
  "required": [
    "display_name",
    "roles"
  ],
  "title": "NewMemberInvitation",
  "type": "object"
}
