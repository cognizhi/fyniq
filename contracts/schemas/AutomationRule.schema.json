{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "action": {
      "description": "What it does: tells the recipients. It is the only action: no rule posts, approves, pays or files.",
      "enum": [
        "notify"
      ],
      "examples": [
        "notify"
      ],
      "type": "string"
    },
    "amount_at_least": {
      "description": "The debits in the base currency from which it fires, with four decimals as kept; absent for any amount.",
      "examples": [
        "5000.0000"
      ],
      "type": "string"
    },
    "created_at": {
      "description": "When it was made.",
      "examples": [
        "2026-11-21T09:00:00Z"
      ],
      "format": "date-time",
      "type": "string"
    },
    "document_type": {
      "description": "The kind of document it watches; absent for any.",
      "examples": [
        "bill"
      ],
      "type": "string"
    },
    "id": {
      "description": "The rule's ID.",
      "examples": [
        "01928f6e-7a3b-7c41-9d2e-5f8a1b3c9a01"
      ],
      "format": "uuid",
      "type": "string"
    },
    "name": {
      "description": "The rule's name.",
      "examples": [
        "Large bills"
      ],
      "type": "string"
    },
    "recipients": {
      "description": "The members told.",
      "items": {
        "description": "A member's user ID.",
        "examples": [
          "01928f6e-7a3b-7c41-9d2e-5f8a1b3c4d02"
        ],
        "format": "uuid",
        "type": "string"
      },
      "type": "array"
    },
    "state": {
      "description": "active fires; paused does not and can be resumed; archived is final.",
      "enum": [
        "active",
        "paused",
        "archived"
      ],
      "examples": [
        "active"
      ],
      "type": "string"
    },
    "trigger": {
      "description": "What sets it off: a document of a kind is posted.",
      "enum": [
        "document.posted"
      ],
      "examples": [
        "document.posted"
      ],
      "type": "string"
    },
    "updated_at": {
      "description": "When it last changed.",
      "examples": [
        "2026-11-21T09:00:00Z"
      ],
      "format": "date-time",
      "type": "string"
    },
    "version": {
      "description": "The rule's version; it makes the ETag.",
      "examples": [
        1
      ],
      "format": "int64",
      "type": "integer"
    }
  },
  "required": [
    "id",
    "name",
    "trigger",
    "action",
    "recipients",
    "state",
    "version",
    "created_at",
    "updated_at"
  ],
  "title": "AutomationRule",
  "type": "object"
}
