{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "date": {
      "description": "The study's date, its first version's: the tax rate is sg-cit's headline rate then.",
      "examples": [
        "2026-11-08"
      ],
      "format": "date",
      "type": "string"
    },
    "id": {
      "description": "The study's ID.",
      "examples": [
        "01928f6e-7a3b-7c41-9d2e-5f8a1b3c9e01"
      ],
      "format": "uuid",
      "type": "string"
    },
    "study": {
      "$ref": "StudyPlan.schema.json",
      "description": "Its inputs, as the workbook's sheet."
    },
    "version": {
      "description": "The version of its content; it makes the ETag.",
      "examples": [
        1
      ],
      "format": "int64",
      "type": "integer"
    }
  },
  "required": [
    "id",
    "version",
    "date",
    "study"
  ],
  "title": "FeasibilityStudyView",
  "type": "object"
}
