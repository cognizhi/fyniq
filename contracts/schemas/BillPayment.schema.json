{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "approval_asked": {
      "description": "getBillPayment only: the pending request to void it.",
      "examples": [
        "01928f6e-7a3b-7c41-9d2e-5f8a1b3c4dd1"
      ],
      "format": "uuid",
      "type": "string"
    },
    "bills": {
      "description": "What it settled of each bill, as recorded.",
      "items": {
        "$ref": "BillSettled.schema.json"
      },
      "type": "array"
    },
    "currency": {
      "description": "The bills' currency.",
      "examples": [
        "SGD"
      ],
      "type": "string"
    },
    "date": {
      "description": "The day the money left.",
      "examples": [
        "2026-10-20"
      ],
      "format": "date",
      "type": "string"
    },
    "fx_rate": {
      "description": "The rate typed, if one was.",
      "examples": [
        "1.30"
      ],
      "type": "string"
    },
    "id": {
      "description": "The payment's ID.",
      "examples": [
        "01928f6e-7a3b-7c41-9d2e-5f8a1b3c4e40"
      ],
      "format": "uuid",
      "type": "string"
    },
    "ledger_impact": {
      "description": "getBillPayment only: the lines its entry wrote: debits positive.",
      "items": {
        "$ref": "EntryLine.schema.json"
      },
      "type": "array"
    },
    "money_account": {
      "$ref": "BillPaymentAccount.schema.json",
      "description": "The account it left."
    },
    "notes": {
      "description": "Its notes.",
      "examples": [
        "Paid in two parts"
      ],
      "type": "string"
    },
    "number": {
      "description": "Its number from the payment sequence (FR-ORG-04).",
      "examples": [
        "PAY-0003"
      ],
      "type": "string"
    },
    "paid": {
      "$ref": "Money.schema.json",
      "description": "What a base-currency account paid for bills in another currency."
    },
    "recorded_at": {
      "description": "When it was recorded.",
      "examples": [
        "2026-10-20T09:30:00Z"
      ],
      "format": "date-time",
      "type": "string"
    },
    "recorded_by": {
      "$ref": "Person.schema.json",
      "description": "Who recorded it."
    },
    "reference": {
      "description": "The bank's reference.",
      "examples": [
        "FAST 88231"
      ],
      "type": "string"
    },
    "status": {
      "description": "posted once recorded; reversed by a void.",
      "enum": [
        "posted",
        "reversed"
      ],
      "examples": [
        "posted"
      ],
      "type": "string"
    },
    "supplier": {
      "$ref": "BillSupplier.schema.json",
      "description": "The supplier paid."
    },
    "total": {
      "$ref": "Money.schema.json",
      "description": "What it paid in the bills' currency: every part and the unapplied amount."
    },
    "unapplied": {
      "$ref": "Money.schema.json",
      "description": "What it paid beyond the bills: a credit with the supplier."
    },
    "version": {
      "description": "The version of its content; with the status it makes the ETag.",
      "examples": [
        1
      ],
      "format": "int64",
      "type": "integer"
    }
  },
  "required": [
    "id",
    "status",
    "version",
    "currency",
    "total",
    "unapplied",
    "bills",
    "ledger_impact"
  ],
  "title": "BillPayment",
  "type": "object"
}
