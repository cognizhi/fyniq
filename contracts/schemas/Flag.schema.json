{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "confidence": {
      "description": "How sure the model is, from 0 to 1.",
      "examples": [
        0.9
      ],
      "format": "double",
      "type": "number"
    },
    "value": {
      "description": "The yes or no the document shows; null when it does not show it.",
      "examples": [
        true
      ],
      "type": [
        "boolean",
        "null"
      ]
    }
  },
  "required": [
    "value",
    "confidence"
  ],
  "title": "Flag",
  "type": "object"
}
