{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "accounts": {
      "description": "Accounts in its chart.",
      "examples": [
        60
      ],
      "format": "int64",
      "type": "integer"
    },
    "journals": {
      "description": "Journals posted.",
      "examples": [
        24
      ],
      "format": "int64",
      "type": "integer"
    },
    "periods": {
      "description": "Its accounting periods (2026).",
      "examples": [
        12
      ],
      "format": "int64",
      "type": "integer"
    }
  },
  "required": [
    "accounts",
    "periods",
    "journals"
  ],
  "title": "SandboxSampleCompany",
  "type": "object"
}
