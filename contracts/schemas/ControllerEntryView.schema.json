{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "approval_id": {
      "description": "The approval request waiting, if one is.",
      "examples": [
        "01928f6e-7a3b-7c41-9d2e-5f8a1b3c7c11"
      ],
      "format": "uuid",
      "type": "string"
    },
    "checks": {
      "description": "A draft's status: ✖ while no confirmation is attached.",
      "items": {
        "$ref": "BillCheck.schema.json"
      },
      "type": "array"
    },
    "entry": {
      "$ref": "ControllerEntryDraft.schema.json",
      "description": "The conclusion."
    },
    "evidence": {
      "description": "How many files are attached and not removed: asking for approval needs one, the company secretary's confirmation.",
      "examples": [
        1
      ],
      "format": "int64",
      "type": "integer"
    },
    "holder_id": {
      "description": "The holder.",
      "examples": [
        "01928f6e-7a3b-7c41-9d2e-5f8a1b3c4c11"
      ],
      "format": "uuid",
      "type": "string"
    },
    "holder_name": {
      "description": "Their name.",
      "examples": [
        "Mei Lin Tan"
      ],
      "type": "string"
    },
    "id": {
      "description": "The entry's ID.",
      "examples": [
        "01928f6e-7a3b-7c41-9d2e-5f8a1b3c7c01"
      ],
      "format": "uuid",
      "type": "string"
    },
    "recorded_at": {
      "description": "When it was recorded.",
      "examples": [
        "2027-03-12T09:30:00Z"
      ],
      "format": "date-time",
      "type": "string"
    },
    "recorded_by": {
      "$ref": "Person.schema.json",
      "description": "Who approved it, as it was recorded."
    },
    "status": {
      "description": "draft: waiting for the company secretary's confirmation and approval; recorded: in force; superseded: a later entry is in force.",
      "enum": [
        "draft",
        "recorded",
        "superseded"
      ],
      "examples": [
        "recorded"
      ],
      "type": "string"
    },
    "version": {
      "description": "The version of its content; with its status it makes the ETag.",
      "examples": [
        1
      ],
      "format": "int64",
      "type": "integer"
    }
  },
  "required": [
    "id",
    "holder_id",
    "holder_name",
    "status",
    "version",
    "entry",
    "evidence",
    "checks"
  ],
  "title": "ControllerEntryView",
  "type": "object"
}
