{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "done": {
      "description": "How many tasks are done.",
      "examples": [
        4
      ],
      "format": "int64",
      "type": "integer"
    },
    "open": {
      "description": "How many are neither: the close checks refuse the close while any is (Appendix C.2 #58).",
      "examples": [
        1
      ],
      "format": "int64",
      "type": "integer"
    },
    "period": {
      "$ref": "Period.schema.json"
    },
    "skipped": {
      "description": "How many are skipped for the month.",
      "examples": [
        1
      ],
      "format": "int64",
      "type": "integer"
    },
    "tasks": {
      "description": "Its tasks, in the template's order.",
      "items": {
        "$ref": "ChecklistItem.schema.json"
      },
      "type": "array"
    },
    "template_version": {
      "description": "The template version its tasks come from; 0 for the recommended template.",
      "examples": [
        2
      ],
      "format": "int64",
      "type": "integer"
    }
  },
  "required": [
    "period",
    "template_version",
    "done",
    "skipped",
    "open",
    "tasks"
  ],
  "title": "PeriodChecklist",
  "type": "object"
}
