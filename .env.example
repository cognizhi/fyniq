# Local settings for `make dev` and `make up`; `make setup` copies this to .env (git-ignored).
# Local-only values: none of them is valid anywhere else (SEC-12).
FYNIQ_ENV=local
# FYNIQ_BUSINESS_DATE=2026-12-31        # the business date outside production (DEV-05)
# Host ports for `make dev` and `make up`
FYNIQ_API_PORT=8081
FYNIQ_WEB_PORT=5173
FYNIQ_HTTP_PORT=8080
