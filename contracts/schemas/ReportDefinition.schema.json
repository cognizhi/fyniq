{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "archived": {
      "description": "True when it is archived: it stays for the schedules and packs that named it, and runs no more.",
      "examples": [
        false
      ],
      "type": "boolean"
    },
    "definition": {
      "$ref": "ReportDefinitionBody.schema.json",
      "description": "Its rows, columns and filters."
    },
    "description": {
      "description": "What it is for.",
      "examples": [
        "The board's margin view"
      ],
      "type": "string"
    },
    "id": {
      "description": "The report's ID.",
      "examples": [
        "01928f6e-7a3b-7c41-9d2e-5f8a1b3c5a10"
      ],
      "format": "uuid",
      "type": "string"
    },
    "mine": {
      "description": "True when the caller made it.",
      "examples": [
        true
      ],
      "type": "boolean"
    },
    "name": {
      "description": "Its name, unique among the live reports of the organisation.",
      "examples": [
        "Gross margin by month"
      ],
      "type": "string"
    },
    "owner_id": {
      "description": "The member who made it.",
      "examples": [
        "01928f6e-7a3b-7c41-9d2e-5f8a1b3c4d01"
      ],
      "format": "uuid",
      "type": "string"
    },
    "updated_at": {
      "description": "When it last changed.",
      "examples": [
        "2026-11-23T03:00:00Z"
      ],
      "format": "date-time",
      "type": "string"
    },
    "version": {
      "description": "Its version, which is its ETag.",
      "examples": [
        1
      ],
      "format": "int64",
      "type": "integer"
    },
    "visibility": {
      "description": "private: its owner's alone; shared: every person who may read the whole ledger's reports can run it.",
      "enum": [
        "private",
        "shared"
      ],
      "examples": [
        "shared"
      ],
      "type": "string"
    }
  },
  "required": [
    "id",
    "name",
    "visibility",
    "owner_id",
    "mine",
    "definition",
    "version",
    "updated_at",
    "archived"
  ],
  "title": "ReportDefinition",
  "type": "object"
}
