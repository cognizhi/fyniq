{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "environment": {
      "description": "Where the tick was paused.",
      "enum": [
        "staging",
        "production"
      ],
      "examples": [
        "staging"
      ],
      "type": "string"
    },
    "escalation_minutes": {
      "description": "Minutes after the pause the Owners were alerted; absent when no escalation came.",
      "examples": [
        61
      ],
      "format": "int64",
      "type": "integer"
    },
    "findings": {
      "description": "What it found and what changed.",
      "examples": [
        "The first alert came a minute late: the absence window now starts at the last beat."
      ],
      "type": "string"
    },
    "first_alert_minutes": {
      "description": "Minutes after the pause the platform owner was first alerted; absent when no alert came.",
      "examples": [
        31
      ],
      "format": "int64",
      "type": "integer"
    },
    "held_on": {
      "description": "When it was held.",
      "examples": [
        "2026-11-15"
      ],
      "format": "date",
      "type": "string"
    },
    "id": {
      "description": "The drill.",
      "examples": [
        "01928f6e-7a3b-7c41-9d2e-5f8a1b3c5e10"
      ],
      "format": "uuid",
      "type": "string"
    },
    "passed": {
      "description": "Whether the drill passed: the platform owner told within 30 minutes and the Owners within 60 (NFR-OBS-02).",
      "examples": [
        false
      ],
      "type": "boolean"
    },
    "paused_minutes": {
      "description": "How long the tick was paused, in minutes.",
      "examples": [
        75
      ],
      "format": "int64",
      "type": "integer"
    },
    "recorded_at": {
      "description": "When it was recorded.",
      "examples": [
        "2026-11-15T09:30:00Z"
      ],
      "format": "date-time",
      "type": "string"
    },
    "recorded_by": {
      "description": "Who recorded it, as records name actors.",
      "examples": [
        "user:01928f6e-7a3b-7c41-9d2e-5f8a1b3c5e10"
      ],
      "type": "string"
    }
  },
  "required": [
    "id",
    "held_on",
    "environment",
    "paused_minutes",
    "passed",
    "findings",
    "recorded_by",
    "recorded_at"
  ],
  "title": "HeartbeatDrillView",
  "type": "object"
}
