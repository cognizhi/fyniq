{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "account_id": {
      "description": "The account.",
      "examples": [
        "01928f6e-7a3b-7c41-9d2e-5f8a1b3c4d62"
      ],
      "format": "uuid",
      "type": "string"
    },
    "amount": {
      "$ref": "Money.schema.json",
      "description": "Its balance in the currency."
    },
    "carrying": {
      "$ref": "Money.schema.json",
      "description": "Its value in the books in the base currency."
    },
    "code": {
      "description": "Its code.",
      "examples": [
        "1210"
      ],
      "type": "string"
    },
    "name": {
      "description": "Its name.",
      "examples": [
        "Prepayments"
      ],
      "type": "string"
    }
  },
  "required": [
    "account_id",
    "code",
    "name",
    "amount",
    "carrying"
  ],
  "title": "NotRevaluedBalance",
  "type": "object"
}
