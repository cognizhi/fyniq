{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "allowed_domains": {
      "description": "The email domains it accepts, such as example.com; empty: any.",
      "items": {
        "description": "An email domain, lower case: the part of an address after the @.",
        "examples": [
          "cognizhi.com"
        ],
        "maxLength": 253,
        "type": "string"
      },
      "maxItems": 20,
      "type": [
        "array",
        "null"
      ]
    },
    "enabled": {
      "description": "Whether it signs people in.",
      "examples": [
        false
      ],
      "type": "boolean"
    },
    "end_sessions": {
      "description": "With enabled false: also sign out every session it started, at once.",
      "examples": [
        true
      ],
      "type": "boolean"
    }
  },
  "required": [
    "enabled",
    "allowed_domains"
  ],
  "title": "SignInMethodRequest",
  "type": "object"
}
