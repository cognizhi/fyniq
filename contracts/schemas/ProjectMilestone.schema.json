{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "accepted_on": {
      "description": "The day the customer accepted it.",
      "examples": [
        "2026-12-10"
      ],
      "format": "date",
      "type": "string"
    },
    "amount": {
      "$ref": "Money.schema.json",
      "description": "What it bills, in the project's currency."
    },
    "can_invoice": {
      "description": "true when an invoice can bill it now: accepted (a retainer period needs no acceptance) and not billed.",
      "examples": [
        true
      ],
      "type": "boolean"
    },
    "due_on": {
      "description": "When it is due.",
      "examples": [
        "2026-12-15"
      ],
      "format": "date",
      "type": "string"
    },
    "id": {
      "description": "The milestone.",
      "examples": [
        "01928f6e-7a3b-7c41-9d2e-5f8a1b3c4e91"
      ],
      "format": "uuid",
      "type": "string"
    },
    "invoice_id": {
      "description": "The posted invoice that billed it; absent until one does, and again if that invoice is voided.",
      "examples": [
        "01928f6e-7a3b-7c41-9d2e-5f8a1b3c4ea1"
      ],
      "format": "uuid",
      "type": "string"
    },
    "kind": {
      "description": "milestone: a part of a fixed fee, invoiced once the customer has accepted it; retainer: a period of a retainer, invoiced without acceptance.",
      "enum": [
        "milestone",
        "retainer"
      ],
      "examples": [
        "milestone"
      ],
      "type": "string"
    },
    "name": {
      "description": "What it is.",
      "examples": [
        "Design sign-off"
      ],
      "type": "string"
    },
    "project_id": {
      "description": "Its project.",
      "examples": [
        "01928f6e-7a3b-7c41-9d2e-5f8a1b3c4e31"
      ],
      "format": "uuid",
      "type": "string"
    },
    "version": {
      "description": "For If-Match.",
      "examples": [
        1
      ],
      "format": "int64",
      "type": "integer"
    }
  },
  "required": [
    "id",
    "project_id",
    "kind",
    "name",
    "amount",
    "version",
    "can_invoice"
  ],
  "title": "ProjectMilestone",
  "type": "object"
}
