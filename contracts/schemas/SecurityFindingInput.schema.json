{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "found_on": {
      "description": "The day it was found; the assessment's last day when left out.",
      "examples": [
        "2026-11-02"
      ],
      "format": "date",
      "type": "string"
    },
    "ref": {
      "description": "The tester's reference.",
      "examples": [
        "PT-2026-07"
      ],
      "maxLength": 40,
      "minLength": 1,
      "type": "string"
    },
    "severity": {
      "description": "How serious.",
      "enum": [
        "critical",
        "high",
        "medium",
        "low",
        "info"
      ],
      "examples": [
        "high"
      ],
      "type": "string"
    },
    "title": {
      "description": "What it is.",
      "examples": [
        "Reflected script in the search page"
      ],
      "maxLength": 300,
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "ref",
    "title",
    "severity"
  ],
  "title": "SecurityFindingInput",
  "type": "object"
}
