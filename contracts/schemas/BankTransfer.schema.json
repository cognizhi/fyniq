{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "date": {
      "description": "The day it left.",
      "examples": [
        "2026-10-20"
      ],
      "format": "date",
      "type": "string"
    },
    "entry_id": {
      "description": "Its entry: each leg at its own currency's rate for the day (ENG-40).",
      "examples": [
        "01928f6e-7a3b-7c41-9d2e-5f8a1b3c4d80"
      ],
      "format": "uuid",
      "type": "string"
    },
    "fee": {
      "$ref": "Money.schema.json",
      "description": "The fee the provider reported."
    },
    "from_line_id": {
      "description": "The paying line; absent while in transit.",
      "examples": [
        "01928f6e-7a3b-7c41-9d2e-5f8a1b3c4b70"
      ],
      "format": "uuid",
      "type": "string"
    },
    "from_money_account_id": {
      "description": "The paying account.",
      "examples": [
        "01928f6e-7a3b-7c41-9d2e-5f8a1b3c4b10"
      ],
      "format": "uuid",
      "type": "string"
    },
    "id": {
      "description": "The transfer's ID.",
      "examples": [
        "01928f6e-7a3b-7c41-9d2e-5f8a1b3c4b90"
      ],
      "format": "uuid",
      "type": "string"
    },
    "made_by": {
      "description": "Who recorded it: a person, or the system.",
      "examples": [
        "user:01928f6e-7a3b-7c41-9d2e-5f8a1b3c4a01"
      ],
      "type": "string"
    },
    "paid": {
      "$ref": "Money.schema.json",
      "description": "What left the paying account."
    },
    "received": {
      "$ref": "Money.schema.json",
      "description": "What reached the receiving account."
    },
    "status": {
      "description": "In transit while a side's line has not arrived.",
      "enum": [
        "in_transit",
        "complete",
        "undone"
      ],
      "examples": [
        "complete"
      ],
      "type": "string"
    },
    "to_line_id": {
      "description": "The receiving line; absent while in transit.",
      "examples": [
        "01928f6e-7a3b-7c41-9d2e-5f8a1b3c4b71"
      ],
      "format": "uuid",
      "type": "string"
    },
    "to_money_account_id": {
      "description": "The receiving account.",
      "examples": [
        "01928f6e-7a3b-7c41-9d2e-5f8a1b3c4b11"
      ],
      "format": "uuid",
      "type": "string"
    },
    "undo_reason": {
      "description": "Why it was undone.",
      "examples": [
        "Two payments, not a transfer"
      ],
      "type": "string"
    },
    "version": {
      "description": "Its version, as its ETag.",
      "examples": [
        2
      ],
      "format": "int64",
      "type": "integer"
    }
  },
  "required": [
    "id",
    "from_money_account_id",
    "to_money_account_id",
    "date",
    "paid",
    "received",
    "status",
    "made_by",
    "version"
  ],
  "title": "BankTransfer",
  "type": "object"
}
