{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "amount": {
      "$ref": "Money.schema.json",
      "description": "What was refunded, in the base currency: at most what is still open on the advance."
    },
    "date": {
      "description": "The day the money came in.",
      "examples": [
        "2026-10-14"
      ],
      "format": "date",
      "type": "string"
    },
    "money_account_id": {
      "description": "The bank, card or wallet account it came into: an active money account in the base currency.",
      "examples": [
        "01928f6e-7a3b-7c41-9d2e-5f8a1b3c4d10"
      ],
      "format": "uuid",
      "type": "string"
    },
    "notes": {
      "description": "Notes kept with it.",
      "examples": [
        "Balance of the Jakarta advance"
      ],
      "maxLength": 2000,
      "type": "string"
    },
    "reference": {
      "description": "The bank's reference for it.",
      "examples": [
        "FAST 80211"
      ],
      "maxLength": 140,
      "type": "string"
    }
  },
  "required": [
    "date",
    "money_account_id",
    "amount"
  ],
  "title": "CashAdvanceRefundDraft",
  "type": "object"
}
