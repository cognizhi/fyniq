{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "format": {
      "description": "The format it reads.",
      "enum": [
        "csv",
        "xlsx"
      ],
      "examples": [
        "csv"
      ],
      "type": "string"
    },
    "id": {
      "description": "The mapping's ID.",
      "examples": [
        "01928f6e-7a3b-7c41-9d2e-5f8a1b3c4b30"
      ],
      "format": "uuid",
      "type": "string"
    },
    "institution": {
      "description": "The bank it is for.",
      "examples": [
        "DBS"
      ],
      "type": "string"
    },
    "name": {
      "description": "Its name.",
      "examples": [
        "DBS IDEAL CSV"
      ],
      "type": "string"
    },
    "spec": {
      "$ref": "StatementMappingSpec.schema.json",
      "description": "How the columns read."
    },
    "version": {
      "description": "Its version, for If-Match.",
      "examples": [
        1
      ],
      "format": "int64",
      "type": "integer"
    }
  },
  "required": [
    "id",
    "name",
    "format",
    "spec",
    "version"
  ],
  "title": "StatementMapping",
  "type": "object"
}
