{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "expires_at": {
      "description": "Until when it can be downloaded: 24 hours after it was ready.",
      "examples": [
        "2026-11-01T09:00:05Z"
      ],
      "format": "date-time",
      "type": "string"
    },
    "file_name": {
      "description": "Its file's name, once ready.",
      "examples": [
        "general-ledger-2026-10-01-to-2026-10-31.xlsx"
      ],
      "type": "string"
    },
    "format": {
      "description": "csv or xlsx.",
      "examples": [
        "xlsx"
      ],
      "type": "string"
    },
    "from": {
      "description": "The first day, for a range.",
      "examples": [
        "2026-10-01"
      ],
      "format": "date",
      "type": "string"
    },
    "id": {
      "description": "The export.",
      "examples": [
        "01928f6e-7a3b-7c41-9d2e-5f8a1b3c4d90"
      ],
      "format": "uuid",
      "type": "string"
    },
    "ledger_revision": {
      "description": "The ledger revision it read the books at (FR-RPT-08).",
      "examples": [
        42
      ],
      "format": "int64",
      "type": "integer"
    },
    "media_type": {
      "description": "Its type.",
      "examples": [
        "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
      ],
      "type": "string"
    },
    "ready_at": {
      "description": "When it was ready.",
      "examples": [
        "2026-10-31T09:00:05Z"
      ],
      "format": "date-time",
      "type": "string"
    },
    "report": {
      "description": "What it exports.",
      "examples": [
        "general_ledger"
      ],
      "type": "string"
    },
    "requested_at": {
      "description": "When it was asked for.",
      "examples": [
        "2026-10-31T09:00:00Z"
      ],
      "format": "date-time",
      "type": "string"
    },
    "rows": {
      "description": "The rows it holds.",
      "examples": [
        512
      ],
      "format": "int64",
      "type": "integer"
    },
    "sha256": {
      "description": "The SHA-256 of the file, in hexadecimal, as the audit trail records it.",
      "examples": [
        "9f86d081884c7d659a2feaa0c55ad015a3bf4f1b2b0b822cd15d6c15b0f00a08"
      ],
      "type": "string"
    },
    "size_bytes": {
      "description": "Its size, in bytes.",
      "examples": [
        40960
      ],
      "format": "int64",
      "type": "integer"
    },
    "status": {
      "description": "pending: the worker is preparing it; ready: download it until expires_at; failed: why says why; expired: its 24 hours are up, and its file is gone.",
      "enum": [
        "pending",
        "ready",
        "failed",
        "expired"
      ],
      "examples": [
        "ready"
      ],
      "type": "string"
    },
    "to": {
      "description": "The last day, or the day it is as at.",
      "examples": [
        "2026-10-31"
      ],
      "format": "date",
      "type": "string"
    },
    "why": {
      "description": "Why it failed, and what to do.",
      "examples": [
        "the range crosses the start of a financial year: export each year apart"
      ],
      "type": "string"
    }
  },
  "required": [
    "id",
    "report",
    "format",
    "to",
    "status",
    "requested_at"
  ],
  "title": "ReportExportOut",
  "type": "object"
}
