{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "active": {
      "description": "An inactive group keeps its customers and their schedule, and is given to no other.",
      "examples": [
        true
      ],
      "type": "boolean"
    },
    "id": {
      "description": "The group's ID.",
      "examples": [
        "01928f6e-7a3b-7c41-9d2e-5f8a1b3c4f10"
      ],
      "format": "uuid",
      "type": "string"
    },
    "name": {
      "description": "Its name.",
      "examples": [
        "Retainer clients"
      ],
      "type": "string"
    },
    "reminder_days": {
      "description": "The days, before (negative) or after an invoice's due date, on which an invoice still open is due a reminder, earliest first; none sends none.",
      "examples": [
        [
          -3,
          0,
          7,
          30
        ]
      ],
      "items": {
        "description": "Days from an invoice's due date, negative before it.",
        "examples": [
          7
        ],
        "format": "int32",
        "maximum": 365,
        "minimum": -30,
        "type": "integer"
      },
      "type": "array"
    },
    "version": {
      "description": "The group's version; it makes the ETag.",
      "examples": [
        1
      ],
      "format": "int64",
      "type": "integer"
    }
  },
  "required": [
    "id",
    "name",
    "reminder_days",
    "active",
    "version"
  ],
  "title": "CustomerGroup",
  "type": "object"
}
