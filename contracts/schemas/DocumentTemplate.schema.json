{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "document_type": {
      "description": "The document it serves.",
      "enum": [
        "invoice",
        "quote",
        "credit_note",
        "receipt",
        "statement",
        "reminder",
        "remittance",
        "purchase_order"
      ],
      "examples": [
        "invoice"
      ],
      "type": "string"
    },
    "draft": {
      "$ref": "TemplateContent.schema.json",
      "description": "The draft: what saving changes and publishing makes a version of."
    },
    "draft_changed": {
      "description": "The draft differs from the version in force, or nothing is published yet.",
      "examples": [
        true
      ],
      "type": "boolean"
    },
    "id": {
      "description": "The template's ID.",
      "examples": [
        "01928f6e-7a3b-7c41-9d2e-5f8a1b3c4f10"
      ],
      "format": "uuid",
      "type": "string"
    },
    "kind": {
      "description": "document: the PDF; email: the message that carries it.",
      "enum": [
        "document",
        "email"
      ],
      "examples": [
        "document"
      ],
      "type": "string"
    },
    "name": {
      "description": "Its name.",
      "examples": [
        "Standard invoice"
      ],
      "type": "string"
    },
    "published_version": {
      "description": "The number of the version in force; absent until the first is published.",
      "examples": [
        2
      ],
      "format": "int64",
      "type": "integer"
    },
    "saved_at": {
      "description": "When.",
      "examples": [
        "2026-10-23T09:30:00Z"
      ],
      "format": "date-time",
      "type": "string"
    },
    "saved_by": {
      "$ref": "Person.schema.json",
      "description": "Who saved the draft last."
    },
    "version": {
      "description": "The version of the template, which saving the draft and publishing move forward; its ETag.",
      "examples": [
        3
      ],
      "format": "int64",
      "type": "integer"
    }
  },
  "required": [
    "id",
    "kind",
    "document_type",
    "name",
    "version",
    "draft",
    "draft_changed",
    "saved_at"
  ],
  "title": "DocumentTemplate",
  "type": "object"
}
