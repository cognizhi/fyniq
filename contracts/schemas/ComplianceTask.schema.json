{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "closed_at": {
      "examples": [
        "2026-11-20T02:00:00Z"
      ],
      "format": "date-time",
      "type": "string"
    },
    "closed_by": {
      "description": "Who marked it done or dismissed it.",
      "examples": [
        "0193a3c2-6d0e-7a1b-9c4d-5e6f7a8b9c0e"
      ],
      "format": "uuid",
      "type": "string"
    },
    "created_at": {
      "examples": [
        "2026-11-15T23:00:00Z"
      ],
      "format": "date-time",
      "type": "string"
    },
    "detail": {
      "description": "What to do, why and by when, in the platform's words.",
      "examples": [
        "Due by 31 January 2027 (sg-gst@2026.1)."
      ],
      "type": "string"
    },
    "due_on": {
      "examples": [
        "2027-01-31"
      ],
      "format": "date",
      "type": "string"
    },
    "escalated": {
      "description": "Whether the Owner is told too, as its deadline nears (AI-62).",
      "examples": [
        false
      ],
      "type": "boolean"
    },
    "finding_key": {
      "description": "The finding it is about: one open task per finding.",
      "examples": [
        "calendar:gst_f5:2026-12-31"
      ],
      "type": "string"
    },
    "id": {
      "examples": [
        "0193a3c2-6d0e-7a1b-9c4d-5e6f7a8b9c11"
      ],
      "format": "uuid",
      "type": "string"
    },
    "owner_role": {
      "description": "The role that owns it, when no member does.",
      "examples": [
        "owner"
      ],
      "type": "string"
    },
    "owner_user": {
      "description": "The member who owns it.",
      "examples": [
        "0193a3c2-6d0e-7a1b-9c4d-5e6f7a8b9c0e"
      ],
      "format": "uuid",
      "type": "string"
    },
    "proposal_id": {
      "description": "The approved proposal that made it.",
      "examples": [
        "0193a3c2-6d0e-7a1b-9c4d-5e6f7a8b9c0d"
      ],
      "format": "uuid",
      "type": "string"
    },
    "reason": {
      "description": "Why it was dismissed.",
      "examples": [
        "Filed by the tax agent on 20 January"
      ],
      "type": "string"
    },
    "run_id": {
      "description": "The run whose finding raised it.",
      "examples": [
        "0193a3c2-6d0e-7a1b-9c4d-5e6f7a8b9c12"
      ],
      "format": "uuid",
      "type": "string"
    },
    "source": {
      "description": "What raised it: a run's finding, or an approved proposal.",
      "enum": [
        "agent_run",
        "ai_proposal"
      ],
      "examples": [
        "agent_run"
      ],
      "type": "string"
    },
    "status": {
      "description": "open; done or dismissed by a person; cleared when its finding cleared.",
      "enum": [
        "open",
        "done",
        "dismissed",
        "cleared"
      ],
      "examples": [
        "open"
      ],
      "type": "string"
    },
    "title": {
      "examples": [
        "File the GST return for October to December"
      ],
      "type": "string"
    },
    "version": {
      "examples": [
        1
      ],
      "format": "int64",
      "type": "integer"
    }
  },
  "required": [
    "id",
    "finding_key",
    "title",
    "escalated",
    "source",
    "status",
    "created_at",
    "version"
  ],
  "title": "ComplianceTask",
  "type": "object"
}
