{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "amount": {
      "$ref": "Money.schema.json",
      "description": "A dispute's: the part of the invoice in dispute."
    },
    "created_at": {
      "description": "When it was recorded.",
      "examples": [
        "2026-11-20T09:30:00Z"
      ],
      "format": "date-time",
      "type": "string"
    },
    "id": {
      "description": "The record's ID.",
      "examples": [
        "01928f6e-7a3b-7c41-9d2e-5f8a1b3c4f95"
      ],
      "format": "uuid",
      "type": "string"
    },
    "invoice_id": {
      "description": "The invoice.",
      "examples": [
        "01928f6e-7a3b-7c41-9d2e-5f8a1b3c4f30"
      ],
      "format": "uuid",
      "type": "string"
    },
    "kind": {
      "description": "dispute: the customer disputes an amount; promise: they promise to pay on a day.",
      "enum": [
        "dispute",
        "promise"
      ],
      "examples": [
        "dispute"
      ],
      "type": "string"
    },
    "promised_on": {
      "description": "A promise's: the day the customer says they will pay.",
      "examples": [
        "2026-12-05"
      ],
      "format": "date",
      "type": "string"
    },
    "reason": {
      "description": "A dispute's: why.",
      "examples": [
        "The training was not delivered"
      ],
      "type": "string"
    },
    "resolution": {
      "description": "How it ended, once resolved.",
      "examples": [
        "Credit note issued for the training"
      ],
      "type": "string"
    },
    "resolved_at": {
      "description": "When it was resolved.",
      "examples": [
        "2026-11-28T09:30:00Z"
      ],
      "format": "date-time",
      "type": "string"
    },
    "status": {
      "description": "open pauses the invoice's reminders: a dispute until it is resolved, a promise until its day has passed.",
      "enum": [
        "open",
        "resolved"
      ],
      "examples": [
        "open"
      ],
      "type": "string"
    },
    "version": {
      "description": "Its version.",
      "examples": [
        1
      ],
      "format": "int64",
      "type": "integer"
    }
  },
  "required": [
    "id",
    "invoice_id",
    "kind",
    "status",
    "version",
    "created_at"
  ],
  "title": "InvoiceDispute",
  "type": "object"
}
