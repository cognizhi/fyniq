{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "id": {
      "description": "The customer's contact ID.",
      "examples": [
        "01928f6e-7a3b-7c41-9d2e-5f8a1b3c4f20"
      ],
      "format": "uuid",
      "type": "string"
    },
    "name": {
      "description": "The customer's legal name.",
      "examples": [
        "Acme Analytics Pte Ltd"
      ],
      "type": "string"
    },
    "rows": {
      "description": "A row per currency.",
      "items": {
        "$ref": "ReceivablesRow.schema.json"
      },
      "type": "array"
    }
  },
  "required": [
    "id",
    "name",
    "rows"
  ],
  "title": "ReceivablesCustomer",
  "type": "object"
}
