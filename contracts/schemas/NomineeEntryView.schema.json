{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "approval_id": {
      "description": "The approval request waiting, if one is.",
      "examples": [
        "01928f6e-7a3b-7c41-9d2e-5f8a1b3c7f11"
      ],
      "format": "uuid",
      "type": "string"
    },
    "checks": {
      "description": "A draft's status: ✖ while no evidence is attached.",
      "items": {
        "$ref": "BillCheck.schema.json"
      },
      "type": "array"
    },
    "entry": {
      "$ref": "NomineeEntryDraft.schema.json",
      "description": "The entry."
    },
    "entry_id": {
      "description": "The entry, by its first version's ID.",
      "examples": [
        "01928f6e-7a3b-7c41-9d2e-5f8a1b3c7f01"
      ],
      "format": "uuid",
      "type": "string"
    },
    "evidence": {
      "description": "How many files are attached and not removed: asking for approval needs one.",
      "examples": [
        1
      ],
      "format": "int64",
      "type": "integer"
    },
    "id": {
      "description": "The version's ID.",
      "examples": [
        "01928f6e-7a3b-7c41-9d2e-5f8a1b3c7f02"
      ],
      "format": "uuid",
      "type": "string"
    },
    "name": {
      "description": "The nominee's name: the director's or the holder's.",
      "examples": [
        "Ah Kow Holdings Pte. Ltd."
      ],
      "type": "string"
    },
    "recorded_at": {
      "description": "When it was recorded.",
      "examples": [
        "2026-07-03T09:30:00Z"
      ],
      "format": "date-time",
      "type": "string"
    },
    "recorded_by": {
      "$ref": "Person.schema.json",
      "description": "Who approved it, as it was recorded."
    },
    "status": {
      "description": "draft: waiting for its evidence and approval; recorded: the entry's version in force; superseded: a later version is in force.",
      "enum": [
        "draft",
        "recorded",
        "superseded"
      ],
      "examples": [
        "recorded"
      ],
      "type": "string"
    },
    "version": {
      "description": "The version of its content; with its status it makes the ETag.",
      "examples": [
        1
      ],
      "format": "int64",
      "type": "integer"
    }
  },
  "required": [
    "id",
    "entry_id",
    "name",
    "status",
    "version",
    "entry",
    "evidence",
    "checks"
  ],
  "title": "NomineeEntryView",
  "type": "object"
}
