          "task_type": "bank.rule_upsert",
          "payload": {
            "name": "AWS to hosting",
            "position": 1,
            "when": {
              "description_contains": "AWS",
              "direction": "out"
            },
            "then": {
              "account": "5010"
            }
          }
        }
      },
      "solution": [
        {
          "tool": "records.search",
          "input": {
            "q": "Cloud hosting",
            "kind": "accounts"
          }
        }
      ]
    },
    {
      "id": "stripe-fees",
