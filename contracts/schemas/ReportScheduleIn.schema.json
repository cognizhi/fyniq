{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "active": {
      "description": "False switches the schedule off.",
      "examples": [
        true
      ],
      "type": "boolean"
    },
    "cadence": {
      "description": "weekly: on a weekday; monthly: on a day of the month.",
      "enum": [
        "weekly",
        "monthly"
      ],
      "examples": [
        "monthly"
      ],
      "type": "string"
    },
    "channel": {
      "description": "email or slack.",
      "enum": [
        "email",
        "slack"
      ],
      "examples": [
        "email"
      ],
      "type": "string"
    },
    "day_of_month": {
      "description": "A monthly schedule's day, 1 to 28.",
      "examples": [
        5
      ],
      "format": "int64",
      "maximum": 28,
      "minimum": 1,
      "type": "integer"
    },
    "period_rule": {
      "description": "The month the report is for when it is sent.",
      "enum": [
        "last_closed_month",
        "month_to_date"
      ],
      "examples": [
        "last_closed_month"
      ],
      "type": "string"
    },
    "recipients": {
      "description": "Member user IDs, each an active member who may read the report (RDEF-11).",
      "items": {
        "description": "A member's user ID.",
        "examples": [
          "01928f6e-7a3b-7c41-9d2e-5f8a1b3c4d01"
        ],
        "format": "uuid",
        "type": "string"
      },
      "maxItems": 50,
      "minItems": 1,
      "type": "array"
    },
    "slack_channel": {
      "description": "The Slack channel, for the slack channel.",
      "examples": [
        "#finance"
      ],
      "maxLength": 80,
      "type": "string"
    },
    "weekday": {
      "description": "A weekly schedule's weekday, 1 Monday to 7 Sunday.",
      "examples": [
        1
      ],
      "format": "int64",
      "maximum": 7,
      "minimum": 1,
      "type": "integer"
    }
  },
  "required": [
    "cadence",
    "period_rule",
    "channel",
    "recipients",
    "active"
  ],
  "title": "ReportScheduleIn",
  "type": "object"
}
