{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fyniq.example/schemas/payroll-month@1.json",
  "title": "fyniq-payroll-month@1",
  "description": "An employee-month both the Go engine (internal/nemura/payroll) and the independent oracle work out from the same facts and the same pack versions (PRD-001 Appendix B.3; QA-ENG-02). Money is a decimal string; the expected figures are worked by hand from the rules, never from the engine.",
  "type": "object",
  "required": ["schema", "name", "month", "person", "items", "expect"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "fyniq-payroll-month@1"},
    "name": {"type": "string", "minLength": 1},
    "why": {"type": "string"},
    "month": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-01$"},
    "packs": {"type": "object", "description": "Pack versions read; the defaults are sg-cpf@2026.2, sg-sdl@2026.1 and sg-shg@2026.1"},
    "person": {
      "type": "object",
      "required": ["residency", "birth_date"],
      "additionalProperties": false,
      "properties": {
        "employee": {"type": "boolean", "default": true},
        "residency": {"enum": ["citizen", "permanent_resident", "foreigner"]},
        "pr_start": {"type": "string", "format": "date"},
        "birth_date": {"type": "string", "format": "date"},
        "joint_election": {"type": "boolean"},
        "shg_fund": {"enum": ["", "CDAC", "ECF", "MBMF", "SINDA"]},
        "shg_opt_out": {"type": "boolean"}
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["key", "name", "amount", "cpf_wages"],
        "additionalProperties": false,
        "properties": {
          "key": {"type": "string"},
          "name": {"type": "string"},
          "amount": {"type": "string", "pattern": "^-?[0-9]+(\\.[0-9]{1,2})?$"},
          "cpf_wages": {"type": "boolean"},
          "for_month": {"type": "string", "format": "date"},
          "payable_on": {"type": "string", "format": "date"},
          "suggested": {"enum": ["", "ordinary", "additional"]}
        }
      }
    },
    "ytd": {
      "type": "object",
      "required": ["ow", "aw_subject", "aw_paid"],
      "additionalProperties": false,
      "properties": {"ow": {"type": "string"}, "aw_subject": {"type": "string"}, "aw_paid": {"type": "string"}}
    },
    "last_month": {"type": "boolean"},
    "pay_day": {"type": "string", "format": "date", "description": "The pay day of the month, for an item that names no payable_on; the last day of the month when absent"},
    "deductions": {
      "type": "array",
      "description": "Salary deductions (FR-PAY-16), each linked to its source by its key",
      "items": {
        "type": "object",
        "required": ["key", "kind", "amount"],
        "additionalProperties": false,
        "properties": {
          "key": {"type": "string"},
          "kind": {"enum": ["absence", "damage_or_loss", "accommodation", "recovery", "cpf", "income_tax", "court_order", "cooperative", "other"]},
          "amount": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]{1,2})?$"},
          "consent": {"type": "boolean", "description": "Written consent is recorded"},
          "instalment": {"type": "integer", "minimum": 0, "description": "For a recovery of an advance: which instalment this is, from 1"},
          "is_advance": {"type": "boolean", "description": "A recovery of an advance, which has instalment limits"}
        }
      }
    },
    "final": {"type": "boolean", "description": "Final pay on termination: the 50% limit does not apply and an advance is recovered only as far as consented"},
    "held": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]{1,2})?$", "description": "Monies held under an IR21 clearance hold: they stay in 2100 and out of the amount to disburse"},
    "reimbursements": {"type": "array", "items": {"type": "string"}},
    "expect": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "error": {"type": "string", "description": "A refusal the month ends in, such as needs_year_to_date"},
        "gross": {"type": "string"},
        "ow_subject": {"type": "string"},
        "aw_subject": {"type": "string"},
        "cpf_total": {"type": "string"},
        "cpf_employee": {"type": "string"},
        "cpf_employer": {"type": "string"},
        "sdl": {"type": "string"},
        "shg": {"type": "string"},
        "net": {"type": "string"},
        "disburse": {"type": "string"},
        "refund_wages": {"type": "string"},
        "deductions": {"type": "string"},
        "reimbursements": {"type": "string"},
        "employer_cost": {"type": "string"},
        "violations": {"type": "boolean", "description": "Whether the deductions break a rule of FR-PAY-16"}
      }
    }
  }
}
