{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "claimant_id": {
      "description": "Whose claims it pays back: the claimant's user ID.",
      "examples": [
        "01928f6e-7a3b-7c41-9d2e-5f8a1b3c4d01"
      ],
      "format": "uuid",
      "type": "string"
    },
    "claims": {
      "description": "What it pays back of each claim.",
      "items": {
        "$ref": "ClaimReimbursementPart.schema.json"
      },
      "maxItems": 100,
      "type": [
        "array",
        "null"
      ]
    },
    "date": {
      "description": "The day the money left the account.",
      "examples": [
        "2026-10-20"
      ],
      "format": "date",
      "type": "string"
    },
    "money_account_id": {
      "description": "The bank, card or wallet account it left: an active money account in the base currency.",
      "examples": [
        "01928f6e-7a3b-7c41-9d2e-5f8a1b3c4d10"
      ],
      "format": "uuid",
      "type": "string"
    },
    "notes": {
      "description": "Notes kept with it.",
      "examples": [
        "October's claims"
      ],
      "maxLength": 2000,
      "type": "string"
    },
    "reference": {
      "description": "The bank's reference for it.",
      "examples": [
        "FAST 88231"
      ],
      "maxLength": 140,
      "type": "string"
    }
  },
  "required": [
    "claimant_id",
    "date",
    "money_account_id",
    "claims"
  ],
  "title": "ClaimReimbursementDraft",
  "type": "object"
}
