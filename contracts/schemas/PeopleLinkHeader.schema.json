{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "correlation_id": {
      "description": "Ties the event to its cause.",
      "format": "uuid",
      "type": "string"
    },
    "effective_at": {
      "description": "When the change took effect, RFC 3339 in UTC.",
      "format": "date-time",
      "type": "string"
    },
    "epoch": {
      "description": "The link's epoch; an earlier or a later one is refused.",
      "format": "int64",
      "minimum": 1,
      "type": "integer"
    },
    "event_id": {
      "description": "The event's ID: a repeat does nothing.",
      "format": "uuid",
      "type": "string"
    },
    "object_id": {
      "description": "The object's ID.",
      "maxLength": 100,
      "minLength": 1,
      "type": "string"
    },
    "object_type": {
      "description": "The kind of object the event is about.",
      "maxLength": 50,
      "minLength": 1,
      "type": "string"
    },
    "object_version": {
      "description": "The object's version: an older one than applied is ignored.",
      "format": "int64",
      "minimum": 1,
      "type": "integer"
    },
    "payload_sha256": {
      "description": "The SHA-256 of the payload's canonical JSON (contracts/peoplelink).",
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "recorded_at": {
      "description": "When the sender recorded it.",
      "format": "date-time",
      "type": "string"
    },
    "schema_version": {
      "description": "The payload schema's version.",
      "format": "int64",
      "minimum": 1,
      "type": "integer"
    },
    "sequence": {
      "description": "The sender's running number on this link, for gap repair and the reconciliation checkpoint.",
      "format": "int64",
      "minimum": 0,
      "type": "integer"
    },
    "signed_at": {
      "description": "When it was signed: more than 5 minutes from now is refused.",
      "format": "date-time",
      "type": "string"
    },
    "source_organisation": {
      "description": "The Nemura organisation.",
      "format": "uuid",
      "type": "string"
    },
    "source_system": {
      "description": "The sending system.",
      "enum": [
        "nemura"
      ],
      "type": "string"
    },
    "target_organisation": {
      "description": "This organisation.",
      "format": "uuid",
      "type": "string"
    },
    "type": {
      "description": "The event type, such as people.person.upserted.",
      "examples": [
        "people.person.upserted"
      ],
      "type": "string"
    }
  },
  "required": [
    "event_id",
    "type",
    "schema_version",
    "source_system",
    "source_organisation",
    "target_organisation",
    "epoch",
    "sequence",
    "object_type",
    "object_id",
    "object_version",
    "effective_at",
    "recorded_at",
    "signed_at",
    "correlation_id",
    "payload_sha256"
  ],
  "title": "PeopleLinkHeader",
  "type": "object"
}
