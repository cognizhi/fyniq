{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "active": {
      "description": "false keeps it for its history and offers it for nothing new.",
      "examples": [
        false
      ],
      "type": "boolean"
    },
    "description": {
      "description": "What documents print on its lines.",
      "examples": [
        "HR advisory, by the hour"
      ],
      "maxLength": 2000,
      "type": "string"
    },
    "gst_code": {
      "description": "The GST code.",
      "examples": [
        "SR"
      ],
      "type": "string"
    },
    "name": {
      "description": "Its name.",
      "examples": [
        "HR advisory"
      ],
      "maxLength": 200,
      "type": "string"
    },
    "prices": {
      "description": "Every price the item now has: it replaces them all, and [] clears them.",
      "items": {
        "$ref": "ItemPrice.schema.json"
      },
      "maxItems": 50,
      "type": "array"
    },
    "revenue_account_id": {
      "description": "The revenue account; \"\" clears it.",
      "examples": [
        "01928f6e-7a3b-7c41-9d2e-5f8a1b3c4d60"
      ],
      "type": "string"
    },
    "type": {
      "description": "A product or a service.",
      "enum": [
        "product",
        "service"
      ],
      "examples": [
        "service"
      ],
      "type": "string"
    },
    "unit": {
      "description": "What a quantity of one is.",
      "examples": [
        "day"
      ],
      "maxLength": 20,
      "type": "string"
    }
  },
  "title": "ItemChanges",
  "type": "object"
}
