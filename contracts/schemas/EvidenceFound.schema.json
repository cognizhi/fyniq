{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "data_class": {
      "description": "The personal data it holds (FR-DOC-09).",
      "enum": [
        "general",
        "personal",
        "bank",
        "payroll",
        "identity"
      ],
      "examples": [
        "general"
      ],
      "type": "string"
    },
    "evidence_type": {
      "description": "What the file is.",
      "examples": [
        "invoice"
      ],
      "type": "string"
    },
    "file_name": {
      "description": "As the uploader named it.",
      "examples": [
        "AU-100.pdf"
      ],
      "type": "string"
    },
    "id": {
      "description": "The file's ID.",
      "examples": [
        "01928f6e-7a3b-7c41-9d2e-5f8a1b3c4e20"
      ],
      "format": "uuid",
      "type": "string"
    },
    "media_type": {
      "description": "Its type, from its content.",
      "examples": [
        "application/pdf"
      ],
      "type": "string"
    },
    "record": {
      "$ref": "EvidenceRecord.schema.json",
      "description": "The record it is attached to."
    },
    "size_bytes": {
      "description": "Its size in bytes.",
      "examples": [
        18432
      ],
      "format": "int64",
      "type": "integer"
    },
    "state": {
      "description": "Attached, or final: committed to the retention-locked store.",
      "enum": [
        "attached",
        "removed",
        "final"
      ],
      "examples": [
        "final"
      ],
      "type": "string"
    },
    "unmasked_nric": {
      "description": "true when its text shows a Singapore NRIC or FIN in full (FR-DOC-09).",
      "examples": [
        false
      ],
      "type": "boolean"
    },
    "uploaded_at": {
      "description": "When.",
      "examples": [
        "2026-10-20T09:15:00Z"
      ],
      "format": "date-time",
      "type": "string"
    },
    "uploaded_by": {
      "description": "Who attached it: an actor of the audit trail.",
      "examples": [
        "user:01928f6e-7a3b-7c41-9d2e-5f8a1b3c4d01"
      ],
      "type": "string"
    }
  },
  "required": [
    "id",
    "file_name",
    "evidence_type",
    "media_type",
    "size_bytes",
    "data_class",
    "uploaded_by",
    "uploaded_at",
    "state",
    "record"
  ],
  "title": "EvidenceFound",
  "type": "object"
}
