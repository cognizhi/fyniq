        "$ref": "MigrationNatureMap.schema.json"
      },
      "type": [
        "array",
        "null"
      ]
    },
    "people": {
      "description": "People to map again, by the workbook's name.",
      "items": {
        "$ref": "MigrationPersonMap.schema.json"
      },
      "type": [
        "array",
        "null"
