organisation | require_audit | TRIGGER DEFERRABLE INITIALLY DEFERRED
outbox | outbox_attempts_not_null | NOT NULL attempts
outbox | outbox_attempts_range | CHECK (((attempts >= 0) AND ((max_attempts >= 1) AND (max_attempts <= 100))))
outbox | outbox_business_key | UNIQUE (organisation_id, kind, business_key)
outbox | outbox_business_key_length | CHECK (((length(business_key) >= 1) AND (length(business_key) <= 500)))
