{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "approval_asked": {
      "description": "The pending request to void it.",
      "examples": [
        "01928f6e-7a3b-7c41-9d2e-5f8a1b3c4dd1"
      ],
      "format": "uuid",
      "type": "string"
    },
    "checks": {
      "description": "recordClaimReimbursement only: warnings it was recorded with, such as payments to the claimant frozen while a change of their bank account waits for approval (FR-AP-22).",
      "items": {
        "$ref": "BillCheck.schema.json"
      },
      "type": [
        "array",
        "null"
      ]
    },
    "claimant": {
      "$ref": "Person.schema.json",
      "description": "Whose claims it paid back."
    },
    "claims": {
      "description": "What it paid back of each claim, as recorded.",
      "items": {
        "$ref": "ClaimReimbursementPart.schema.json"
      },
      "type": "array"
    },
    "date": {
      "description": "The day the money left.",
      "examples": [
        "2026-10-20"
      ],
      "format": "date",
      "type": "string"
    },
    "id": {
      "description": "The reimbursement's ID.",
      "examples": [
        "01928f6e-7a3b-7c41-9d2e-5f8a1b3c4fe1"
      ],
      "format": "uuid",
      "type": "string"
    },
    "ledger_impact": {
      "description": "getClaimReimbursement only: the lines its entry wrote: debits positive.",
      "items": {
        "$ref": "EntryLine.schema.json"
      },
      "type": "array"
    },
    "money_account_id": {
      "description": "The account it left.",
      "examples": [
        "01928f6e-7a3b-7c41-9d2e-5f8a1b3c4d10"
      ],
      "format": "uuid",
      "type": "string"
    },
    "notes": {
      "description": "Its notes.",
      "examples": [
        "October's claims"
      ],
      "type": "string"
    },
    "number": {
      "description": "Its number from the reimbursement sequence (FR-ORG-04).",
      "examples": [
        "RB-0003"
      ],
      "type": "string"
    },
    "recorded_at": {
      "description": "When it was recorded.",
      "examples": [
        "2026-10-20T09:30:00Z"
      ],
      "format": "date-time",
      "type": "string"
    },
    "recorded_by": {
      "$ref": "Person.schema.json",
      "description": "Who recorded it."
    },
    "reference": {
      "description": "The bank's reference.",
      "examples": [
        "FAST 88231"
      ],
      "type": "string"
    },
    "status": {
      "description": "posted once recorded; reversed by a void.",
      "enum": [
        "posted",
        "reversed"
      ],
      "examples": [
        "posted"
      ],
      "type": "string"
    },
    "total": {
      "$ref": "Money.schema.json",
      "description": "What it paid back, in the base currency."
    },
    "version": {
      "description": "The version of its content; with the status it makes the ETag.",
      "examples": [
        1
      ],
      "format": "int64",
      "type": "integer"
    }
  },
  "required": [
    "id",
    "status",
    "version",
    "claimant",
    "money_account_id",
    "total",
    "claims",
    "ledger_impact"
  ],
  "title": "ClaimReimbursement",
  "type": "object"
}
