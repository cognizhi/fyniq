{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "due_by": {
      "description": "The last day its review is on time: 14 days after the quarter ends.",
      "examples": [
        "2026-10-14"
      ],
      "format": "date",
      "type": "string"
    },
    "label": {
      "description": "The quarter, as people say it.",
      "examples": [
        "Q3 2026"
      ],
      "type": "string"
    },
    "last_quarter": {
      "description": "The latest quarter reviewed.",
      "examples": [
        "2026-04-01"
      ],
      "format": "date",
      "type": "string"
    },
    "last_reviewed_at": {
      "description": "When.",
      "examples": [
        "2026-07-03T02:00:00Z"
      ],
      "format": "date-time",
      "type": "string"
    },
    "last_reviewed_by": {
      "description": "Who reviewed it, as records name actors.",
      "examples": [
        "user:01928f6e-7a3b-7c41-9d2e-5f8a1b3c5e10"
      ],
      "type": "string"
    },
    "overdue": {
      "description": "true once that day has passed.",
      "examples": [
        false
      ],
      "type": "boolean"
    },
    "quarter": {
      "description": "The quarter waiting for its review: its first day; absent when none waits.",
      "examples": [
        "2026-07-01"
      ],
      "format": "date",
      "type": "string"
    }
  },
  "required": [
    "overdue"
  ],
  "title": "InventoryReviewState",
  "type": "object"
}
