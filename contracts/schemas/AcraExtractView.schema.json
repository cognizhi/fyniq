{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "checks": {
      "description": "A draft's status: ✖ while no PDF is attached.",
      "items": {
        "$ref": "BillCheck.schema.json"
      },
      "type": "array"
    },
    "evidence": {
      "description": "How many files are attached and not removed: recording needs one, the business profile's PDF.",
      "examples": [
        1
      ],
      "format": "int64",
      "type": "integer"
    },
    "holdings": {
      "description": "The holdings typed in, by name.",
      "items": {
        "$ref": "AcraHoldingView.schema.json"
      },
      "type": "array"
    },
    "id": {
      "description": "The extract's ID.",
      "examples": [
        "01928f6e-7a3b-7c41-9d2e-5f8a1b3c7d01"
      ],
      "format": "uuid",
      "type": "string"
    },
    "note": {
      "description": "A note.",
      "examples": [
        "Business profile bought on 1 Oct 2026"
      ],
      "type": "string"
    },
    "profile_on": {
      "description": "The business profile's day.",
      "examples": [
        "2026-10-01"
      ],
      "format": "date",
      "type": "string"
    },
    "recorded_at": {
      "description": "When it was recorded.",
      "examples": [
        "2026-10-02T09:30:00Z"
      ],
      "format": "date-time",
      "type": "string"
    },
    "recorded_by": {
      "$ref": "Person.schema.json",
      "description": "Who recorded it."
    },
    "status": {
      "description": "draft: waiting for its PDF and to be recorded; recorded: in force; superseded: a later business profile is recorded.",
      "enum": [
        "draft",
        "recorded",
        "superseded"
      ],
      "examples": [
        "recorded"
      ],
      "type": "string"
    },
    "version": {
      "description": "The version of its content; with its status it makes the ETag.",
      "examples": [
        1
      ],
      "format": "int64",
      "type": "integer"
    }
  },
  "required": [
    "id",
    "status",
    "version",
    "profile_on",
    "holdings",
    "evidence",
    "checks"
  ],
  "title": "AcraExtractView",
  "type": "object"
}
