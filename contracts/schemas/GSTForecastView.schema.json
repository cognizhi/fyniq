{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "basis": {
      "description": "What it rests on.",
      "examples": [
        "Signed contracts with Lumen Health and Acme Analytics"
      ],
      "type": "string"
    },
    "checks": {
      "description": "A draft's status: ✖ while no evidence is attached.",
      "items": {
        "$ref": "BillCheck.schema.json"
      },
      "type": "array"
    },
    "evidence": {
      "description": "How many files are attached and not removed: recording needs one.",
      "examples": [
        1
      ],
      "format": "int64",
      "type": "integer"
    },
    "forecast_on": {
      "description": "The day the forecast was made.",
      "examples": [
        "2026-11-20"
      ],
      "format": "date",
      "type": "string"
    },
    "id": {
      "description": "The forecast's ID.",
      "examples": [
        "01928f6e-7a3b-7c41-9d2e-5f8a1b3c8a01"
      ],
      "format": "uuid",
      "type": "string"
    },
    "recorded_at": {
      "description": "When it was recorded.",
      "examples": [
        "2026-11-20T09:30:00Z"
      ],
      "format": "date-time",
      "type": "string"
    },
    "recorded_by": {
      "$ref": "Person.schema.json",
      "description": "Who recorded it."
    },
    "status": {
      "description": "draft: waiting for its evidence and to be recorded; recorded: the latest recorded; superseded: a later one is recorded.",
      "enum": [
        "draft",
        "recorded",
        "superseded"
      ],
      "examples": [
        "recorded"
      ],
      "type": "string"
    },
    "until": {
      "description": "The last day of its 12 months.",
      "examples": [
        "2027-11-19"
      ],
      "format": "date",
      "type": "string"
    },
    "value": {
      "$ref": "Money.schema.json",
      "description": "The taxable supplies expected in the 12 months."
    },
    "version": {
      "description": "The version of its content; with its status it makes the ETag.",
      "examples": [
        1
      ],
      "format": "int64",
      "type": "integer"
    }
  },
  "required": [
    "id",
    "status",
    "version",
    "forecast_on",
    "until",
    "value",
    "basis",
    "evidence",
    "checks"
  ],
  "title": "GSTForecastView",
  "type": "object"
}
