{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "asks": {
      "description": "What the board is asked for.",
      "examples": [
        "An introduction to two banks."
      ],
      "maxLength": 5000,
      "type": "string"
    },
    "commentary": {
      "description": "The commentary: what a person wrote, or accepted from an AI draft and edited.",
      "examples": [
        "Hosting rose with the new region."
      ],
      "maxLength": 20000,
      "type": "string"
    },
    "highlights": {
      "description": "The month's highlights.",
      "examples": [
        "Revenue passed S$50,000 for the first time."
      ],
      "maxLength": 5000,
      "type": "string"
    }
  },
  "required": [
    "highlights",
    "commentary",
    "asks"
  ],
  "title": "BoardPackTexts",
  "type": "object"
}
