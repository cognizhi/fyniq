        "ignored_older",
        "duplicate"
      ],
      "examples": [
        "applied"
      ],
      "type": "string"
    }
  },
  "required": [
    "event_id",
    "outcome"
  ],
  "title": "PeopleLinkReceipt",
  "type": "object"
}
