outbox | outbox_worker_class_known | CHECK ((worker_class = ANY (ARRAY['worker'::text, 'executor'::text, 'jobs'::text])))
outbox | outbox_worker_class_not_null | NOT NULL worker_class
period | period_closed_revision | CHECK (((status = 'closed'::text) = (closed_revision IS NOT NULL)))
period | period_closed_revision_not_negative | CHECK ((closed_revision >= 0))
period | period_created_at_not_null | NOT NULL created_at
period | period_dates_ordered | CHECK ((ends_on >= starts_on))
period | period_ends_on_not_null | NOT NULL ends_on
period | period_id_not_null | NOT NULL id
period | period_no_overlap | EXCLUDE USING gist (organisation_id WITH =, daterange(starts_on, ends_on, '[]'::text) WITH &&)
period | period_organisation_fkey | FOREIGN KEY (organisation_id) REFERENCES organisation(organisation_id)
period | period_organisation_id_not_null | NOT NULL organisation_id
period | period_pkey | PRIMARY KEY (organisation_id, id)
period | period_starts_on_not_null | NOT NULL starts_on
