{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "document_id": {
      "description": "The bill or bank transaction.",
      "examples": [
        "01928f6e-7a3b-7c41-9d2e-5f8a1b3c4e30"
      ],
      "format": "uuid",
      "type": "string"
    },
    "line": {
      "description": "Its line, or part, from 1.",
      "examples": [
        1
      ],
      "format": "int64",
      "type": "integer"
    },
    "number": {
      "description": "The bill's number.",
      "examples": [
        "BILL-0042"
      ],
      "type": "string"
    },
    "type": {
      "description": "bill, or bank_transaction: a categorised bank line.",
      "enum": [
        "bill",
        "bank_transaction"
      ],
      "examples": [
        "bill"
      ],
      "type": "string"
    },
    "version": {
      "description": "The version of it that posted the cost.",
      "examples": [
        1
      ],
      "format": "int64",
      "type": "integer"
    }
  },
  "required": [
    "document_id",
    "type",
    "version",
    "line"
  ],
  "title": "FixedAssetSource",
  "type": "object"
}
