{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "accepted_at": {
      "description": "When this organisation's Owner accepted.",
      "examples": [
        "2026-11-21T09:30:00Z"
      ],
      "format": "date-time",
      "type": "string"
    },
    "ended_at": {
      "description": "When the link ended.",
      "examples": [
        "2026-11-22T09:00:00Z"
      ],
      "format": "date-time",
      "type": "string"
    },
    "ended_reason": {
      "description": "Why it ended.",
      "examples": [
        "We left the group"
      ],
      "type": "string"
    },
    "id": {
      "description": "The consent's ID.",
      "examples": [
        "01928f6e-7a3b-7c41-9d2e-5f8a1b3c5d01"
      ],
      "format": "uuid",
      "type": "string"
    },
    "parent_name": {
      "description": "The parent's name when this organisation accepted.",
      "examples": [
        "Cognizhi Pte Ltd"
      ],
      "type": "string"
    },
    "parent_organisation_id": {
      "description": "The group's parent.",
      "examples": [
        "01928f6e-7a3b-7c41-9d2e-5f8a1b3c5b01"
      ],
      "format": "uuid",
      "type": "string"
    },
    "scopes": {
      "description": "What the parent may read: figures (each account's net movement by month, with its code, name and type, the ledger revision and the state of the periods) and intercompany (offers addressed to this organisation). Nothing else of this organisation is readable, and nothing is writable.",
      "items": {
        "description": "figures: each account's net movement by month; intercompany: offers addressed to the entity.",
        "enum": [
          "figures",
          "intercompany"
        ],
        "examples": [
          "figures"
        ],
        "type": "string"
      },
      "type": "array"
    },
    "state": {
      "description": "active while both Owners consent.",
      "enum": [
        "active",
        "ended"
      ],
      "examples": [
        "active"
      ],
      "type": "string"
    },
    "version": {
      "description": "The row's version.",
      "examples": [
        1
      ],
      "format": "int64",
      "type": "integer"
    }
  },
  "required": [
    "id",
    "parent_organisation_id",
    "parent_name",
    "scopes",
    "state",
    "accepted_at",
    "version"
  ],
  "title": "GroupMembershipItem",
  "type": "object"
}
