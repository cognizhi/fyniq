{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "client_id": {
      "description": "The API client that made it: the only one that updates it.",
      "examples": [
        "0193a3c2-6d0e-7a1b-9c4d-5e6f7a8b9c22"
      ],
      "type": "string"
    },
    "closed_at": {
      "examples": [
        "2026-11-22T02:00:00Z"
      ],
      "format": "date-time",
      "type": "string"
    },
    "created_at": {
      "examples": [
        "2026-11-20T02:00:00Z"
      ],
      "format": "date-time",
      "type": "string"
    },
    "detail": {
      "examples": [
        "Raised from OPS-142."
      ],
      "type": "string"
    },
    "due_on": {
      "examples": [
        "2026-12-15"
      ],
      "format": "date",
      "type": "string"
    },
    "external_ref": {
      "description": "The client's own reference, such as the ticket key.",
      "examples": [
        "OPS-142"
      ],
      "type": "string"
    },
    "id": {
      "examples": [
        "0193a3c2-6d0e-7a1b-9c4d-5e6f7a8b9c21"
      ],
      "format": "uuid",
      "type": "string"
    },
    "link_url": {
      "description": "Where the ticket is.",
      "examples": [
        "https://example.atlassian.net/browse/OPS-142"
      ],
      "format": "uri",
      "type": "string"
    },
    "status": {
      "description": "open, then done or cancelled by the client that made it, for good.",
      "enum": [
        "open",
        "done",
        "cancelled"
      ],
      "examples": [
        "open"
      ],
      "type": "string"
    },
    "title": {
      "examples": [
        "Chase the signed engagement letter"
      ],
      "type": "string"
    },
    "updated_at": {
      "examples": [
        "2026-11-20T02:00:00Z"
      ],
      "format": "date-time",
      "type": "string"
    },
    "version": {
      "examples": [
        1
      ],
      "format": "int64",
      "type": "integer"
    }
  },
  "required": [
    "id",
    "external_ref",
    "title",
    "status",
    "client_id",
    "created_at",
    "updated_at",
    "version"
  ],
  "title": "IntegrationTask",
  "type": "object"
}
