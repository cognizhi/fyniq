{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "entered_at": {
      "description": "When.",
      "examples": [
        "2026-11-03T02:00:00Z"
      ],
      "format": "date-time",
      "type": "string"
    },
    "entered_by": {
      "$ref": "Person.schema.json",
      "description": "Who entered them last."
    },
    "headcount": {
      "description": "People employed in the month.",
      "examples": [
        8
      ],
      "format": "int64",
      "type": "integer"
    },
    "lost_customers": {
      "description": "Customers who stopped paying in the month.",
      "examples": [
        1
      ],
      "format": "int64",
      "type": "integer"
    },
    "month": {
      "description": "The month, YYYY-MM.",
      "examples": [
        "2026-10"
      ],
      "pattern": "^[0-9]{4}-[0-9]{2}$",
      "type": "string"
    },
    "new_customers": {
      "description": "Customers who started paying in the month.",
      "examples": [
        2
      ],
      "format": "int64",
      "type": "integer"
    },
    "paying_customers": {
      "description": "Paying customers at the month's end.",
      "examples": [
        10
      ],
      "format": "int64",
      "type": "integer"
    },
    "version": {
      "description": "The counts' version: If-Match takes it as the ETag.",
      "examples": [
        1
      ],
      "format": "int64",
      "type": "integer"
    }
  },
  "required": [
    "month",
    "entered_at",
    "version"
  ],
  "title": "KPICountsOut",
  "type": "object"
}
