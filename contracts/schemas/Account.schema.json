{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "active": {
      "description": "An inactive account takes no new postings.",
      "examples": [
        true
      ],
      "type": "boolean"
    },
    "cash_flow_line": {
      "description": "Its line in the cash-flow statement, for balance-sheet accounts.",
      "examples": [
        "Payables \u0026 accruals"
      ],
      "type": "string"
    },
    "code": {
      "description": "The account code.",
      "examples": [
        "6100"
      ],
      "type": "string"
    },
    "control": {
      "description": "Has a sub-ledger (AR, AP, a director's account).",
      "examples": [
        false
      ],
      "type": "boolean"
    },
    "currency": {
      "description": "A bank account's currency.",
      "examples": [
        "SGD"
      ],
      "type": "string"
    },
    "default_gst_code": {
      "description": "The GST code a line on it starts with.",
      "examples": [
        "TX"
      ],
      "type": "string"
    },
    "function": {
      "description": "The function its costs belong to.",
      "enum": [
        "COGS",
        "R\u0026D",
        "S\u0026M",
        "G\u0026A",
        "Other"
      ],
      "examples": [
        "G\u0026A"
      ],
      "type": "string"
    },
    "group": {
      "description": "A group account is a heading: postings go to the accounts under it.",
      "examples": [
        false
      ],
      "type": "boolean"
    },
    "guidance": {
      "description": "Shown when someone picks the account.",
      "examples": [
        "Office rent, co-working memberships and short-term space."
      ],
      "type": "string"
    },
    "id": {
      "description": "The account's ID.",
      "examples": [
        "01928f6e-7a3b-7c41-9d2e-5f8a1b3c4d60"
      ],
      "format": "uuid",
      "type": "string"
    },
    "money_account": {
      "description": "A bank, cash, card or wallet account money moves through.",
      "examples": [
        false
      ],
      "type": "boolean"
    },
    "name": {
      "description": "The account name.",
      "examples": [
        "Rent"
      ],
      "type": "string"
    },
    "parent_id": {
      "description": "The group account it sits under, or null.",
      "examples": [
        "01928f6e-7a3b-7c41-9d2e-5f8a1b3c4d61"
      ],
      "format": "uuid",
      "type": [
        "string",
        "null"
      ]
    },
    "payroll_cost": {
      "description": "Carries payroll cost (FR-PRJ-12, FR-PAY-13).",
      "examples": [
        false
      ],
      "type": "boolean"
    },
    "report_group": {
      "description": "Where the statements show it.",
      "examples": [
        "Premises \u0026 office"
      ],
      "type": "string"
    },
    "role": {
      "description": "A role the rules treat specially, such as share-capital.",
      "examples": [
        "share-capital"
      ],
      "type": "string"
    },
    "type": {
      "description": "The account type.",
      "enum": [
        "asset",
        "liability",
        "equity",
        "revenue",
        "expense"
      ],
      "examples": [
        "expense"
      ],
      "type": "string"
    },
    "version": {
      "description": "The record's version; it also makes the ETag.",
      "examples": [
        1
      ],
      "format": "int64",
      "type": "integer"
    }
  },
  "required": [
    "id",
    "code",
    "name",
    "type",
    "parent_id",
    "group",
    "active",
    "version",
    "money_account",
    "control",
    "payroll_cost"
  ],
  "title": "Account",
  "type": "object"
}
