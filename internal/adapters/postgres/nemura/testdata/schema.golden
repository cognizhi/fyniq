## constraints (table | name | definition)
access_request | access_request_answered_whole | CHECK (((state = 'answered'::text) = ((outcome IS NOT NULL) AND (answered_on IS NOT NULL) AND (handled_by IS NOT NULL))))
access_request | access_request_created_at_not_null | NOT NULL created_at
access_request | access_request_due | CHECK ((due_on = (received_on + 30)))
access_request | access_request_due_on_not_null | NOT NULL due_on
access_request | access_request_handler_fkey | FOREIGN KEY (organisation_id, handled_by) REFERENCES nemura.member(organisation_id, id)
access_request | access_request_id_not_null | NOT NULL id
access_request | access_request_not_own | CHECK (((handled_by IS NULL) OR (handled_by <> requester_id)))
access_request | access_request_notice_in_time | CHECK (((extended_notice_on IS NULL) OR (extended_notice_on <= due_on)))
access_request | access_request_organisation_fkey | FOREIGN KEY (organisation_id) REFERENCES nemura.organisation(organisation_id)
access_request | access_request_organisation_id_not_null | NOT NULL organisation_id
access_request | access_request_outcome_length | CHECK (((length(btrim(COALESCE(outcome, 'x'::text))) >= 1) AND (length(btrim(COALESCE(outcome, 'x'::text))) <= 20000)))
access_request | access_request_pkey | PRIMARY KEY (organisation_id, id)
access_request | access_request_received_on_not_null | NOT NULL received_on
access_request | access_request_requester_fkey | FOREIGN KEY (organisation_id, requester_id) REFERENCES nemura.member(organisation_id, id)
access_request | access_request_requester_id_not_null | NOT NULL requester_id
access_request | access_request_state_known | CHECK ((state = ANY (ARRAY['open'::text, 'in_review'::text, 'answered'::text])))
access_request | access_request_state_not_null | NOT NULL state
access_request | require_audit | TRIGGER DEFERRABLE INITIALLY DEFERRED
access_request_item | access_request_item_category_format | CHECK (((category ~ '^[a-z][a-z0-9_-]*$'::text) AND (length(category) <= 60)))
