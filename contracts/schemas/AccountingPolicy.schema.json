{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "approved_at": {
      "description": "When they approved it.",
      "examples": [
        "2026-10-22T03:00:00Z"
      ],
      "format": "date-time",
      "type": "string"
    },
    "approved_by": {
      "$ref": "Person.schema.json",
      "description": "The accountant who approved it; absent until then."
    },
    "area": {
      "description": "The policy's area.",
      "examples": [
        "revenue"
      ],
      "type": "string"
    },
    "from_on": {
      "description": "The first day of the financial year it applies from.",
      "examples": [
        "2026-01-01"
      ],
      "format": "date",
      "type": "string"
    },
    "version": {
      "description": "The area's policy version: 1, 2, …",
      "examples": [
        1
      ],
      "format": "int64",
      "type": "integer"
    },
    "wording": {
      "description": "The policy.",
      "examples": [
        "Subscription revenue is recognised evenly over each billing period."
      ],
      "type": "string"
    },
    "written_at": {
      "description": "When it was recorded.",
      "examples": [
        "2026-10-21T09:30:00Z"
      ],
      "format": "date-time",
      "type": "string"
    },
    "written_by": {
      "$ref": "Person.schema.json",
      "description": "Who recorded it: they never approve it."
    },
    "you_may_approve": {
      "description": "true when the caller may approve it: they hold the Accountant role, did not record it, and it is not approved or replaced.",
      "examples": [
        true
      ],
      "type": "boolean"
    }
  },
  "required": [
    "area",
    "version",
    "from_on",
    "wording",
    "written_at",
    "you_may_approve"
  ],
  "title": "AccountingPolicy",
  "type": "object"
}
