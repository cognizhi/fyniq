{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "at": {
      "description": "When.",
      "examples": [
        "2026-11-20T02:00:00Z"
      ],
      "format": "date-time",
      "type": "string"
    },
    "by": {
      "description": "Who, as records name actors.",
      "examples": [
        "user:01928f6e-7a3b-7c41-9d2e-5f8a1b3c5e10"
      ],
      "type": "string"
    },
    "new_due_on": {
      "description": "An extension's new day, told to the requester in writing.",
      "examples": [
        "2027-01-08"
      ],
      "format": "date",
      "type": "string"
    },
    "note": {
      "description": "What was said or done.",
      "examples": [
        "Sent the report by email."
      ],
      "type": "string"
    },
    "outcome": {
      "description": "An answer's outcome.",
      "enum": [
        "provided",
        "corrected",
        "partly",
        "refused"
      ],
      "examples": [
        "provided"
      ],
      "type": "string"
    },
    "step": {
      "description": "The step.",
      "enum": [
        "acknowledged",
        "extended",
        "answered",
        "closed"
      ],
      "examples": [
        "answered"
      ],
      "type": "string"
    }
  },
  "required": [
    "step",
    "at",
    "by"
  ],
  "title": "PDRequestStepView",
  "type": "object"
}
