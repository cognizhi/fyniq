{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "checks": {
      "description": "How many checks it ran.",
      "examples": [
        10
      ],
      "format": "int64",
      "type": "integer"
    },
    "finished_at": {
      "description": "When it finished.",
      "examples": [
        "2026-11-01T02:00:03Z"
      ],
      "format": "date-time",
      "type": "string"
    },
    "ledger_revision": {
      "description": "The ledger revision it read at.",
      "examples": [
        42
      ],
      "format": "int64",
      "type": "integer"
    },
    "started_at": {
      "description": "When it started.",
      "examples": [
        "2026-11-01T02:00:00Z"
      ],
      "format": "date-time",
      "type": "string"
    },
    "trigger": {
      "description": "What ran it.",
      "enum": [
        "change",
        "nightly",
        "request"
      ],
      "examples": [
        "request"
      ],
      "type": "string"
    }
  },
  "required": [
    "trigger",
    "started_at",
    "finished_at",
    "ledger_revision",
    "checks"
  ],
  "title": "CheckRunOut",
  "type": "object"
}
