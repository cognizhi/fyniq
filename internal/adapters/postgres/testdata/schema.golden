outbox | outbox_payload_not_null | NOT NULL payload
outbox | outbox_payload_object | CHECK (((jsonb_typeof(payload) = 'object'::text) AND (octet_length((payload)::text) <= 262144)))
outbox | outbox_pkey | PRIMARY KEY (organisation_id, id)
outbox | outbox_state_known | CHECK ((state = ANY (ARRAY['pending'::text, 'dispatched'::text, 'running'::text, 'done'::text, 'failed'::text, 'unknown_outcome'::text, 'dead'::text])))
