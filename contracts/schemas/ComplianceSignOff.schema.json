{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "at": {
      "description": "When.",
      "examples": [
        "2026-10-03T02:00:00Z"
      ],
      "format": "date-time",
      "type": "string"
    },
    "by": {
      "description": "Who signed off, as records name actors.",
      "examples": [
        "user:01928f6e-7a3b-7c41-9d2e-5f8a1b3c5e10"
      ],
      "type": "string"
    },
    "by_name": {
      "description": "Their name, while they are a member.",
      "examples": [
        "Ada Tan"
      ],
      "type": "string"
    }
  },
  "required": [
    "by",
    "at"
  ],
  "title": "ComplianceSignOff",
  "type": "object"
}
