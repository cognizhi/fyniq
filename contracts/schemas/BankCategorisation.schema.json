{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "contact_id": {
      "description": "The customer or supplier it was with.",
      "examples": [
        "01928f6e-7a3b-7c41-9d2e-5f8a1b3c4e20"
      ],
      "format": "uuid",
      "type": "string"
    },
    "parts": {
      "description": "Its parts: together they make the line's amount.",
      "items": {
        "$ref": "BankPartDraft.schema.json"
      },
      "maxItems": 50,
      "minItems": 1,
      "type": [
        "array",
        "null"
      ]
    },
    "reference": {
      "description": "A reference kept with it.",
      "examples": [
        "Invoice 88213"
      ],
      "maxLength": 140,
      "type": "string"
    }
  },
  "required": [
    "parts"
  ],
  "title": "BankCategorisation",
  "type": "object"
}
