CREATE UNIQUE INDEX idempotency_key_pkey ON fyniq.idempotency_key USING btree (organisation_id, id)
CREATE UNIQUE INDEX installation_pkey ON fyniq.installation USING btree (singleton)
CREATE UNIQUE INDEX job_slot_pkey ON fyniq.job_slot USING btree (job, slot)
CREATE UNIQUE INDEX journal_entry_pkey ON fyniq.journal_entry USING btree (organisation_id, id)
