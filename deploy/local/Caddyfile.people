# Nemura's own origin, as behind its production hostname (PRD-002 NM-INT-12: each app has its own origin and its own session). `PEOPLE=yes make up`
# serves it on http://localhost:8180 (NEMURA_HTTP_PORT). The API is under /api, its OAuth server's public endpoints under /oauth, and the web app, embedded in the nemura binary, is everything else.
{
	auto_https off
	admin off
}

:8080 {
	encode zstd gzip

	handle_path /api/* {
		reverse_proxy nemura-api:8080
	}
	# Nemura's OAuth server's public endpoints (token, discovery, JWKS); its admin port is internal.
	handle_path /oauth/* {
		reverse_proxy nemura-oauth:4444
	}
	# The sign-in routes are browser navigations on the API (/auth/…), reached through /api like every route.
	# Everything else is Nemura's web app, embedded in the nemura binary (NM-ARC-02), with its own security headers.
	handle {
		reverse_proxy nemura-api:8080
	}

	header {
		-Server
	}
}
