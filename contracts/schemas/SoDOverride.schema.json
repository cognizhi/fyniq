{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "approval_id": {
      "description": "The approved request that holds it.",
      "examples": [
        "01928f6e-7a3b-7c41-9d2e-5f8a1b3c4f30"
      ],
      "format": "uuid",
      "type": "string"
    },
    "conflict": {
      "description": "The conflict (PRD-001 §6.3).",
      "examples": [
        "SOD-6"
      ],
      "type": "string"
    },
    "created_at": {
      "description": "When it was recorded.",
      "examples": [
        "2026-10-20T09:30:00Z"
      ],
      "format": "date-time",
      "type": "string"
    },
    "display_name": {
      "description": "Their name.",
      "examples": [
        "Wei Ling Tan"
      ],
      "type": "string"
    },
    "reason": {
      "description": "Why they keep it.",
      "examples": [
        "Founder who also keeps the books until we hire"
      ],
      "type": "string"
    },
    "team_mode_version": {
      "description": "The version of the team mode it is for: a later switch lists the conflict again.",
      "examples": [
        1
      ],
      "format": "int64",
      "type": "integer"
    },
    "user_id": {
      "description": "The member's user.",
      "examples": [
        "01928f6e-7a3b-7c41-9d2e-5f8a1b3c4d01"
      ],
      "format": "uuid",
      "type": "string"
    }
  },
  "required": [
    "user_id",
    "display_name",
    "conflict",
    "reason",
    "team_mode_version",
    "approval_id",
    "created_at"
  ],
  "title": "SoDOverride",
  "type": "object"
}
