{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "accounts": {
      "description": "Each workbook account, in the sheet's order.",
      "items": {
        "$ref": "MigrationAccountMap.schema.json"
      },
      "type": "array"
    },
    "bank_rules": {
      "description": "The bank rules, in order.",
      "items": {
        "$ref": "MigrationRuleMap.schema.json"
      },
      "type": "array"
    },
    "budget_lines": {
      "description": "Each P\u0026L line of the Budget sheet.",
      "items": {
        "$ref": "MigrationLineMap.schema.json"
      },
      "type": "array"
    },
    "departments": {
      "description": "Each department of the Employees sheet, as a value of the Department dimension (rev 0.254).",
      "items": {
        "$ref": "MigrationValueMap.schema.json"
      },
      "type": "array"
    },
    "errors": {
      "description": "The errors.",
      "examples": [
        0
      ],
      "format": "int64",
      "type": "integer"
    },
    "gst_codes": {
      "description": "Each workbook GST code.",
      "items": {
        "$ref": "MigrationCodeMap.schema.json"
      },
      "type": "array"
    },
    "made_at": {
      "description": "When.",
      "examples": [
        "2026-11-13T09:05:20Z"
      ],
      "format": "date-time",
      "type": "string"
    },
    "made_by": {
      "description": "Who made the version: the validation, or a person.",
      "examples": [
        "system:migration.validate"
      ],
      "type": "string"
    },
    "problems": {
      "description": "What the version gets wrong against the organisation's set-up now: each an error that stops the sign-off.",
      "items": {
        "$ref": "MigrationProblem.schema.json"
      },
      "type": "array"
    },
    "projects": {
      "description": "Each project the records name, as a value of the Project dimension (rev 0.254).",
      "items": {
        "$ref": "MigrationValueMap.schema.json"
      },
      "type": "array"
    },
    "sha256": {
      "description": "The SHA-256 of the version as kept: what the sign-off names.",
      "examples": [
        "5d1e…"
      ],
      "type": "string"
    },
    "signed": {
      "description": "Whether the Accountant signed this version; a later version needs its own sign-off.",
      "examples": [
        false
      ],
      "type": "boolean"
    },
    "signed_at": {
      "description": "When.",
      "examples": [
        "2026-11-13T10:00:00Z"
      ],
      "format": "date-time",
      "type": "string"
    },
    "signed_by": {
      "description": "Who signed it.",
      "examples": [
        "user:01928f6e-7a3b-7c41-9d2e-5f8a1b3c5e10"
      ],
      "type": "string"
    },
    "step_id": {
      "description": "The M1 step whose workbook it maps.",
      "examples": [
        "01928f6e-7a3b-7c41-9d2e-5f8a1b3c6a20"
      ],
      "format": "uuid",
      "type": "string"
    },
    "version": {
      "description": "The version: the validation proposes one from each valid workbook, and each change makes the next.",
      "examples": [
        2
      ],
      "format": "int64",
      "type": "integer"
    }
  },
  "required": [
    "version",
    "step_id",
    "sha256",
    "made_by",
    "made_at",
    "signed",
    "accounts",
    "gst_codes",
    "departments",
    "projects",
    "budget_lines",
    "bank_rules",
    "problems",
    "errors"
  ],
  "title": "MigrationMappingView",
  "type": "object"
}
