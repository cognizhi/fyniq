## triggers
CREATE CONSTRAINT TRIGGER accountant_review_reopened AFTER INSERT ON fyniq.period_reopen DEFERRABLE INITIALLY DEFERRED FOR EACH ROW EXECUTE FUNCTION accountant_review_reopened()
CREATE CONSTRAINT TRIGGER ai_connection_versioned AFTER INSERT OR UPDATE ON fyniq.ai_connection DEFERRABLE INITIALLY DEFERRED FOR EACH ROW EXECUTE FUNCTION ai_connection_versioned()
CREATE CONSTRAINT TRIGGER board_pack_pdf_guard AFTER INSERT OR UPDATE OF status ON fyniq.document DEFERRABLE INITIALLY DEFERRED FOR EACH ROW WHEN (((new.type = 'board_pack_pdf'::text) AND (new.status = ANY (ARRAY['posted'::text, 'reversed'::text])))) EXECUTE FUNCTION board_pack_pdf_guard()
CREATE CONSTRAINT TRIGGER break_glass_logged AFTER INSERT ON fyniq.break_glass DEFERRABLE INITIALLY DEFERRED FOR EACH ROW EXECUTE FUNCTION break_glass_logged()
CREATE CONSTRAINT TRIGGER claimant_bank_change_approved AFTER INSERT OR UPDATE OF status ON fyniq.document DEFERRABLE INITIALLY DEFERRED FOR EACH ROW WHEN (((new.type = 'claimant_bank_change'::text) AND (new.status = 'posted'::text))) EXECUTE FUNCTION payee_bank_change_approved()
CREATE CONSTRAINT TRIGGER contact_member_approved AFTER UPDATE OF member_user_id ON fyniq.contact DEFERRABLE INITIALLY DEFERRED FOR EACH ROW WHEN ((new.member_user_id IS DISTINCT FROM old.member_user_id)) EXECUTE FUNCTION contact_member_approved()
CREATE CONSTRAINT TRIGGER director_fee_approved AFTER INSERT OR UPDATE OF status ON fyniq.document DEFERRABLE INITIALLY DEFERRED FOR EACH ROW WHEN (((new.type = 'director_fee'::text) AND (new.status = 'posted'::text))) EXECUTE FUNCTION director_fee_approved()
CREATE CONSTRAINT TRIGGER director_repayment_released AFTER INSERT OR UPDATE OF status ON fyniq.document DEFERRABLE INITIALLY DEFERRED FOR EACH ROW WHEN (((new.type = 'director_repayment'::text) AND (new.status = 'posted'::text))) EXECUTE FUNCTION director_repayment_released()
CREATE CONSTRAINT TRIGGER director_settlement_approved AFTER INSERT OR UPDATE OF status ON fyniq.document DEFERRABLE INITIALLY DEFERRED FOR EACH ROW WHEN (((new.type = 'director_settlement'::text) AND (new.status = 'posted'::text))) EXECUTE FUNCTION director_settlement_approved()
CREATE CONSTRAINT TRIGGER document_edit_posted AFTER UPDATE OF current_version ON fyniq.document DEFERRABLE INITIALLY DEFERRED FOR EACH ROW WHEN (((old.status = 'posted'::text) AND (new.current_version <> old.current_version))) EXECUTE FUNCTION document_edit_posted()
CREATE CONSTRAINT TRIGGER document_reversed_posted AFTER UPDATE OF status ON fyniq.document DEFERRABLE INITIALLY DEFERRED FOR EACH ROW WHEN (((old.status = 'posted'::text) AND (new.status = 'reversed'::text))) EXECUTE FUNCTION document_reversed_posted()
CREATE CONSTRAINT TRIGGER email_message_remittance_send AFTER INSERT ON fyniq.email_message DEFERRABLE INITIALLY DEFERRED FOR EACH ROW WHEN (((CURRENT_USER = 'fyniq_worker'::name) AND (new.purpose = 'remittance'::text))) EXECUTE FUNCTION remittance_email_sent()
CREATE CONSTRAINT TRIGGER email_message_scheduled_send AFTER INSERT ON fyniq.email_message DEFERRABLE INITIALLY DEFERRED FOR EACH ROW WHEN (((CURRENT_USER = 'fyniq_worker'::name) AND (new.purpose = 'invoice'::text))) EXECUTE FUNCTION scheduled_invoice_email_sent()
CREATE CONSTRAINT TRIGGER equity_transaction_entry_registered AFTER INSERT ON fyniq.journal_entry DEFERRABLE INITIALLY DEFERRED FOR EACH ROW WHEN ((new.source_type = 'equity_transaction'::text)) EXECUTE FUNCTION equity_transaction_entry_registered()
CREATE CONSTRAINT TRIGGER expense_claim_approved AFTER INSERT OR UPDATE OF status ON fyniq.document DEFERRABLE INITIALLY DEFERRED FOR EACH ROW WHEN (((new.type = 'expense_claim'::text) AND (new.status = 'posted'::text))) EXECUTE FUNCTION expense_claim_approved()
CREATE CONSTRAINT TRIGGER holding_movement_settled AFTER INSERT ON fyniq.holding_movement DEFERRABLE INITIALLY DEFERRED FOR EACH ROW EXECUTE FUNCTION holding_movement_settled()
CREATE CONSTRAINT TRIGGER journal_entry_balanced AFTER INSERT ON fyniq.journal_entry DEFERRABLE INITIALLY DEFERRED FOR EACH ROW EXECUTE FUNCTION check_entry_balanced()
CREATE CONSTRAINT TRIGGER journal_line_balanced AFTER INSERT ON fyniq.journal_line DEFERRABLE INITIALLY DEFERRED FOR EACH ROW EXECUTE FUNCTION check_entry_balanced()
CREATE CONSTRAINT TRIGGER journal_line_base_only AFTER INSERT ON fyniq.journal_line DEFERRABLE INITIALLY DEFERRED FOR EACH ROW WHEN (((new.amount = (0)::numeric) AND (new.base_amount <> (0)::numeric))) EXECUTE FUNCTION journal_line_base_only()
CREATE CONSTRAINT TRIGGER ledger_boundary_carried AFTER INSERT ON fyniq.ledger_boundary DEFERRABLE INITIALLY DEFERRED FOR EACH ROW EXECUTE FUNCTION ledger_boundary_carried()
CREATE CONSTRAINT TRIGGER payee_bank_change_approved AFTER INSERT OR UPDATE OF status ON fyniq.document DEFERRABLE INITIALLY DEFERRED FOR EACH ROW WHEN (((new.type = 'payee_bank_change'::text) AND (new.status = 'posted'::text))) EXECUTE FUNCTION payee_bank_change_approved()
CREATE CONSTRAINT TRIGGER payment_batch_approved AFTER INSERT OR UPDATE OF status ON fyniq.document DEFERRABLE INITIALLY DEFERRED FOR EACH ROW WHEN (((new.type = 'payment_batch'::text) AND (new.status = 'posted'::text))) EXECUTE FUNCTION payment_batch_approved()
