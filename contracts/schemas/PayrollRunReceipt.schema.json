{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "entry_id": {
      "description": "The journal entry it posted.",
      "examples": [
        "01928f6e-7a3b-7c41-9d2e-5f8a1b3c4d77"
      ],
      "format": "uuid",
      "type": "string"
    },
    "event_id": {
      "description": "The event's ID.",
      "examples": [
        "01928f6e-7a3b-7c41-9d2e-5f8a1b3c4d77"
      ],
      "format": "uuid",
      "type": "string"
    },
    "outcome": {
      "description": "posted: the difference is in the ledger; unchanged: the version states the figures already posted, so nothing posted; duplicate: the event was received before.",
      "enum": [
        "posted",
        "unchanged",
        "duplicate"
      ],
      "examples": [
        "posted"
      ],
      "type": "string"
    },
    "posting_date": {
      "description": "The day it posted: the wage month's last day, or the current open month's day when the wage month is closed (FR-PPL-11).",
      "examples": [
        "2026-10-31"
      ],
      "format": "date",
      "type": "string"
    },
    "run_id": {
      "description": "The run.",
      "examples": [
        "01928f6e-7a3b-7c41-9d2e-5f8a1b3c4d77"
      ],
      "format": "uuid",
      "type": "string"
    },
    "version": {
      "description": "The version.",
      "examples": [
        2
      ],
      "format": "int64",
      "type": "integer"
    }
  },
  "required": [
    "event_id",
    "outcome"
  ],
  "title": "PayrollRunReceipt",
  "type": "object"
}
