{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "body": {
      "examples": [
        "Claims are made within 30 days of the receipt date."
      ],
      "type": "string"
    },
    "data_class": {
      "enum": [
        "general",
        "personal",
        "payroll",
        "equity"
      ],
      "examples": [
        "general"
      ],
      "type": "string"
    },
    "key": {
      "examples": [
        "expense-policy"
      ],
      "type": "string"
    },
    "kind": {
      "enum": [
        "note",
        "policy",
        "decision"
      ],
      "examples": [
        "policy"
      ],
      "type": "string"
    },
    "saved_at": {
      "examples": [
        "2026-11-19T08:00:00Z"
      ],
      "format": "date-time",
      "type": "string"
    },
    "saved_by": {
      "description": "Who last saved it: user:\u003cid\u003e.",
      "examples": [
        "user:0193a3f2-7c1e-7a2b-9c4d-5e6f70819a2d"
      ],
      "type": "string"
    },
    "title": {
      "examples": [
        "Expense policy"
      ],
      "type": "string"
    },
    "version": {
      "description": "Its version; the ETag carries it for If-Match.",
      "examples": [
        2
      ],
      "format": "int64",
      "type": "integer"
    }
  },
  "required": [
    "key",
    "kind",
    "title",
    "body",
    "data_class",
    "version",
    "saved_by",
    "saved_at"
  ],
  "title": "KBNote",
  "type": "object"
}
