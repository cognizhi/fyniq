{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "approval_asked": {
      "description": "getJournal only: the pending request to post or to reverse it, while one waits for approval (FM-1, FM-2).",
      "examples": [
        "01928f6e-7a3b-7c41-9d2e-5f8a1b3c4dd1"
      ],
      "format": "uuid",
      "type": "string"
    },
    "date": {
      "description": "The date it belongs to.",
      "examples": [
        "2026-10-31"
      ],
      "format": "date",
      "type": "string"
    },
    "id": {
      "description": "The journal's ID.",
      "examples": [
        "01928f6e-7a3b-7c41-9d2e-5f8a1b3c4d70"
      ],
      "format": "uuid",
      "type": "string"
    },
    "lines": {
      "description": "The lines as entered.",
      "items": {
        "$ref": "JournalLineDraft.schema.json"
      },
      "type": [
        "array",
        "null"
      ]
    },
    "memo": {
      "description": "What it is for.",
      "examples": [
        "October rent accrual"
      ],
      "type": "string"
    },
    "number": {
      "description": "Its number from the journal sequence: given when it posts, or when it is saved if the sequence is not gap-free; absent before (FR-ORG-04).",
      "examples": [
        "JNL-0042"
      ],
      "type": "string"
    },
    "posted_at": {
      "description": "When it was posted.",
      "examples": [
        "2026-10-31T09:30:00Z"
      ],
      "format": "date-time",
      "type": "string"
    },
    "posted_by": {
      "$ref": "Person.schema.json",
      "description": "Who posted it, once posted; absent for journals from before it was recorded."
    },
    "prepared_by": {
      "$ref": "Person.schema.json",
      "description": "Who saved the current version; absent for journals from before it was recorded."
    },
    "status": {
      "description": "Draft (✎), posted, or reversed by a reversing entry.",
      "enum": [
        "draft",
        "posted",
        "reversed"
      ],
      "examples": [
        "draft"
      ],
      "type": "string"
    },
    "version": {
      "description": "The version of its content; with the status it makes the ETag.",
      "examples": [
        1
      ],
      "format": "int64",
      "type": "integer"
    }
  },
  "required": [
    "id",
    "status",
    "version",
    "lines"
  ],
  "title": "Journal",
  "type": "object"
}
