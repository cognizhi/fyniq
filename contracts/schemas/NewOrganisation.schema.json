{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "base_currency": {
      "default": "SGD",
      "description": "The ISO 4217 currency its books are kept in; SGD when left out (FR-ORG-02).",
      "examples": [
        "SGD"
      ],
      "pattern": "^[A-Z]{3}$",
      "type": "string"
    },
    "name": {
      "description": "The organisation's name.",
      "examples": [
        "Northwind Analytics Pte. Ltd."
      ],
      "maxLength": 200,
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "name"
  ],
  "title": "NewOrganisation",
  "type": "object"
}
