{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "at": {
      "description": "When.",
      "examples": [
        "2026-11-09T02:00:00Z"
      ],
      "format": "date-time",
      "type": "string"
    },
    "by": {
      "description": "Who approved it, as records name actors.",
      "examples": [
        "user:01928f6e-7a3b-7c41-9d2e-5f8a1b3c5e10"
      ],
      "type": "string"
    },
    "version": {
      "description": "The version approved.",
      "examples": [
        2
      ],
      "format": "int64",
      "type": "integer"
    }
  },
  "required": [
    "version",
    "by",
    "at"
  ],
  "title": "DPIAApprovalRef",
  "type": "object"
}
