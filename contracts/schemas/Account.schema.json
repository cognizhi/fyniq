{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "active": {
      "description": "An inactive account takes no new postings.",
      "examples": [
        true
      ],
      "type": "boolean"
    },
    "code": {
      "description": "The account code.",
      "examples": [
        "6100"
      ],
      "type": "string"
    },
    "group": {
      "description": "A group account is a heading: postings go to the accounts under it.",
      "examples": [
        false
      ],
      "type": "boolean"
    },
    "id": {
      "description": "The account's ID.",
      "examples": [
        "01928f6e-7a3b-7c41-9d2e-5f8a1b3c4d60"
      ],
      "format": "uuid",
      "type": "string"
    },
    "name": {
      "description": "The account name.",
      "examples": [
        "Rent"
      ],
      "type": "string"
    },
    "parent_id": {
      "description": "The group account it sits under, or null.",
      "examples": [
        "01928f6e-7a3b-7c41-9d2e-5f8a1b3c4d61"
      ],
      "format": "uuid",
      "type": [
        "string",
        "null"
      ]
    },
    "type": {
      "description": "The account type.",
      "enum": [
        "asset",
        "liability",
        "equity",
        "revenue",
        "expense"
      ],
      "examples": [
        "expense"
      ],
      "type": "string"
    },
    "version": {
      "description": "The record's version; it also makes the ETag.",
      "examples": [
        1
      ],
      "format": "int64",
      "type": "integer"
    }
  },
  "required": [
    "id",
    "code",
    "name",
    "type",
    "parent_id",
    "group",
    "active",
    "version"
  ],
  "title": "Account",
  "type": "object"
}
