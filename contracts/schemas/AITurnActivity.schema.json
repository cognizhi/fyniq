{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "answered_at": {
      "examples": [
        "2026-11-15T08:00:04Z"
      ],
      "format": "date-time",
      "type": "string"
    },
    "asked_at": {
      "examples": [
        "2026-11-15T08:00:00Z"
      ],
      "format": "date-time",
      "type": "string"
    },
    "cited": {
      "description": "How many facts its answer cites.",
      "examples": [
        2
      ],
      "format": "int64",
      "type": "integer"
    },
    "classes": {
      "description": "The classes of data it read (AI-83).",
      "items": {
        "description": "A class of data: restricted data never goes to an AI provider (AI-75).",
        "enum": [
          "know-how",
          "business-figures",
          "personal-data",
          "payroll"
        ],
        "examples": [
          "business-figures"
        ],
        "type": "string"
      },
      "type": "array"
    },
    "code": {
      "examples": [
        "AI-LIMIT-01"
      ],
      "type": "string"
    },
    "conversation_id": {
      "examples": [
        "0193a3f2-7c1e-7a2b-9c4d-5e6f70819a2b"
      ],
      "format": "uuid",
      "type": "string"
    },
    "cost": {
      "description": "Its model calls' cost in the base currency, exact; 0 when none was priced (QA-AI-04).",
      "examples": [
        "0.0213"
      ],
      "type": "string"
    },
    "id": {
      "examples": [
        "0193a3f2-7c1e-7a2b-9c4d-5e6f70819a2c"
      ],
      "format": "uuid",
      "type": "string"
    },
    "input_tokens": {
      "examples": [
        2400
      ],
      "format": "int64",
      "type": "integer"
    },
    "masked": {
      "description": "It read payroll and you may not see payroll unmasked: its question is withheld (FR-PAY-13).",
      "examples": [
        false
      ],
      "type": "boolean"
    },
    "output_tokens": {
      "examples": [
        310
      ],
      "format": "int64",
      "type": "integer"
    },
    "person": {
      "description": "Who asked: user:\u003cid\u003e.",
      "examples": [
        "user:0193a3f2-7c1e-7a2b-9c4d-5e6f70819a2d"
      ],
      "type": "string"
    },
    "prompt": {
      "description": "The system prompt it was told, and its hash (AI-24).",
      "examples": [
        "chat@2"
      ],
      "type": "string"
    },
    "prompt_sha256": {
      "examples": [
        "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
      ],
      "type": "string"
    },
    "question": {
      "description": "What was asked; absent when masked.",
      "examples": [
        "What is our cash runway?"
      ],
      "type": "string"
    },
    "regenerated": {
      "description": "Its answer failed the figures' check once (AI-08).",
      "examples": [
        false
      ],
      "type": "boolean"
    },
    "runs": {
      "description": "Its model calls' runs, whose attempts listAIActivity shows.",
      "items": {
        "description": "A model call's run.",
        "examples": [
          "0193a3f2-7c1e-7a2b-9c4d-5e6f70819a42"
        ],
        "format": "uuid",
        "type": "string"
      },
      "type": "array"
    },
    "screening_flags": {
      "description": "Screening stopped it, or withheld the text of so many of its reads (AI-P7, QA-AI-04).",
      "examples": [
        0
      ],
      "format": "int64",
      "type": "integer"
    },
    "status": {
      "enum": [
        "answering",
        "answered",
        "refused",
        "failed"
      ],
      "examples": [
        "answered"
      ],
      "type": "string"
    },
    "tool_calls": {
      "items": {
        "$ref": "AITurnToolCall.schema.json"
      },
      "type": "array"
    },
    "tool_errors": {
      "description": "Its reads refused or failed (QA-AI-04).",
      "examples": [
        0
      ],
      "format": "int64",
      "type": "integer"
    },
    "withheld": {
      "description": "Figures or words withheld after the check.",
      "examples": [
        0
      ],
      "format": "int64",
      "type": "integer"
    }
  },
  "required": [
    "id",
    "conversation_id",
    "person",
    "status",
    "runs",
    "input_tokens",
    "output_tokens",
    "classes",
    "cited",
    "regenerated",
    "withheld",
    "tool_errors",
    "screening_flags",
    "cost",
    "tool_calls",
    "asked_at",
    "masked"
  ],
  "title": "AITurnActivity",
  "type": "object"
}
