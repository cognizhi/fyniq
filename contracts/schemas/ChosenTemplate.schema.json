{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "id": {
      "description": "The template.",
      "examples": [
        "01928f6e-7a3b-7c41-9d2e-5f8a1b3c4f10"
      ],
      "format": "uuid",
      "type": "string"
    },
    "name": {
      "description": "Its name.",
      "examples": [
        "Standard invoice"
      ],
      "type": "string"
    },
    "published_version": {
      "description": "Its version in force, which renders the documents.",
      "examples": [
        2
      ],
      "format": "int64",
      "type": "integer"
    }
  },
  "required": [
    "id",
    "name",
    "published_version"
  ],
  "title": "ChosenTemplate",
  "type": "object"
}
