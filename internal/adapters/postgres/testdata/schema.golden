## constraints
access_review_attestation | access_review_attestation_after_its_quarter | CHECK ((attested_at >= (quarter + '3 mons'::interval)))
access_review_attestation | access_review_attestation_attested_at_not_null | NOT NULL attested_at
access_review_attestation | access_review_attestation_attested_by | CHECK ((attested_by ~ '^[a-z][a-z_]{0,19}:[!-~]{1,200}$'::text))
access_review_attestation | access_review_attestation_attested_by_not_null | NOT NULL attested_by
access_review_attestation | access_review_attestation_id_not_null | NOT NULL id
access_review_attestation | access_review_attestation_note | CHECK (((length(note) >= 1) AND (length(note) <= 1000)))
access_review_attestation | access_review_attestation_organisation_fkey | FOREIGN KEY (organisation_id) REFERENCES organisation(organisation_id)
access_review_attestation | access_review_attestation_organisation_id_not_null | NOT NULL organisation_id
access_review_attestation | access_review_attestation_pkey | PRIMARY KEY (organisation_id, id)
access_review_attestation | access_review_attestation_quarter_key | UNIQUE (organisation_id, quarter)
access_review_attestation | access_review_attestation_quarter_not_null | NOT NULL quarter
access_review_attestation | access_review_attestation_quarter_start | CHECK ((quarter = (date_trunc('quarter'::text, (quarter)::timestamp with time zone))::date))
access_review_attestation | access_review_attestation_report | CHECK ((octet_length(report) <= 1048576))
access_review_attestation | access_review_attestation_report_hash | CHECK ((report_hash = sha256(convert_to(report, 'UTF8'::name))))
access_review_attestation | access_review_attestation_report_hash_not_null | NOT NULL report_hash
access_review_attestation | access_review_attestation_report_not_null | NOT NULL report
access_review_attestation | require_audit | TRIGGER DEFERRABLE INITIALLY DEFERRED
account | account_attribute_lengths | CHECK ((((length(report_group) >= 1) AND (length(report_group) <= 60)) AND ((length(cash_flow_line) >= 1) AND (length(cash_flow_line) <= 60)) AND ((length(guidance) >= 1) AND (length(guidance) <= 500))))
account | account_code_format | CHECK ((code ~ '^[0-9A-Za-z][0-9A-Za-z.-]{0,19}$'::text))
account | account_code_key | UNIQUE (organisation_id, code)
account | account_code_not_null | NOT NULL code
account | account_created_at_not_null | NOT NULL created_at
account | account_currency_format | CHECK ((currency ~ '^[A-Z]{3}$'::text))
account | account_function_known | CHECK ((function = ANY (ARRAY['COGS'::text, 'R&D'::text, 'S&M'::text, 'G&A'::text, 'Other'::text])))
account | account_gst_code_format | CHECK ((default_gst_code ~ '^[A-Z]{2,4}$'::text))
account | account_id_not_null | NOT NULL id
account | account_is_active_not_null | NOT NULL is_active
account | account_is_control_not_null | NOT NULL is_control
account | account_is_group_not_null | NOT NULL is_group
account | account_is_money_account_not_null | NOT NULL is_money_account
account | account_is_payroll_cost_not_null | NOT NULL is_payroll_cost
account | account_merged_into_fkey | FOREIGN KEY (organisation_id, merged_into_id) REFERENCES account(organisation_id, id)
account | account_name_length | CHECK (((length(btrim(name)) >= 1) AND (length(btrim(name)) <= 200)))
account | account_name_not_null | NOT NULL name
account | account_not_own_parent | CHECK ((parent_id <> id))
account | account_organisation_fkey | FOREIGN KEY (organisation_id) REFERENCES organisation(organisation_id)
account | account_organisation_id_not_null | NOT NULL organisation_id
account | account_parent_fkey | FOREIGN KEY (organisation_id, parent_id) REFERENCES account(organisation_id, id)
account | account_pkey | PRIMARY KEY (organisation_id, id)
account | account_required_dimension_ids_not_null | NOT NULL required_dimension_ids
account | account_revalue_monetary | CHECK (((NOT revalue) OR ((type = ANY (ARRAY['asset'::text, 'liability'::text])) AND (role IS DISTINCT FROM 'prepayments'::text) AND (role IS DISTINCT FROM 'deferred-revenue'::text) AND (role IS DISTINCT FROM 'customer-deposits'::text))))
account | account_revalue_not_null | NOT NULL revalue
account | account_role_known | CHECK ((role = ANY (ARRAY['accounts-receivable'::text, 'accounts-payable'::text, 'gst-control'::text, 'fx-rounding'::text, 'unrealised-fx'::text, 'deferred-revenue'::text, 'prepayments'::text, 'salaries-payable'::text, 'cpf-sdl-payable'::text, 'employer-cpf'::text, 'sdl'::text, 'depreciation'::text, 'accumulated-depreciation'::text, 'suspense'::text, 'retained-earnings'::text, 'expense-claims-payable'::text, 'income-tax-payable'::text, 'income-tax-expense'::text, 'director-loan'::text, 'deferred-remuneration'::text, 'share-capital'::text, 'capital-contribution'::text, 'withholding-tax-payable'::text, 'customer-deposits'::text, 'share-application-monies'::text, 'convertible-instruments'::text, 'opening-balance-clearing'::text])))
account | account_type_known | CHECK ((type = ANY (ARRAY['asset'::text, 'liability'::text, 'equity'::text, 'revenue'::text, 'expense'::text])))
account | account_type_not_null | NOT NULL type
account | account_useful_life_months | CHECK (((useful_life_months >= 1) AND (useful_life_months <= 600)))
account | account_version_not_null | NOT NULL version
account | account_version_positive | CHECK ((version > 0))
account | require_audit | TRIGGER DEFERRABLE INITIALLY DEFERRED
