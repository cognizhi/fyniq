{
  "name": "lineage.explain",
  "title": "Explain where a fact comes from",
  "version": 1,
  "description": "Explains a fact from metrics.query in this conversation: the accounts, journal lines and source documents behind it, as the person asking may see them, largest first. Give the fact's ID with the measure, months, dimension, member and revision it came with; a fact whose ID does not match them is refused, so copy them from the fact unchanged.",
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["fact", "measure", "from", "to", "revision"],
    "properties": {
      "fact": {
        "type": "string",
        "description": "The fact's ID.",
        "pattern": "^F[0-9a-f]{16}$"
      },
      "measure": {
        "type": "string",
        "description": "The fact's measure.",
        "maxLength": 40
      },
      "from": {
        "type": "string",
        "description": "The fact's first month, YYYY-MM.",
        "pattern": "^[0-9]{4}-[0-9]{2}$"
      },
      "to": {
        "type": "string",
        "description": "The fact's last month, YYYY-MM.",
        "pattern": "^[0-9]{4}-[0-9]{2}$"
      },
      "by": {
        "type": "string",
        "description": "The fact's dimension, if it has one.",
        "enum": ["account", "customer", "vendor", "department"]
      },
      "member": {
        "type": "string",
        "description": "The fact's dimension member, if it has one.",
        "maxLength": 60
      },
      "revision": {
        "type": "integer",
        "description": "The fact's ledger revision.",
        "minimum": 1
      }
    }
  },
  "annotations": {"readOnlyHint": true, "destructiveHint": false, "idempotentHint": true, "openWorldHint": false},
  "runs": "api",
  "scope": "ai.read",
  "limits": {"rows": 50, "timeout_ms": 5000, "result_tokens": 4000}
}
