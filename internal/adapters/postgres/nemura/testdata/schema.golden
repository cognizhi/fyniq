outbox | outbox_updated_at_not_null | NOT NULL updated_at
outbox | outbox_worker_class_known | CHECK ((worker_class = ANY (ARRAY['worker'::text, 'executor'::text])))
outbox | outbox_worker_class_not_null | NOT NULL worker_class
reporting_line | reporting_line_created_at_not_null | NOT NULL created_at
reporting_line | reporting_line_dates | CHECK (((effective_to IS NULL) OR (effective_to > effective_from)))
reporting_line | reporting_line_effective_from_not_null | NOT NULL effective_from
reporting_line | reporting_line_id_not_null | NOT NULL id
reporting_line | reporting_line_manager_fkey | FOREIGN KEY (organisation_id, manager_id) REFERENCES nemura.member(organisation_id, id)
reporting_line | reporting_line_manager_id_not_null | NOT NULL manager_id
reporting_line | reporting_line_not_self | CHECK ((report_id <> manager_id))
reporting_line | reporting_line_once | UNIQUE (organisation_id, report_id, manager_id, effective_from)
reporting_line | reporting_line_organisation_fkey | FOREIGN KEY (organisation_id) REFERENCES nemura.organisation(organisation_id)
reporting_line | reporting_line_organisation_id_not_null | NOT NULL organisation_id
reporting_line | reporting_line_pkey | PRIMARY KEY (organisation_id, id)
reporting_line | reporting_line_report_fkey | FOREIGN KEY (organisation_id, report_id) REFERENCES nemura.member(organisation_id, id)
reporting_line | reporting_line_report_id_not_null | NOT NULL report_id
reporting_line | require_audit | TRIGGER DEFERRABLE INITIALLY DEFERRED
role_assignment | require_audit | TRIGGER DEFERRABLE INITIALLY DEFERRED
role_assignment | role_assignment_approval_fkey | FOREIGN KEY (organisation_id, approval_id) REFERENCES nemura.approval_request(organisation_id, id)
role_assignment | role_assignment_created_at_not_null | NOT NULL created_at
role_assignment | role_assignment_dates | CHECK (((effective_to IS NULL) OR (effective_to > effective_from)))
role_assignment | role_assignment_effective_from_not_null | NOT NULL effective_from
role_assignment | role_assignment_granted_by_fkey | FOREIGN KEY (organisation_id, granted_by) REFERENCES nemura.member(organisation_id, id)
role_assignment | role_assignment_id_not_null | NOT NULL id
role_assignment | role_assignment_member_fkey | FOREIGN KEY (organisation_id, member_id) REFERENCES nemura.member(organisation_id, id)
role_assignment | role_assignment_member_id_not_null | NOT NULL member_id
role_assignment | role_assignment_not_self | CHECK (((granted_by IS NULL) OR (granted_by <> member_id)))
role_assignment | role_assignment_once | UNIQUE (organisation_id, member_id, role, effective_from)
role_assignment | role_assignment_organisation_fkey | FOREIGN KEY (organisation_id) REFERENCES nemura.organisation(organisation_id)
role_assignment | role_assignment_organisation_id_not_null | NOT NULL organisation_id
role_assignment | role_assignment_pkey | PRIMARY KEY (organisation_id, id)
role_assignment | role_assignment_privileged_approved | CHECK (((role <> ALL (ARRAY['payroll_admin'::text, 'owner'::text])) OR (granted_by IS NULL) OR (approval_id IS NOT NULL)))
role_assignment | role_assignment_role_known | CHECK ((role = ANY (ARRAY['employee'::text, 'line_manager'::text, 'hr_officer'::text, 'hr_admin'::text, 'payroll_admin'::text, 'recruiter'::text, 'interviewer'::text, 'administrator'::text, 'owner'::text])))
role_assignment | role_assignment_role_not_null | NOT NULL role
role_assignment | role_assignment_setup_is_owner | CHECK (((granted_by IS NOT NULL) OR (role = 'owner'::text)))
session | require_audit | TRIGGER DEFERRABLE INITIALLY DEFERRED
session | session_created_at_not_null | NOT NULL created_at
session | session_expires_at_not_null | NOT NULL expires_at
session | session_expiry | CHECK ((expires_at > created_at))
session | session_id_not_null | NOT NULL id
session | session_member_fkey | FOREIGN KEY (organisation_id, member_id) REFERENCES nemura.member(organisation_id, id)
session | session_member_id_not_null | NOT NULL member_id
session | session_organisation_fkey | FOREIGN KEY (organisation_id) REFERENCES nemura.organisation(organisation_id)
session | session_organisation_id_not_null | NOT NULL organisation_id
session | session_pkey | PRIMARY KEY (organisation_id, id)
session | session_token_hash_not_null | NOT NULL token_hash
session | session_token_key | UNIQUE (organisation_id, token_hash)
session | session_token_sha256 | CHECK ((length(token_hash) = 32))
tenant_directory | tenant_directory_created_at_not_null | NOT NULL created_at
tenant_directory | tenant_directory_organisation_fkey | FOREIGN KEY (organisation_id) REFERENCES nemura.organisation(organisation_id)
tenant_directory | tenant_directory_organisation_id_not_null | NOT NULL organisation_id
tenant_directory | tenant_directory_pkey | PRIMARY KEY (organisation_id)
transfer_assessment | require_audit | TRIGGER DEFERRABLE INITIALLY DEFERRED
transfer_assessment | transfer_assessment_assessed_by_not_null | NOT NULL assessed_by
transfer_assessment | transfer_assessment_assessed_on_not_null | NOT NULL assessed_on
transfer_assessment | transfer_assessment_by_fkey | FOREIGN KEY (organisation_id, assessed_by) REFERENCES nemura.member(organisation_id, id)
transfer_assessment | transfer_assessment_country | CHECK (((country ~ '^[A-Z]{2}$'::text) AND (country <> 'SG'::text)))
transfer_assessment | transfer_assessment_country_not_null | NOT NULL country
transfer_assessment | transfer_assessment_dates | CHECK ((valid_until > assessed_on))
transfer_assessment | transfer_assessment_flow_format | CHECK (((flow ~ '^[a-z][a-z0-9_-]*$'::text) AND (length(flow) <= 60)))
transfer_assessment | transfer_assessment_flow_not_null | NOT NULL flow
transfer_assessment | transfer_assessment_id_not_null | NOT NULL id
transfer_assessment | transfer_assessment_organisation_fkey | FOREIGN KEY (organisation_id) REFERENCES nemura.organisation(organisation_id)
transfer_assessment | transfer_assessment_organisation_id_not_null | NOT NULL organisation_id
transfer_assessment | transfer_assessment_pkey | PRIMARY KEY (organisation_id, id)
transfer_assessment | transfer_assessment_valid_until_not_null | NOT NULL valid_until

