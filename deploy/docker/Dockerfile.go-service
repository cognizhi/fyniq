# syntax=docker/dockerfile:1.7
#
# One Dockerfile builds every Go service and tool (PRD-001 §12.9, NFR-IMG-01…07). Each is its own
# binary and image from cmd/<SERVICE>:
#   docker build -f deploy/docker/Dockerfile.go-service --build-arg SERVICE=api \
#     --build-arg FLAVOUR=release --build-arg VERSION=0.3.0 --build-arg GIT_SHA=$(git rev-parse HEAD) .
# FLAVOUR=release (staging and production) or local (`make up`): the local flavour adds the
# `local` build tag and with it the local adapters (DEV-07). Same Dockerfile, base and hardening.
# Image budgets, scanning and signing are enforced by p0-ci-images-release. The render image is the `render`
# target (--target render: the binary with Typst); every other service the default target, `service`.
# Platforms (NFR-IMG-08): linux/amd64 and linux/arm64. Without --platform the image is the build
# machine's own (arm64 on Apple silicon, amd64 on the CI runner); `--platform linux/amd64,linux/arm64`
# builds both. The compiler runs on the build machine and cross-compiles, so no emulation is needed,
# and each pinned digest is a multi-platform index, so every stage resolves for either platform.
# Reproducible (NFR-IMG-07): the binary is built with -trimpath and no build ID or VCS stamp, every file the images copy
# has a fixed owner and mode, and the release builds (scripts/images.py publish and repro) pass SOURCE_DATE_EPOCH, the
# commit's time, and clamp every file's time in the layers to it, so the same commit gives the same digests.

# ---- build stage ------------------------------------------------------------------------
# Go 1.27.4, as mise.toml pins it: the patch release that fixes the standard library's vulnerabilities govulncheck
# finds the code reaching (SEC-26).
FROM --platform=$BUILDPLATFORM golang:1.27.4-bookworm@sha256:4fa7c968ba93f1635670522dbb01a2c78150443e1385746924566079f36570ea AS build

WORKDIR /src
COPY go.* ./
RUN --mount=type=cache,target=/go/pkg/mod go mod download
COPY cmd ./cmd
COPY internal ./internal
COPY db ./db
COPY compliance ./compliance
COPY packs ./packs
COPY connectors ./connectors
COPY evals ./evals

ARG SERVICE
ARG FLAVOUR=release
ARG VERSION=0.0.0-dev
ARG GIT_SHA=unknown
ARG BUILD_TIME=unknown
# The release tag (vX.Y.Z), passed only by the build of a published release's images; empty for every other build.
ARG RELEASE=
# Set by BuildKit from the target platform (--platform, else the build machine's).
ARG TARGETOS
ARG TARGETARCH

# CGO_ENABLED=0: a static binary for distroless/static. -trimpath, -buildid= and stamped values
# make the build reproducible (NFR-IMG-07); -s -w strip symbols; timetzdata embeds the zone data.
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    test -n "${SERVICE}" && \
    case "${FLAVOUR}" in release) tags=timetzdata ;; local) tags=timetzdata,local ;; *) echo "FLAVOUR must be release or local" >&2; exit 1 ;; esac && \
    case "${TARGETOS}/${TARGETARCH}" in linux/amd64|linux/arm64) ;; *) echo "platform ${TARGETOS}/${TARGETARCH}: build linux/amd64 or linux/arm64 with BuildKit (NFR-IMG-08)" >&2; exit 1 ;; esac && \
    CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} \
    go build -trimpath -buildvcs=false -tags "${tags}" \
      -ldflags "-s -w -buildid= \
        -X github.com/cognizhi/fyniq/internal/version.Version=${VERSION} \
        -X github.com/cognizhi/fyniq/internal/version.Commit=${GIT_SHA} \
        -X github.com/cognizhi/fyniq/internal/version.BuildTime=${BUILD_TIME} \
        -X github.com/cognizhi/fyniq/internal/version.Release=${RELEASE}" \
      -o /out/app ./cmd/${SERVICE}

# ---- Typst, for the render image only ------------------------------------------------------
# Typst 0.15.1, as mise.toml pins it: the static musl build from github.com/typst/typst/releases for the target
# platform, checked against its SHA-256 (the release's own digests), its one binary read out with Python's lzma (the
# image has no xz). The fonts are in the render binary (go:embed).
FROM --platform=$BUILDPLATFORM golang:1.27.4-bookworm@sha256:4fa7c968ba93f1635670522dbb01a2c78150443e1385746924566079f36570ea AS typst
ARG TARGETARCH
RUN case "${TARGETARCH}" in \
      amd64) t=x86_64; sum=a6d077d0a95eed5a2eba715b2dae06be954f624ccbf85758a03f389ded33118c ;; \
      arm64) t=aarch64; sum=5aa8d74a3d906e60ea12a66ac2f37f8eef1b14cbad7182a745e393a10c23dcee ;; \
      *) echo "no Typst build for ${TARGETARCH} (NFR-IMG-08)" >&2; exit 1 ;; esac && \
    curl -fsSL -o /tmp/typst.tar.xz "https://github.com/typst/typst/releases/download/v0.15.1/typst-${t}-unknown-linux-musl.tar.xz" && \
    echo "${sum}  /tmp/typst.tar.xz" | sha256sum -c - && \
    mkdir /out && python3 -c 'import lzma, sys, tarfile; t = tarfile.open(fileobj=lzma.open(sys.argv[1])); open("/out/typst", "wb").write(t.extractfile(sys.argv[2]).read())' \
      /tmp/typst.tar.xz "typst-${t}-unknown-linux-musl/typst" && chmod 0755 /out/typst

# ---- the render image (--target render) ------------------------------------------------------
# PRD-001 §12.9 (rev 0.96): the Go binary and the pinned Typst binary on distroless/static, as both are static (the
# musl build of Typst), so the image holds no C library or OpenSSL to patch; no shell, no package manager.
FROM gcr.io/distroless/static-debian12:nonroot@sha256:afa5c872c891853ca7fcf1f12c3edb23f7eeef36189728842dd51042ff57f7ab AS render
COPY --from=build --chown=0:0 --chmod=0755 /out/app /app
COPY --from=typst --chown=0:0 --chmod=0755 /out/typst /typst
ENV FYNIQ_TYPST=/typst
USER 65532:65532
EXPOSE 8080
ENTRYPOINT ["/app"]

# ---- the clamd sidecar of the scanner service (--target clamd) ----------------------------------------------
# PRD-001 rev 0.247 (FR-DOC-08, SEC-24): Debian's clamd and freshclam (bookworm, with its security updates) and only the
# packages whose libraries they link against (ldd of both; the C runtime is distroless/cc's), downloaded for the target
# platform from snapshot.debian.org at DEBIAN_SNAPSHOT (over HTTP, as apt checks the archive's signatures and the slim
# image has no CA certificates), so the same commit builds the same image (NFR-IMG-07), and unpacked without running their scripts (what a package puts in /lib goes to /usr/lib: Debian 12 is merged-usr). Each
# package's record and file list go into /var/lib/dpkg/status.d, as distroless keeps its own, so syft and grype see
# every library as its Debian package (SEC-21). Move DEBIAN_SNAPSHOT forward to take security updates.
FROM --platform=$BUILDPLATFORM debian:bookworm-slim@sha256:734a72b3d6142a71993b4bc580ca01d8ca687f77a2c422d96a961d3376b179bc AS clamav
ARG TARGETARCH
ARG DEBIAN_SNAPSHOT=20261110T000000Z
RUN set -eu; \
    rm -f /etc/apt/sources.list.d/debian.sources; \
    for suite in "debian bookworm" "debian bookworm-updates" "debian-security bookworm-security"; do \
      set -- $suite; echo "deb [check-valid-until=no] http://snapshot.debian.org/archive/$1/${DEBIAN_SNAPSHOT} $2 main"; \
    done > /etc/apt/sources.list; \
    dpkg --add-architecture "${TARGETARCH}"; \
    apt-get -o Acquire::Retries=5 update -qq; \
    mkdir -p /debs /out/var/lib/dpkg/status.d; cd /debs; \
    apt-get -o Acquire::Retries=5 download -qq $(for p in clamav-daemon clamav-freshclam libclamav12 libbrotli1 libbz2-1.0 libcap2 libcom-err2 libcurl4 libffi8 libgcrypt20 libgmp10 libgnutls30 libgpg-error0 libgssapi-krb5-2 libhogweed6 libicu72 libidn2-0 libjson-c5 libk5crypto3 libkeyutils1 libkrb5-3 libkrb5support0 libldap-2.5-0 liblz4-1 liblzma5 libmspack0 libnettle8 libnghttp2-14 libp11-kit0 libpcre2-8-0 libpsl5 librtmp1 libsasl2-2 libssh2-1 libssl3 libsystemd0 libtasn1-6 libunistring2 libxml2 libzstd1 zlib1g; do echo "$p:${TARGETARCH}"; done); \
    for d in *.deb; do \
      dpkg-deb -x "$d" /out; \
      n="$(dpkg-deb -f "$d" Package)"; \
      { dpkg-deb -f "$d"; echo "Status: install ok installed"; } > "/out/var/lib/dpkg/status.d/$n"; \
      dpkg-deb -I "$d" md5sums 2>/dev/null | sed 's|  lib/|  usr/lib/|' > "/out/var/lib/dpkg/status.d/$n.md5sums" || true; \
    done; \
    rm -rf /out/usr/share /out/etc /out/lib/systemd /out/usr/lib/systemd; \
    cp -a /out/lib/. /out/usr/lib/; rm -rf /out/lib

FROM gcr.io/distroless/cc-debian12:nonroot@sha256:9dac0a79194e45a7da0158a9c6da57b217585af0786db3845d1f0ec1a0dd182f AS clamd
COPY --from=clamav --chown=0:0 --chmod=0755 /out/usr/sbin/clamd /usr/sbin/clamd
COPY --from=clamav --chown=0:0 --chmod=0755 /out/usr/bin/freshclam /usr/bin/freshclam
COPY --from=clamav --chown=0:0 /out/usr/lib/ /usr/lib/
COPY --from=clamav --chown=0:0 /out/var/lib/dpkg/status.d/ /var/lib/dpkg/status.d/
COPY --from=build --chown=0:0 --chmod=0755 /out/app /app
USER 65532:65532
ENTRYPOINT ["/app"]

# ---- every other service (the default target) ---------------------------------------------------
# CA certificates and the nonroot user; no shell, no package manager (NFR-IMG-01).
FROM gcr.io/distroless/static-debian12:nonroot@sha256:afa5c872c891853ca7fcf1f12c3edb23f7eeef36189728842dd51042ff57f7ab AS service
COPY --from=build --chown=0:0 --chmod=0755 /out/app /app
USER 65532:65532
EXPOSE 8080
ENTRYPOINT ["/app"]
