# Local settings for `make dev` and `make up`; `make setup` copies this to .env (git-ignored).
# Local-only values: none of them is valid anywhere else (SEC-12).
FYNIQ_ENV=local
# FYNIQ_BUSINESS_DATE=2026-12-31        # the business date outside production (DEV-05)
# The database (make deps-up). `go run -tags local ./cmd/migrate up` defaults to these local roles;
# each service has its own role (SEC-03). The password is valid nowhere else.
# FYNIQ_PG_PORT=55432
# FYNIQ_DATABASE_URL=postgres://fyniq_api:fyniq-local-only@localhost:55432/fyniq?sslmode=disable
# Host ports for `make dev` and `make up`
FYNIQ_API_PORT=8081
FYNIQ_WEB_PORT=5173
FYNIQ_HTTP_PORT=8080
