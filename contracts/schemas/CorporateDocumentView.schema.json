{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "drafted_on": {
      "description": "The day it was drafted: the records it was filled from are that day's.",
      "examples": [
        "2027-01-05"
      ],
      "format": "date",
      "type": "string"
    },
    "fields": {
      "$ref": "CorporateDocumentFields.schema.json",
      "description": "The fields it was drafted with."
    },
    "id": {
      "description": "The document's ID.",
      "examples": [
        "01928f6e-7a3b-7c41-9d2e-5f8a1b3c7c01"
      ],
      "format": "uuid",
      "type": "string"
    },
    "kind": {
      "description": "Its kind.",
      "examples": [
        "directors.approve_statements"
      ],
      "type": "string"
    },
    "masked": {
      "description": "true: its fields and text are hidden for your role (the DPO).",
      "examples": [
        false
      ],
      "type": "boolean"
    },
    "note": {
      "description": "A note for the record.",
      "examples": [
        "For the AGM on 15 June"
      ],
      "type": "string"
    },
    "paper": {
      "$ref": "CorporatePaper.schema.json",
      "description": "Its text as filled from the records, as its PDF shows it; hidden when masked."
    },
    "proposal_id": {
      "description": "The AI's sec.draft_document proposal it came from, a person having approved it.",
      "examples": [
        "01928f6e-7a3b-7c41-9d2e-5f8a1b3c7c11"
      ],
      "format": "uuid",
      "type": "string"
    },
    "status": {
      "description": "draft: a paper to review and have signed; recorded: in the minute book with its signed copy.",
      "enum": [
        "draft",
        "recorded"
      ],
      "examples": [
        "draft"
      ],
      "type": "string"
    },
    "template": {
      "description": "The template it was drafted from, with its version.",
      "examples": [
        "directors.approve_statements@1"
      ],
      "type": "string"
    },
    "title": {
      "description": "Its title.",
      "examples": [
        "Directors' resolution in writing"
      ],
      "type": "string"
    },
    "version": {
      "description": "The version of its content; with its status it makes the ETag.",
      "examples": [
        1
      ],
      "format": "int64",
      "type": "integer"
    }
  },
  "required": [
    "id",
    "kind",
    "template",
    "title",
    "status",
    "version",
    "drafted_on",
    "masked",
    "fields"
  ],
  "title": "CorporateDocumentView",
  "type": "object"
}
