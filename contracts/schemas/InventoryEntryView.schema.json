{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "entry_id": {
      "description": "The entry.",
      "examples": [
        "01928f6e-7a3b-7c41-9d2e-5f8a1b3c5e10"
      ],
      "format": "uuid",
      "type": "string"
    },
    "needs_dpia": {
      "description": "Whether the processing needs a data protection impact assessment (CMP-PD-08).",
      "examples": [
        false
      ],
      "type": "boolean"
    },
    "retention": {
      "description": "How long it is kept.",
      "examples": [
        "6 months after the role is filled"
      ],
      "type": "string"
    },
    "saved_at": {
      "description": "When.",
      "examples": [
        "2026-11-09T02:00:00Z"
      ],
      "format": "date-time",
      "type": "string"
    },
    "saved_by": {
      "description": "Who saved this version, as records name actors.",
      "examples": [
        "user:01928f6e-7a3b-7c41-9d2e-5f8a1b3c5e10"
      ],
      "type": "string"
    },
    "state": {
      "description": "open while the processing goes on; retired once it stops.",
      "enum": [
        "open",
        "retired"
      ],
      "examples": [
        "open"
      ],
      "type": "string"
    },
    "transfers": {
      "description": "Where it goes abroad, if anywhere.",
      "examples": [
        "None"
      ],
      "type": "string"
    },
    "version": {
      "description": "Its version; the ETag carries it for If-Match.",
      "examples": [
        2
      ],
      "format": "int64",
      "type": "integer"
    },
    "what": {
      "description": "What personal data.",
      "examples": [
        "Job applicants' CVs"
      ],
      "type": "string"
    },
    "where": {
      "description": "Where it is held.",
      "examples": [
        "A shared drive in Singapore"
      ],
      "type": "string"
    },
    "who": {
      "description": "Who reads it.",
      "examples": [
        "The founders"
      ],
      "type": "string"
    },
    "why": {
      "description": "Why the organisation holds it.",
      "examples": [
        "To hire"
      ],
      "type": "string"
    }
  },
  "required": [
    "entry_id",
    "version",
    "what",
    "why",
    "where",
    "who",
    "retention",
    "transfers",
    "needs_dpia",
    "state",
    "saved_by",
    "saved_at"
  ],
  "title": "InventoryEntryView",
  "type": "object"
}
