{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "default_route": {
      "description": "The route a new settlement starts with: the setting founders.default_route in force today (FR-EQ-05, recommended default 15).",
      "enum": [
        "keep",
        "repay",
        "convert",
        "waive"
      ],
      "examples": [
        "keep"
      ],
      "type": "string"
    },
    "items": {
      "items": {
        "$ref": "DirectorSettlement.schema.json"
      },
      "type": "array"
    },
    "next_cursor": {
      "description": "Pass it as cursor for the next page; absent on the last page.",
      "examples": [
        "eyJhZnRlciI6IjIwMjYtMTEtMDN8MDE5MiJ9"
      ],
      "type": "string"
    }
  },
  "required": [
    "items",
    "default_route"
  ],
  "title": "DirectorSettlementPage",
  "type": "object"
}
