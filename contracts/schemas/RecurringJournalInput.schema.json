{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "lines": {
      "description": "The lines of each draft: debits positive, credits negative, as on a journal.",
      "items": {
        "$ref": "JournalLineDraft.schema.json"
      },
      "maxItems": 1000,
      "type": [
        "array",
        "null"
      ]
    },
    "memo": {
      "description": "The memo of each draft.",
      "examples": [
        "Office rent accrual"
      ],
      "maxLength": 1000,
      "type": "string"
    },
    "name": {
      "description": "What it is, as the list shows it.",
      "examples": [
        "Office rent accrual"
      ],
      "maxLength": 120,
      "minLength": 1,
      "type": "string"
    },
    "reverses": {
      "description": "Each draft reverses by itself on the first day of the next month, as an accrual does (FR-GL-02).",
      "examples": [
        true
      ],
      "type": "boolean"
    },
    "schedule": {
      "$ref": "RecurringSchedule.schema.json"
    }
  },
  "required": [
    "name",
    "schedule",
    "lines"
  ],
  "title": "RecurringJournalInput",
  "type": "object"
}
