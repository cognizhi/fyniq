{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "bill_id": {
      "description": "The supplier's bill the file explains.",
      "examples": [
        "01928f6e-7a3b-7c41-9d2e-5f8a1b3c5b01"
      ],
      "format": "uuid",
      "type": "string"
    },
    "billed_total": {
      "description": "What the file says was billed in all: it must equal the bill's total and the rows' sum, or the file is refused.",
      "examples": [
        "1250.00"
      ],
      "type": "string"
    },
    "rows": {
      "description": "The file's rows.",
      "items": {
        "$ref": "AllocationUsageRow.schema.json"
      },
      "maxItems": 5000,
      "minItems": 1,
      "type": "array"
    }
  },
  "required": [
    "bill_id",
    "billed_total",
    "rows"
  ],
  "title": "AllocationUsage",
  "type": "object"
}
