CREATE INDEX user_session_user_idx ON fyniq.user_session USING btree (user_id) WHERE (ended_at IS NULL)
CREATE UNIQUE INDEX account_code_key ON fyniq.account USING btree (organisation_id, code)
CREATE UNIQUE INDEX account_pkey ON fyniq.account USING btree (organisation_id, id)
CREATE UNIQUE INDEX app_user_pkey ON fyniq.app_user USING btree (user_id)
