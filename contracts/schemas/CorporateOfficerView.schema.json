{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "approval_id": {
      "description": "The approval request waiting, if one is.",
      "examples": [
        "01928f6e-7a3b-7c41-9d2e-5f8a1b3c7e11"
      ],
      "format": "uuid",
      "type": "string"
    },
    "checks": {
      "description": "A draft's status: ✖ while no evidence is attached.",
      "items": {
        "$ref": "BillCheck.schema.json"
      },
      "type": "array"
    },
    "evidence": {
      "description": "How many files are attached and not removed: asking for approval needs one.",
      "examples": [
        1
      ],
      "format": "int64",
      "type": "integer"
    },
    "id": {
      "description": "The version's ID.",
      "examples": [
        "01928f6e-7a3b-7c41-9d2e-5f8a1b3c7e02"
      ],
      "format": "uuid",
      "type": "string"
    },
    "masked": {
      "description": "true: the identifier and the note are hidden, as the caller reads the profile masked (Appendix D's M).",
      "examples": [
        false
      ],
      "type": "boolean"
    },
    "officer": {
      "$ref": "CorporateOfficerDraft.schema.json",
      "description": "The appointment."
    },
    "officer_id": {
      "description": "The officer, by their first version's ID.",
      "examples": [
        "01928f6e-7a3b-7c41-9d2e-5f8a1b3c7e01"
      ],
      "format": "uuid",
      "type": "string"
    },
    "recorded_at": {
      "description": "When it was recorded.",
      "examples": [
        "2026-03-10T09:30:00Z"
      ],
      "format": "date-time",
      "type": "string"
    },
    "recorded_by": {
      "$ref": "Person.schema.json",
      "description": "Who approved it, as it was recorded."
    },
    "status": {
      "description": "draft: waiting for its evidence and approval; recorded: the officer's version in force; superseded: a later version is in force.",
      "enum": [
        "draft",
        "recorded",
        "superseded"
      ],
      "examples": [
        "recorded"
      ],
      "type": "string"
    },
    "version": {
      "description": "The version of its content; with its status it makes the ETag.",
      "examples": [
        1
      ],
      "format": "int64",
      "type": "integer"
    }
  },
  "required": [
    "id",
    "officer_id",
    "status",
    "version",
    "officer",
    "masked",
    "evidence",
    "checks"
  ],
  "title": "CorporateOfficerView",
  "type": "object"
}
