{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "currency": {
      "description": "The currency of each draft. One in another currency takes the cascade's rate for its date when it is issued (ENG-40).",
      "examples": [
        "SGD"
      ],
      "pattern": "^[A-Z]{3}$",
      "type": "string"
    },
    "customer_id": {
      "description": "The customer of each draft: a contact marked as a customer.",
      "examples": [
        "01928f6e-7a3b-7c41-9d2e-5f8a1b3c4f20"
      ],
      "format": "uuid",
      "type": "string"
    },
    "lines": {
      "description": "The lines of each draft, as on an invoice; a line never names a quote.",
      "items": {
        "$ref": "InvoiceLineDraft.schema.json"
      },
      "maxItems": 200,
      "type": [
        "array",
        "null"
      ]
    },
    "name": {
      "description": "What it is, as the list shows it.",
      "examples": [
        "Analytics subscription, Acme"
      ],
      "maxLength": 120,
      "minLength": 1,
      "type": "string"
    },
    "notes": {
      "description": "The notes of each draft.",
      "examples": [
        "Monthly subscription"
      ],
      "maxLength": 2000,
      "type": "string"
    },
    "reference": {
      "description": "The customer's reference on each draft, such as their purchase order.",
      "examples": [
        "PO-4411"
      ],
      "maxLength": 60,
      "type": "string"
    },
    "schedule": {
      "$ref": "InvoiceSchedule.schema.json"
    }
  },
  "required": [
    "name",
    "schedule",
    "currency",
    "lines"
  ],
  "title": "RecurringInvoiceInput",
  "type": "object"
}
