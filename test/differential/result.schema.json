{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "fyniq-scenario-result@1",
  "description": "What the Go engine and the Python oracle each write for a fyniq-scenario@1 scenario; the comparator diffs two of them to the cent (QA-ENG-02). README.md beside this file states how to compare them.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "name", "entries", "rejected", "trial_balance"],
  "properties": {
    "schema": {"const": "fyniq-scenario-result@1"},
    "name": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$"},
    "entries": {
      "description": "Every posted entry: the documents in scenario order (post), then the reversals and edits in scenario order (an edit's reversal, then its replacement), then the scheduled entries (releases, depreciation, automatic reversals, and the month-end revaluations and their reversals, README \"Month-end revaluation\") by date, document and kind.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["document", "kind", "posting_date", "lines"],
        "properties": {
          "document": {"type": "string"},
          "kind": {"enum": ["post", "reversal", "replacement", "release", "depreciation", "auto_reversal", "revaluation",
                           "revaluation_reversal"]},
          "posting_date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
          "lines": {
            "description": "A manual journal's in the document's line order (and so its reversals', its replacements' and its automatic reversal's); every other source's, the opening balances' included, in its canonical form (README, P1 entries).",
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["account", "currency", "amount", "base_amount"],
              "properties": {
                "account": {"type": "string"},
                "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
                "amount": {"description": "At the line currency's minor units.", "$ref": "#/$defs/decimal"},
                "base_amount": {"description": "At the base currency's minor units.", "$ref": "#/$defs/decimal"},
                "party": {"description": "Only on a line on a director's account: its person (FR-EQ-01, B.7). A reversal's line keeps it.", "type": "string"},
                "instrument": {"description": "Only on a line on the instruments account: the instrument document it names (FR-EQ-18).", "type": "string"},
                "dimensions": {"description": "Only on a line with dimension values (FR-DIM-02): a dimension's name to its value's code. A reversal's line keeps its line's.", "type": "object", "additionalProperties": {"type": "string"}}
              }
            }
          }
        }
      }
    },
    "rejected": {
      "description": "The refused documents ('<id>'), reversals ('<id>/reversal') and edits ('<id>/edit'), in the order they were refused. No reason codes.",
      "type": "array",
      "items": {"type": "string"}
    },
    "trial_balance": {
      "description": "Posting month -> account -> base-currency total of the month's lines. An account whose total is zero may be left out; a comparator reads a missing account or month as zero.",
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^[0-9]{4}-(0[1-9]|1[0-2])$": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/decimal"}
        }
      }
    },
    "dimension_balances": {
      "description": "Present only when the scenario declares dimensions (FR-DIM-02). Posting month (YYYY-MM) -> account -> dimension set -> the base-currency total of that month's posted lines on the account with exactly those values. A set is its values as \"Name=CODE\" joined by \"|\" in name order, \"\" for the lines with none. A total of zero may be left out; a comparator reads a missing month, account or set as zero.",
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {"type": "object", "additionalProperties": {"$ref": "#/$defs/decimal"}}
      }
    },
    "people": {
      "description": "Present only when a posted line names a person. Person -> director's account -> base-currency total of every posted line naming that person on that account (FR-EQ-01; the sub-ledger of 2500 and 2120). A total of zero may be left out; a comparator reads a missing person or account as zero.",
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {"$ref": "#/$defs/decimal"}
      }
    },
    "statements": {
      "description": "Present only when the scenario has \"statements\": true. Month -> that month's statements, for every month from the first posting month to the last (README, \"Statements\"). Every figure is in the base currency at its minor units.",
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^[0-9]{4}-(0[1-9]|1[0-2])$": {"$ref": "#/$defs/monthStatements"}
      }
    },
    "kpis": {
      "description": "Present only when the scenario has kpis. Month -> that month's KPIs, for every stated month (README, \"KPIs\"). null is undefined (FR-KPI-03: never 0).",
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^[0-9]{4}-(0[1-9]|1[0-2])$": {"$ref": "#/$defs/monthKpis"}
      }
    },
    "rounds": {
      "description": "Present only when the scenario has rounds: each round's outcome, or null when it cannot be worked out (FR-EQ-21; README, \"Rounds\").",
      "type": "array",
      "items": {
        "oneOf": [
          {"type": "null"},
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["price", "pre_money", "post_money", "issues", "conversions", "holders", "issued_before", "issued_after",
                         "fully_diluted_before", "fully_diluted_after", "unallocated_before", "unallocated_after", "new_shares"],
            "properties": {
              "price": {"$ref": "#/$defs/decimal"},
              "pre_money": {"$ref": "#/$defs/decimal"},
              "post_money": {"$ref": "#/$defs/decimal"},
              "issues": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["person", "shares", "amount", "left"],
                "properties": {"person": {"type": "string"}, "shares": {"$ref": "#/$defs/decimal"}, "amount": {"$ref": "#/$defs/decimal"}, "left": {"$ref": "#/$defs/decimal"}}}},
              "conversions": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["instrument", "price", "shares", "converted", "left"],
                "properties": {"instrument": {"type": "string"}, "price": {"$ref": "#/$defs/decimal"}, "shares": {"$ref": "#/$defs/decimal"},
                  "converted": {"$ref": "#/$defs/decimal"}, "left": {"$ref": "#/$defs/decimal"}}}},
              "holders": {"type": "array", "items": {"type": "object", "additionalProperties": false,
                "required": ["holder", "issued_before", "issued_after", "fully_diluted_before", "fully_diluted_after", "ownership_before", "ownership_after",
                             "diluted_before", "diluted_after", "dilution", "pro_rata"],
                "properties": {"holder": {"type": "string"}, "issued_before": {"$ref": "#/$defs/decimal"}, "issued_after": {"$ref": "#/$defs/decimal"},
                  "fully_diluted_before": {"$ref": "#/$defs/decimal"}, "fully_diluted_after": {"$ref": "#/$defs/decimal"},
                  "ownership_before": {"$ref": "#/$defs/share"}, "ownership_after": {"$ref": "#/$defs/share"}, "diluted_before": {"$ref": "#/$defs/share"},
                  "diluted_after": {"$ref": "#/$defs/share"}, "dilution": {"oneOf": [{"type": "null"}, {"type": "string", "pattern": "^-?[0-9]+\\.[0-9]{2}$"}]},
                  "pro_rata": {"$ref": "#/$defs/decimal"}}}},
              "issued_before": {"$ref": "#/$defs/decimal"},
              "issued_after": {"$ref": "#/$defs/decimal"},
              "fully_diluted_before": {"$ref": "#/$defs/decimal"},
              "fully_diluted_after": {"$ref": "#/$defs/decimal"},
              "unallocated_before": {"$ref": "#/$defs/decimal"},
              "unallocated_after": {"$ref": "#/$defs/decimal"},
              "new_shares": {"$ref": "#/$defs/decimal"}
            }
          }
        ]
      }
    },
    "cap_tables": {
      "description": "Present only when the scenario has cap_tables: the cap table at the end of each of its days, in their order (FR-EQ-20; README, \"Cap tables\").",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["at", "issued", "votes", "options", "unallocated", "fully_diluted", "lines", "holders"],
        "properties": {
          "at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
          "issued": {"$ref": "#/$defs/decimal"},
          "votes": {"$ref": "#/$defs/decimal"},
          "options": {"description": "The options the grants made by the day granted (FR-EQ-19).", "$ref": "#/$defs/decimal"},
          "unallocated": {"description": "What the pool in force leaves to grant: its size less the options granted.", "$ref": "#/$defs/decimal"},
          "fully_diluted": {"$ref": "#/$defs/decimal"},
          "lines": {
            "description": "Every holding with shares or options, by holder, then class.",
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["holder", "class", "issued", "votes", "fully_diluted", "ownership", "voting", "diluted"],
              "properties": {
                "holder": {"type": "string"},
                "class": {"type": "string"},
                "issued": {"$ref": "#/$defs/decimal"},
                "votes": {"$ref": "#/$defs/decimal"},
                "fully_diluted": {"$ref": "#/$defs/decimal"},
                "ownership": {"$ref": "#/$defs/share"},
                "voting": {"$ref": "#/$defs/share"},
                "diluted": {"$ref": "#/$defs/share"}
              }
            }
          },
          "holders": {
            "description": "Each holder's lines together, by holder; the percentages come from the exact sums.",
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["holder", "issued", "votes", "fully_diluted", "ownership", "voting", "diluted"],
              "properties": {
                "holder": {"type": "string"},
                "issued": {"$ref": "#/$defs/decimal"},
                "votes": {"$ref": "#/$defs/decimal"},
                "fully_diluted": {"$ref": "#/$defs/decimal"},
                "ownership": {"$ref": "#/$defs/share"},
                "voting": {"$ref": "#/$defs/share"},
                "diluted": {"$ref": "#/$defs/share"}
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "share": {
      "description": "A percentage of the cap table's total to 2 decimals, half-up, such as \"79.87\"; null when the total is zero.",
      "anyOf": [{"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.[0-9]{2}$"}, {"type": "null"}]
    },
    "decimal": {
      "description": "A plain decimal string: no exponent, no '+', no grouping.",
      "type": "string",
      "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"
    },
    "kpi": {"anyOf": [{"$ref": "#/$defs/decimal"}, {"type": "null"}]},
    "monthKpis": {
      "description": "Each KPI under RND-KPI: amounts at the base currency's minor units, percentages, ratios, multiples, months and days to 1 decimal, headcount whole.",
      "type": "object",
      "additionalProperties": false,
      "required": ["booked_mrr", "arr", "contracted_mrr", "revenue_growth", "gross_margin", "spend_by_function", "net_burn",
                   "runway", "arpa", "churn", "cac", "ltv", "ltv_to_cac", "cac_payback", "burn_multiple", "current_ratio",
                   "quick_ratio", "working_capital", "debt_to_equity", "dso", "dpo", "ebitda_margin", "net_margin",
                   "headcount", "revenue_per_employee"],
      "properties": {
        "booked_mrr": {"$ref": "#/$defs/kpi"},
        "arr": {"$ref": "#/$defs/kpi"},
        "contracted_mrr": {"description": "No subscription data until FR-AR-15 (P2).", "type": "null"},
        "revenue_growth": {"$ref": "#/$defs/kpi"},
        "gross_margin": {"$ref": "#/$defs/kpi"},
        "spend_by_function": {
          "type": "object",
          "additionalProperties": false,
          "required": ["R&D", "S&M", "G&A"],
          "properties": {
            "R&D": {"$ref": "#/$defs/decimal"},
            "S&M": {"$ref": "#/$defs/decimal"},
            "G&A": {"$ref": "#/$defs/decimal"}
          }
        },
        "net_burn": {"$ref": "#/$defs/decimal"},
        "runway": {"description": "Months, or \"not-burning\" when the three-month average net burn is not above zero.",
                   "anyOf": [{"$ref": "#/$defs/decimal"}, {"const": "not-burning"}]},
        "arpa": {"$ref": "#/$defs/kpi"},
        "churn": {"$ref": "#/$defs/kpi"},
        "cac": {"$ref": "#/$defs/kpi"},
        "ltv": {"$ref": "#/$defs/kpi"},
        "ltv_to_cac": {"$ref": "#/$defs/kpi"},
        "cac_payback": {"$ref": "#/$defs/kpi"},
        "burn_multiple": {"$ref": "#/$defs/kpi"},
        "current_ratio": {"$ref": "#/$defs/kpi"},
        "quick_ratio": {"$ref": "#/$defs/kpi"},
        "working_capital": {"$ref": "#/$defs/decimal"},
        "debt_to_equity": {"$ref": "#/$defs/kpi"},
        "dso": {"$ref": "#/$defs/kpi"},
        "dpo": {"$ref": "#/$defs/kpi"},
        "ebitda_margin": {"$ref": "#/$defs/kpi"},
        "net_margin": {"$ref": "#/$defs/kpi"},
        "headcount": {"$ref": "#/$defs/kpi"},
        "revenue_per_employee": {"$ref": "#/$defs/kpi"}
      }
    },
    "section": {
      "description": "A section's total and its figure per report group; a group whose figure is zero may be left out, and a comparator reads a missing group as zero.",
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "groups"],
      "properties": {
        "total": {"$ref": "#/$defs/decimal"},
        "groups": {"type": "object", "additionalProperties": {"$ref": "#/$defs/decimal"}}
      }
    },
    "monthStatements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profit_and_loss", "balance_sheet", "cash_flow", "equity_movement", "checks"],
      "properties": {
        "profit_and_loss": {
          "description": "The month's P&L. Each figure is what it adds to profit (credit positive): revenue positive, costs negative.",
          "type": "object",
          "additionalProperties": false,
          "required": ["revenue", "cost_of_sales", "gross_profit", "operating_expenses", "ebitda",
                       "depreciation_and_amortisation", "operating_profit", "other_income",
                       "finance_costs_and_other_expenses", "profit_before_tax", "income_tax", "net_profit"],
          "properties": {
            "revenue": {"$ref": "#/$defs/section"},
            "cost_of_sales": {"$ref": "#/$defs/section"},
            "gross_profit": {"$ref": "#/$defs/decimal"},
            "operating_expenses": {
              "type": "object",
              "additionalProperties": false,
              "required": ["total", "groups", "functions"],
              "properties": {
                "total": {"$ref": "#/$defs/decimal"},
                "groups": {"type": "object", "additionalProperties": {"$ref": "#/$defs/decimal"}},
                "functions": {
                  "description": "The same expenses by function; an account without one counts under Other. A function whose figure is zero may be left out.",
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "R&D": {"$ref": "#/$defs/decimal"},
                    "S&M": {"$ref": "#/$defs/decimal"},
                    "G&A": {"$ref": "#/$defs/decimal"},
                    "Other": {"$ref": "#/$defs/decimal"}
                  }
                }
              }
            },
            "ebitda": {"$ref": "#/$defs/decimal"},
            "depreciation_and_amortisation": {"$ref": "#/$defs/section"},
            "operating_profit": {"$ref": "#/$defs/decimal"},
            "other_income": {"$ref": "#/$defs/section"},
            "finance_costs_and_other_expenses": {"$ref": "#/$defs/section"},
            "profit_before_tax": {"$ref": "#/$defs/decimal"},
            "income_tax": {"$ref": "#/$defs/decimal"},
            "net_profit": {"$ref": "#/$defs/decimal"},
            "percent_of_revenue": {
              "description": "RND-PERCENT of each line against the month's revenue; absent when the revenue is zero.",
              "type": "object",
              "additionalProperties": {"$ref": "#/$defs/decimal"}
            }
          }
        },
        "balance_sheet": {
          "description": "At the month's last day. Assets debit positive; liabilities, borrowings and equity credit positive.",
          "type": "object",
          "additionalProperties": false,
          "required": ["current_assets", "non_current_assets", "total_assets", "current_liabilities", "borrowings",
                       "total_liabilities", "equity", "total_liabilities_and_equity"],
          "properties": {
            "current_assets": {"$ref": "#/$defs/section"},
            "non_current_assets": {"$ref": "#/$defs/section"},
            "total_assets": {"$ref": "#/$defs/decimal"},
            "current_liabilities": {"$ref": "#/$defs/section"},
            "borrowings": {"$ref": "#/$defs/section"},
            "total_liabilities": {"$ref": "#/$defs/decimal"},
            "equity": {"$ref": "#/$defs/section"},
            "total_liabilities_and_equity": {"$ref": "#/$defs/decimal"}
          }
        },
        "cash_flow": {
          "description": "The month's indirect cash flow. Money in positive.",
          "type": "object",
          "additionalProperties": false,
          "required": ["operating", "investing", "financing", "net_change", "opening_cash", "closing_cash", "non_cash"],
          "properties": {
            "operating": {
              "type": "object",
              "additionalProperties": false,
              "required": ["net_profit", "depreciation_and_amortisation", "investing_and_financing_results",
                           "working_capital", "other_accounts", "total"],
              "properties": {
                "net_profit": {"$ref": "#/$defs/decimal"},
                "depreciation_and_amortisation": {"$ref": "#/$defs/decimal"},
                "investing_and_financing_results": {"$ref": "#/$defs/decimal"},
                "working_capital": {
                  "description": "Cash-flow line -> its change; a line whose change is zero may be left out.",
                  "type": "object",
                  "additionalProperties": {"$ref": "#/$defs/decimal"}
                },
                "other_accounts": {
                  "description": "Minus the operating entries' lines on accounts that sit in no section (D3, rev 0.159), so the total is the operating entries' cash.",
                  "$ref": "#/$defs/decimal"
                },
                "total": {"$ref": "#/$defs/decimal"}
              }
            },
            "investing": {"$ref": "#/$defs/decimal"},
            "financing": {"$ref": "#/$defs/decimal"},
            "net_change": {"$ref": "#/$defs/decimal"},
            "opening_cash": {"$ref": "#/$defs/decimal"},
            "closing_cash": {"$ref": "#/$defs/decimal"},
            "non_cash": {
              "description": "The month's investing and financing entries that moved no money, in the order of entries.",
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["document", "kind", "posting_date", "section"],
                "properties": {
                  "document": {"type": "string"},
                  "kind": {"enum": ["post", "reversal", "replacement", "release", "depreciation", "auto_reversal"]},
                  "posting_date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
                  "section": {"enum": ["investing", "financing"]},
                  "label": {"description": "What the entry was, when its document says it (FR-EQ-10): a conversion of a founder's balance, a waiver, or (rev 0.207) a cash issue allotted from share application monies.", "enum": ["Converted to shares", "Waived", "Allotted from share application monies"]}
                }
              }
            }
          }
        },
        "equity_movement": {
          "description": "From the month's opening equity to its closing equity, credit positive.",
          "type": "object",
          "additionalProperties": false,
          "required": ["opening", "profit", "share_capital", "share_capital_non_cash", "other", "closing"],
          "properties": {
            "opening": {"$ref": "#/$defs/decimal"},
            "profit": {"$ref": "#/$defs/decimal"},
            "share_capital": {"description": "Shares issued for cash: every line on the Share capital line but a conversion's.", "$ref": "#/$defs/decimal"},
            "share_capital_non_cash": {"description": "Shares issued for non-cash consideration: a conversion's lines on the Share capital line (FR-EQ-10).", "$ref": "#/$defs/decimal"},
            "other": {"$ref": "#/$defs/decimal"},
            "closing": {"$ref": "#/$defs/decimal"}
          }
        },
        "checks": {
          "type": "object",
          "additionalProperties": false,
          "required": ["balances", "ties", "equity", "unplaced"],
          "properties": {
            "balances": {"description": "Total assets equal total liabilities and equity (INV-10, BS_Chk).", "type": "boolean"},
            "ties": {"description": "Opening cash plus the net change equals closing cash (INV-11, CF_Chk).", "type": "boolean"},
            "equity": {"description": "The movement in equity reconciles opening to closing (BS_EqChk).", "type": "boolean"},
            "unplaced": {
              "description": "The balance-sheet accounts with a balance or a line in the month that no section places (PL_Chk, BS_Uncl), by code.",
              "type": "array",
              "items": {"type": "string"}
            }
          }
        }
      }
    }
  }
}
