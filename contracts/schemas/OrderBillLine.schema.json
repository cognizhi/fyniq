{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "line": {
      "description": "The order's line, from 1.",
      "examples": [
        1
      ],
      "format": "int64",
      "minimum": 1,
      "type": "integer"
    },
    "quantity": {
      "description": "How much of it the bill takes.",
      "examples": [
        "2"
      ],
      "pattern": "^(0|[1-9][0-9]{0,13})(\\.[0-9]{1,6})?$",
      "type": "string"
    }
  },
  "required": [
    "line",
    "quantity"
  ],
  "title": "OrderBillLine",
  "type": "object"
}
