{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cognizhi/fyniq/compliance/control.schema.json",
  "title": "A control of the registry (PRD-001 Appendix F)",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "section", "control", "mapping", "automated_check", "frequency", "evidence", "owner", "checks"],
  "properties": {
    "id": { "type": "string", "pattern": "^CTL-[A-Z]+-[0-9]{2}$" },
    "section": { "type": "string", "pattern": "^F\\.[0-9][a-z]?$" },
    "control": { "type": "string", "minLength": 5 },
    "mapping": { "type": "string", "minLength": 2 },
    "automated_check": { "type": "string", "minLength": 2 },
    "frequency": { "type": "string", "minLength": 1 },
    "evidence": { "type": "string", "minLength": 2 },
    "owner": { "enum": ["Owner", "Administrator", "Controller", "Accountant", "DPO", "Auditor"] },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["frequency", "status"],
        "properties": {
          "frequency": { "enum": ["CI", "D", "N", "W", "M", "Q", "S", "E"] },
          "status": { "enum": ["running", "planned", "manual"] },
          "how": { "type": "string", "pattern": "^(make [a-z0-9-]+|job [a-z0-9.]+|test Test[A-Za-z0-9_]+|ci .+)$" },
          "evidence": { "type": "string", "minLength": 5 },
          "arrives": { "type": "string", "minLength": 2 }
        },
        "allOf": [
          { "if": { "properties": { "status": { "const": "running" } } }, "then": { "required": ["how", "evidence"] } },
          { "if": { "properties": { "status": { "const": "planned" } } }, "then": { "required": ["arrives"] } }
        ]
      }
    }
  }
}
