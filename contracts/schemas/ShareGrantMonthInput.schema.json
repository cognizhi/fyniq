{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "grant_id": {
      "description": "The grant.",
      "examples": [
        "01928f6e-7a3b-7c41-9d2e-5f8a1b3c9a01"
      ],
      "format": "uuid",
      "type": "string"
    },
    "month": {
      "description": "The month, one the schedule runs over that has begun.",
      "examples": [
        "2026-01"
      ],
      "pattern": "^[0-9]{4}-[0-9]{2}$",
      "type": "string"
    }
  },
  "required": [
    "grant_id",
    "month"
  ],
  "title": "ShareGrantMonthInput",
  "type": "object"
}
